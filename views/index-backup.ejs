<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FitConnect - Find Your Perfect Fitness Trainer</title>
    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- FontAwesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Custom CSS -->
    <link rel="stylesheet" href="/css/style.css?v=5">
    <style>
        .navbar-brand,
        .fitconnect-brand {
            color: #3498db !important;
            -webkit-text-fill-color: #3498db !important;
            background: none !important;
        }
    </style>
</head>

<body>

    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-light navbar-custom sticky-top">
        <div class="container">
            <a class="navbar-brand" href="/"><i class="fas fa-dumbbell me-2"></i>FitConnect</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto align-items-center">
                    <li class="nav-item"><a class="nav-link fw-semibold" href="/search">Find a Trainer</a></li>
                    <li class="nav-item"><a class="nav-link fw-semibold" href="/trainer/request">Become a Trainer</a></li>
                    
                    <% if (typeof locals.session !== 'undefined' && locals.session.userId && locals.session.userRole === 'user') { %>
                        <li class="nav-item ms-lg-3">
                            <a class="btn btn-modern px-4" href="/dashboard">Dashboard</a>
                        </li>
                        <li class="nav-item ms-2">
                            <a class="nav-link text-danger" href="/user/logout"><i class="fas fa-sign-out-alt"></i></a>
                        </li>
                    <% } else if (typeof locals.session !== 'undefined' && locals.session.trainerId && locals.session.userRole === 'trainer') { %>
                        <li class="nav-item ms-lg-3">
                            <a class="btn btn-modern px-4" href="/trainer/dashboard">Dashboard</a>
                        </li>
                        <li class="nav-item ms-2">
                            <a class="nav-link text-danger" href="/trainer/logout"><i class="fas fa-sign-out-alt"></i></a>
                        </li>
                    <% } else if (typeof locals.session !== 'undefined' && locals.session.adminId && locals.session.userRole === 'admin') { %>
                        <li class="nav-item ms-lg-3">
                            <a class="btn btn-modern px-4" href="/admin/dashboard">Admin Panel</a>
                        </li>
                        <li class="nav-item ms-2">
                            <a class="nav-link text-danger" href="/admin/logout"><i class="fas fa-sign-out-alt"></i></a>
                        </li>
                    <% } else { %>
                        <li class="nav-item dropdown ms-lg-3">
                            <a class="btn btn-modern px-4 dropdown-toggle d-flex align-items-center" href="#" id="loginDropdown" role="button"
                                data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="fas fa-sign-in-alt me-2"></i>Login
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end border-0 shadow-lg mt-2"
                                aria-labelledby="loginDropdown">
                                <li><a class="dropdown-item py-2" href="/user-login"><i
                                            class="fas fa-user text-primary me-2"></i>User Login</a></li>
                                <li><a class="dropdown-item py-2" href="/trainer/login"><i
                                            class="fas fa-dumbbell text-success me-2"></i>Trainer Login</a></li>
                                <li>
                                    <hr class="dropdown-divider">
                                </li>
                                <li><a class="dropdown-item py-2" href="/admin/login"><i
                                            class="fas fa-shield-alt text-danger me-2"></i>Admin Login</a></li>
                            </ul>
                        </li>
                    <% } %>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Hero Section -->
    <section class="hero-section text-center d-flex align-items-center justify-content-center"
        style="min-height: 80vh;">
        <div class="container">
            <h1 class="hero-title">Elevate Your Fitness Journey</h1>
            <p class="hero-subtitle mb-5 mx-auto" style="max-width: 600px;">Connect with certified personal trainers in
                your city who match your goals, schedule, and preferred training style.</p>
            <div class="animation-fade-up d-inline-block" style="animation-delay: 0.4s;">
                <a href="/search"
                    class="btn btn-light btn-lg px-5 py-3 fw-bold shadow-lg me-3 rounded-pill text-primary"
                    style="transition: transform 0.3s; transform-origin: center;"><i class="fas fa-search me-2"></i>Find
                    Trainers</a>
                <a href="/trainer/request"
                    class="btn btn-outline-light btn-lg px-5 py-3 fw-bold shadow-lg rounded-pill">Join as Trainer</a>
            </div>
        </div>
    </section>

    <!-- Features Section -->
    <section class="py-5 my-5">
        <div class="container">
            <div class="text-center mb-5 animate-fade-up">
                <h2 class="fw-bold">Why Choose FitConnect?</h2>
                <p class="text-muted">We provide the best platform for your fitness needs</p>
            </div>

            <div class="row g-4">
                <div class="col-md-4 animate-fade-up">
                    <div class="glass-panel p-5 text-center h-100 trainer-card">
                        <div class="bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-4"
                            style="width: 80px; height: 80px; font-size: 2rem;">
                            <i class="fas fa-bullseye"></i>
                        </div>
                        <h4 class="fw-bold">Goal Oriented</h4>
                        <p class="text-muted mb-0">Find trainers aligned perfectly with your specific fitness goals, be
                            it weight loss, muscle gain, or endurance.</p>
                    </div>
                </div>
                <div class="col-md-4 animate-fade-up" style="transition-delay: 0.2s">
                    <div class="glass-panel p-5 text-center h-100 trainer-card">
                        <div class="bg-success text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-4"
                            style="width: 80px; height: 80px; font-size: 2rem;">
                            <i class="fas fa-shield-alt"></i>
                        </div>
                        <h4 class="fw-bold">Verified Professionals</h4>
                        <p class="text-muted mb-0">Every trainer undergoes a strict background check and verification
                            process by our admin team before joining.</p>
                    </div>
                </div>
                <div class="col-md-4 animate-fade-up" style="transition-delay: 0.4s">
                    <div class="glass-panel p-5 text-center h-100 trainer-card">
                        <div class="bg-warning text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-4"
                            style="width: 80px; height: 80px; font-size: 2rem;">
                            <i class="fas fa-calendar-check"></i>
                        </div>
                        <h4 class="fw-bold">Easy Booking</h4>
                        <p class="text-muted mb-0">Our seamless booking system makes scheduling your sessions fast,
                            reliable, and hassle-free.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- React + Tailwind + Motion Integration -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/react@18/umd/react.development.js"></script>
    <script src="https://unpkg.com/react-dom@18/umd/react-dom.development.js"></script>
    <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>
    <script src="https://unpkg.com/framer-motion/dist/framer-motion.js"></script>

    <!-- App Container -->
    <div id="footer-root"></div>

    <!-- React Implementation -->
    <script type="text/babel" data-presets="react,typescript">
        const { motion } = window.Motion;
        const cn = (...classes) => classes.filter(Boolean).join(' ');

        const TextHoverEffect = ({ text, duration, className }) => {
            const svgRef = React.useRef(null);
            const [cursor, setCursor] = React.useState({ x: 0, y: 0 });
            const [hovered, setHovered] = React.useState(false);
            const [maskPosition, setMaskPosition] = React.useState({ cx: "50%", cy: "50%" });

            React.useEffect(() => {
                if (svgRef.current && cursor.x !== null && cursor.y !== null) {
                    const svgRect = svgRef.current.getBoundingClientRect();
                    const cxPercentage = ((cursor.x - svgRect.left) / svgRect.width) * 100;
                    const cyPercentage = ((cursor.y - svgRect.top) / svgRect.height) * 100;
                    setMaskPosition({ cx: `${cxPercentage}%`, cy: `${cyPercentage}%` });
                }
            }, [cursor]);

            return (
                <svg
                    ref={svgRef} width="100%" height="100%" viewBox="0 0 450 100"
                    onMouseEnter={() => setHovered(true)} onMouseLeave={() => setHovered(false)}
                    onMouseMove={(e) => setCursor({ x: e.clientX, y: e.clientY })}
                    className={cn("select-none uppercase cursor-pointer", className)}
                >
                    <defs>
                        <linearGradient id="textGradient" gradientUnits="userSpaceOnUse" cx="50%" cy="50%" r="25%">
                            {hovered && (
                                <>
                                    <stop offset="0%" stopColor="#eab308" />
                                    <stop offset="25%" stopColor="#ef4444" />
                                    <stop offset="50%" stopColor="#80eeb4" />
                                    <stop offset="75%" stopColor="#06b6d4" />
                                    <stop offset="100%" stopColor="#8b5cf6" />
                                </>
                            )}
                        </linearGradient>
                        <motion.radialGradient
                            id="revealMask" gradientUnits="userSpaceOnUse" r="20%"
                            initial={{ cx: "50%", cy: "50%" }} animate={maskPosition}
                            transition={{ duration: duration ?? 0, ease: "easeOut" }}
                        >
                            <stop offset="0%" stopColor="white" />
                            <stop offset="100%" stopColor="black" />
                        </motion.radialGradient>
                        <mask id="textMask">
                            <rect x="0" y="0" width="100%" height="100%" fill="url(#revealMask)" />
                        </mask>
                    </defs>
                    <text x="50%" y="50%" textAnchor="middle" dominantBaseline="middle" strokeWidth="0.3"
                        className="fill-transparent stroke-white/20 font-bold opacity-70 text-6xl"
                        style={{ opacity: hovered ? 0.7 : 0 }}>{text}</text>
                    <motion.text x="50%" y="50%" textAnchor="middle" dominantBaseline="middle" strokeWidth="0.3"
                        className="fill-transparent stroke-[#3ca2fa] font-bold text-6xl"
                        initial={{ strokeDashoffset: 1000, strokeDasharray: 1000 }}
                        animate={{ strokeDashoffset: 0, strokeDasharray: 1000 }}
                        transition={{ duration: 4, ease: "easeInOut" }}>{text}</motion.text>
                    <text x="50%" y="50%" textAnchor="middle" dominantBaseline="middle" stroke="url(#textGradient)" strokeWidth="0.3"
                        mask="url(#textMask)" className="fill-transparent font-bold text-6xl">{text}</text>
                </svg>
            );
        };

        const FooterBackgroundGradient = () => (
            <div className="absolute inset-0 z-0" style={{ background: "radial-gradient(125% 125% at 50% 10%, #171717 50%, #3ca2fa33 100%)" }} />
        );

        const HoverFooter = () => {
            const footerLinks = [
                { title: "About Us", links: [{ label: "Company History", href: "#" }, { label: "Meet the Team", href: "#" }, { label: "Employee Handbook", href: "#" }, { label: "Careers", href: "#" }] },
                { title: "Helpful Links", links: [{ label: "FAQs", href: "#" }, { label: "Support", href: "#" }, { label: "Live Chat", href: "#" }] },
            ];
            const contactInfo = [
                { icon: <i className="fas fa-envelope text-[#3ca2fa]"></i>, text: "support@fitconnect.com" },
                { icon: <i className="fas fa-phone text-[#3ca2fa]"></i>, text: "+91 6362596973" },
                { icon: <i className="fas fa-map-marker-alt text-[#3ca2fa]"></i>, text: "karwar, INDIA" },
            ];

            return (
                <footer className="bg-neutral-950 relative h-fit rounded-[2.5rem] overflow-hidden m-8 border border-white/10 text-white">
                    <div className="max-w-7xl mx-auto p-14 z-40 relative">
                        <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 pb-12">
                            <div className="flex flex-col space-y-4">
                                <div className="flex items-center space-x-2">
                                    <span className="text-[#3ca2fa] text-3xl font-extrabold">&hearts;</span>
                                    <span className="text-3xl font-bold text-white">FitConnect</span>
                                </div>
                                <p className="text-sm text-neutral-400 leading-relaxed">FitConnect is a modern platform to find the best trainers.</p>
                            </div>
                            {footerLinks.map((section) => (
                                <div key={section.title}>
                                    <h4 className="text-xl font-semibold mb-6 text-white">{section.title}</h4>
                                    <ul className="space-y-3">
                                        {section.links.map((link) => (
                                            <li key={link.label} className="relative">
                                                <a href={link.href} className="text-neutral-400 hover:text-[#3ca2fa] transition-colors">{link.label}</a>
                                                {link.pulse && <span className="absolute top-1 -right-3 w-2 h-2 rounded-full bg-[#3ca2fa] animate-pulse"></span>}
                                            </li>
                                        ))}
                                    </ul>
                                </div>
                            ))}
                            <div>
                                <h4 className="text-xl font-semibold mb-6 text-white">Contact Us</h4>
                                <ul className="space-y-4">
                                    {contactInfo.map((item, i) => (
                                        <li key={i} className="flex items-center space-x-3 text-neutral-400">
                                            {item.icon}<span>{item.text}</span>
                                        </li>
                                    ))}
                                </ul>
                            </div>
                        </div>
                        <hr className="border-t border-white/10 my-8" />
                        <div className="flex flex-col md:row justify-between items-center text-sm text-neutral-500">
                            <p>&copy; {new Date().getFullYear()} FitConnect. All rights reserved.</p>
                        </div>
                    </div>
                    <div className="lg:flex hidden h-[30rem] -mt-52 -mb-36">
                        <TextHoverEffect text="FitConnect" className="z-50" />
                    </div>
                    <FooterBackgroundGradient />
                </footer>
            );
        };

        const root = ReactDOM.createRoot(document.getElementById('footer-root'));
        root.render(<HoverFooter />);
    </script>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Intersection Observer for scroll animations
        document.addEventListener('DOMContentLoaded', () => {
            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('visible');
                    }
                });
            }, { threshold: 0.1 });

            document.querySelectorAll('.animate-fade-up').forEach(el => observer.observe(el));
        });
    </script>
</body>

</html>