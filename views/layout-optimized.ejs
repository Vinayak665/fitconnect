<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= typeof title !=='undefined' ? title : 'FitConnect' %>
    </title>

    <!-- Preconnect for external resources -->
    <link rel="preconnect" href="https://cdn.jsdelivr.net">
    <link rel="preconnect" href="https://cdnjs.cloudflare.com">
    <link rel="preconnect" href="https://fonts.googleapis.com">

    <!-- Optimized CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
        media="print" onload="this.media='all'">
    <%- include('partials/theme-logic') %>
    <!-- Critical CSS inline -->

    <!-- Critical CSS inline -->
    <style>
        /* Critical above-the-fold styles */
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        }

        .loading {
            opacity: 0.6;
            pointer-events: none;
        }

        .navbar-brand, .fitconnect-brand { color: #38bdf8 !important; -webkit-text-fill-color: #38bdf8 !important; background: none !important; }
        nav.navbar { background: rgba(2, 6, 23, 0.8) !important; backdrop-filter: blur(15px); border-bottom: 1px solid rgba(255,255,255,0.05); }
        .nav-link { color: rgba(255,255,255,0.8) !important; }
        .nav-link:hover, .nav-link.active { color: #38bdf8 !important; }

        /* Ocean Aurora Dropdown */
        .aurora-dropdown {
            background: rgba(2, 6, 23, 0.92) !important;
            backdrop-filter: blur(24px) !important;
            -webkit-backdrop-filter: blur(24px) !important;
            border: 1px solid rgba(56, 189, 248, 0.2) !important;
            border-radius: 16px !important;
            box-shadow: 0 20px 60px rgba(0,0,0,0.6), 0 0 0 1px rgba(56,189,248,0.08), inset 0 1px 0 rgba(255,255,255,0.05) !important;
            padding: 8px !important;
            min-width: 220px !important;
            margin-top: 10px !important;
            overflow: hidden;
            display: block !important;
            opacity: 0;
            transform: translateY(-10px) scale(0.97);
            pointer-events: none;
            transition: opacity 0.22s cubic-bezier(0.16,1,0.3,1),
                        transform 0.22s cubic-bezier(0.16,1,0.3,1);
            visibility: hidden;
            z-index: 1000;
        }
        .aurora-dropdown.open {
            opacity: 1;
            transform: translateY(0) scale(1);
            pointer-events: auto;
            visibility: visible;
        }
        .aurora-dropdown-item {
            display: flex !important;
            align-items: center !important;
            gap: 12px !important;
            padding: 11px 14px !important;
            border-radius: 10px !important;
            color: rgba(255,255,255,0.85) !important;
            font-weight: 600 !important;
            font-size: 0.9rem !important;
            text-decoration: none !important;
            transition: background 0.18s ease, color 0.18s ease, transform 0.15s ease !important;
            background: transparent !important;
        }
        .aurora-dropdown-item:hover {
            background: rgba(56, 189, 248, 0.12) !important;
            color: #38bdf8 !important;
            transform: translateX(3px) !important;
        }
        .aurora-dropdown-item .item-icon {
            width: 32px;
            height: 32px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.85rem;
            flex-shrink: 0;
        }
        .aurora-divider {
            height: 1px;
            background: linear-gradient(to right, transparent, rgba(56,189,248,0.2), transparent);
            margin: 6px 8px;
        }
        .aurora-dropdown-label {
            font-size: 0.65rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.12em;
            color: #475569;
            padding: 4px 14px 2px;
        }
        /* Login button glow */
        .login-btn-aurora {
            background: linear-gradient(135deg, rgba(14,165,233,0.15), rgba(99,102,241,0.15)) !important;
            border: 1px solid rgba(56,189,248,0.35) !important;
            color: #38bdf8 !important;
            border-radius: 50px !important;
            font-weight: 700 !important;
            transition: all 0.25s ease !important;
            padding: 8px 22px !important;
        }
        .login-btn-aurora:hover {
            background: linear-gradient(135deg, rgba(14,165,233,0.3), rgba(99,102,241,0.3)) !important;
            border-color: #38bdf8 !important;
            box-shadow: 0 0 20px rgba(56,189,248,0.25) !important;
            color: #fff !important;
        }
        .login-btn-aurora::after { display: none !important; }
    </style>

    <!-- Meta tags for performance -->
    <meta name="theme-color" content="#3498db">
    <meta name="description" content="Find the perfect fitness trainer for your goals">
</head>

<body>
    <!-- Loading indicator -->
    <div id="loading-indicator" class="loading"
        style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: white; z-index: 9999; display: flex; align-items: center; justify-content: center;">
        <div class="text-center">
            <i class="fas fa-dumbbell fa-spin fa-2x text-primary mb-3"></i>
            <p class="text-muted">Loading...</p>
        </div>
    </div>

    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg sticky-top">
        <div class="container">
            <a class="navbar-brand" href="/"><i class="fas fa-dumbbell me-2"></i>FitConnect</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <i class="fas fa-bars text-white"></i>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto align-items-center">
                    <!-- Theme Switcher -->
                    <li class="nav-item me-3">
                        <button onclick="toggleTheme()" class="btn btn-sm d-flex align-items-center gap-2 theme-toggle-btn" 
                                style="background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); color: inherit; padding: 6px 12px; border-radius: 20px;">
                            <i class="fas fa-magic"></i>
                            <span class="d-none d-md-inline" id="theme-status-text">Switch Theme</span>
                        </button>
                    </li>
                    <li class="nav-item"><a class="nav-link fw-semibold" href="/search">Find a Trainer</a></li>
                    <li class="nav-item"><a class="nav-link fw-semibold" href="/trainer/login?mode=signup">Become a Trainer</a></li>

                    <% if (typeof locals.session !== 'undefined' && locals.session.userId && locals.session.userRole === 'user') { %>
                        <li class="nav-item ms-lg-3">
                            <a class="btn btn-modern px-4" href="/dashboard">Dashboard</a>
                        </li>
                        <li class="nav-item ms-2">
                            <a class="nav-link text-danger" href="/user/logout"><i class="fas fa-sign-out-alt"></i></a>
                        </li>
                    <% } else if (typeof locals.session !== 'undefined' && locals.session.trainerId && locals.session.userRole === 'trainer') { %>
                        <li class="nav-item ms-lg-3">
                            <a class="btn btn-modern px-4" href="/trainer/dashboard">Dashboard</a>
                        </li>
                        <li class="nav-item ms-2">
                            <a class="nav-link text-danger" href="/trainer/logout"><i class="fas fa-sign-out-alt"></i></a>
                        </li>
                    <% } else if (typeof locals.session !== 'undefined' && locals.session.adminId && locals.session.userRole === 'admin') { %>
                        <li class="nav-item ms-lg-3">
                            <a class="btn btn-modern px-4" href="/admin/dashboard">Admin Panel</a>
                        </li>
                        <li class="nav-item ms-2">
                            <a class="nav-link text-danger" href="/admin/logout"><i class="fas fa-sign-out-alt"></i></a>
                        </li>
                    <% } else { %>
                        <li class="nav-item dropdown ms-lg-3">
                            <button class="login-btn-aurora d-flex align-items-center gap-2"
                                id="loginDropdown" type="button"
                                onclick="toggleAuroraDropdown(event)"
                                style="text-decoration:none;background:none;border:1px solid rgba(56,189,248,0.35);cursor:pointer;">
                                <i class="fas fa-user-circle" style="font-size:1rem;"></i>
                                <span>Login</span>
                                <i class="fas fa-chevron-down" id="loginChevron" style="font-size:0.65rem;transition:transform 0.22s;"></i>
                            </button>
                            <ul class="dropdown-menu aurora-dropdown dropdown-menu-end" id="auroraMenu" aria-labelledby="loginDropdown">
                                <li><div class="aurora-dropdown-label">Choose your role</div></li>
                                <li>
                                    <a class="aurora-dropdown-item" href="/user-login">
                                        <span class="item-icon" style="background:rgba(56,189,248,0.15);color:#38bdf8;">
                                            <i class="fas fa-user"></i>
                                        </span>
                                        <div>
                                            <div style="font-size:0.88rem;font-weight:700;">User Login</div>
                                            <div style="font-size:0.72rem;color:#64748b;font-weight:500;">Book &amp; manage sessions</div>
                                        </div>
                                    </a>
                                </li>
                                <li>
                                    <a class="aurora-dropdown-item" href="/trainer/login?mode=signup">
                                        <span class="item-icon" style="background:rgba(74,222,128,0.15);color:#4ade80;">
                                            <i class="fas fa-dumbbell"></i>
                                        </span>
                                        <div>
                                            <div style="font-size:0.88rem;font-weight:700;">Trainer Login</div>
                                            <div style="font-size:0.72rem;color:#64748b;font-weight:500;">Manage your clients</div>
                                        </div>
                                    </a>
                                </li>
                                <li><div class="aurora-divider"></div></li>
                                <li>
                                    <a class="aurora-dropdown-item" href="/admin/login">
                                        <span class="item-icon" style="background:rgba(251,113,133,0.15);color:#fb7185;">
                                            <i class="fas fa-shield-alt"></i>
                                        </span>
                                        <div>
                                            <div style="font-size:0.88rem;font-weight:700;">Admin Login</div>
                                            <div style="font-size:0.72rem;color:#64748b;font-weight:500;">Platform administration</div>
                                        </div>
                                    </a>
                                </li>
                            </ul>
                        </li>
                    <% } %>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <main>
        <%- body %>
    </main>

    <!-- React + Tailwind + Motion Integration -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/react@18/umd/react.development.js"></script>
    <script src="https://unpkg.com/react-dom@18/umd/react-dom.development.js"></script>
    <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>
    <script src="https://unpkg.com/framer-motion/dist/framer-motion.js"></script>

    <!-- App Container -->
    <div id="footer-root"></div>

    <!-- React Implementation -->
    <script type="text/babel" data-presets="react,typescript">
        const { motion } = window.Motion;
        const cn = (...classes) => classes.filter(Boolean).join(' ');

        const TextHoverEffect = ({ text, duration, className }) => {
            const svgRef = React.useRef(null);
            const [cursor, setCursor] = React.useState({ x: 0, y: 0 });
            const [hovered, setHovered] = React.useState(false);
            const [maskPosition, setMaskPosition] = React.useState({ cx: "50%", cy: "50%" });

            React.useEffect(() => {
                if (svgRef.current && cursor.x !== null && cursor.y !== null) {
                    const svgRect = svgRef.current.getBoundingClientRect();
                    const cxPercentage = ((cursor.x - svgRect.left) / svgRect.width) * 100;
                    const cyPercentage = ((cursor.y - svgRect.top) / svgRect.height) * 100;
                    setMaskPosition({ cx: `${cxPercentage}%`, cy: `${cyPercentage}%` });
                }
            }, [cursor]);

            return (
                <svg
                    ref={svgRef} width="100%" height="100%" viewBox="0 0 450 100"
                    onMouseEnter={() => setHovered(true)} onMouseLeave={() => setHovered(false)}
                    onMouseMove={(e) => setCursor({ x: e.clientX, y: e.clientY })}
                    className={cn("select-none uppercase cursor-pointer", className)}
                >
                    <defs>
                        <linearGradient id="textGradient" gradientUnits="userSpaceOnUse" cx="50%" cy="50%" r="25%">
                            {hovered && (
                                <>
                                    <stop offset="0%" stopColor="#eab308" />
                                    <stop offset="25%" stopColor="#ef4444" />
                                    <stop offset="50%" stopColor="#80eeb4" />
                                    <stop offset="75%" stopColor="#06b6d4" />
                                    <stop offset="100%" stopColor="#8b5cf6" />
                                </>
                            )}
                        </linearGradient>
                        <motion.radialGradient
                            id="revealMask" gradientUnits="userSpaceOnUse" r="20%"
                            initial={{ cx: "50%", cy: "50%" }} animate={maskPosition}
                            transition={{ duration: duration ?? 0, ease: "easeOut" }}
                        >
                            <stop offset="0%" stopColor="white" />
                            <stop offset="100%" stopColor="black" />
                        </motion.radialGradient>
                        <mask id="textMask">
                            <rect x="0" y="0" width="100%" height="100%" fill="url(#revealMask)" />
                        </mask>
                    </defs>
                    <text x="50%" y="50%" textAnchor="middle" dominantBaseline="middle" strokeWidth="0.3"
                        className="fill-transparent stroke-white/20 font-bold opacity-70 text-6xl"
                        style={{ opacity: hovered ? 0.7 : 0 }}>{text}</text>
                    <motion.text x="50%" y="50%" textAnchor="middle" dominantBaseline="middle" strokeWidth="0.3"
                        className="fill-transparent stroke-[#3ca2fa] font-bold text-6xl"
                        initial={{ strokeDashoffset: 1000, strokeDasharray: 1000 }}
                        animate={{ strokeDashoffset: 0, strokeDasharray: 1000 }}
                        transition={{ duration: 4, ease: "easeInOut" }}>{text}</motion.text>
                    <text x="50%" y="50%" textAnchor="middle" dominantBaseline="middle" stroke="url(#textGradient)" strokeWidth="0.3"
                        mask="url(#textMask)" className="fill-transparent font-bold text-6xl">{text}</text>
                </svg>
            );
        };

        const isClassic = document.documentElement.classList.contains('theme-classic');
        const themeColors = isClassic ? {
            bg: "#F8F9FA",
            footerBg: "bg-slate-900",
            primary: "#C2410C", // Gold/Rust
            textMuted: "text-slate-400",
            border: "border-slate-800"
        } : {
            bg: "#171717",
            footerBg: "bg-neutral-950",
            primary: "#3ca2fa", // Aurora Blue
            textMuted: "text-neutral-400",
            border: "border-white/10"
        };

        const FooterBackgroundGradient = () => (
            <div className="absolute inset-0 z-0" style={{ background: isClassic ? "none" : `radial-gradient(125% 125% at 50% 10%, #171717 50%, #3ca2fa33 100%)` }} />
        );

        const HoverFooter = () => {
            const footerLinks = [
                { title: "About Us", links: [{ label: "Company History", href: "#" }, { label: "Meet the Team", href: "#" }, { label: "Employee Handbook", href: "#" }, { label: "Careers", href: "#" }] },
                { title: "Helpful Links", links: [{ label: "FAQs", href: "#" }, { label: "Support", href: "#" }, { label: "Live Chat", href: "#" }] },
            ];
            const contactInfo = [
                { icon: <i className={`fas fa-envelope`} style={{color: themeColors.primary}}></i>, text: "support@fitconnect.com" },
                { icon: <i className={`fas fa-phone`} style={{color: themeColors.primary}}></i>, text: "+91 6362596973" },
                { icon: <i className={`fas fa-map-marker-alt`} style={{color: themeColors.primary}}></i>, text: "karwar, INDIA" },
            ];

            return (
                <footer className={`${themeColors.footerBg} relative h-fit rounded-[2.5rem] overflow-hidden m-8 border ${themeColors.border} text-white`}>
                    <div className="max-w-7xl mx-auto p-14 z-40 relative">
                        <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 pb-12">
                            <div className="flex flex-col space-y-4">
                                <div className="flex items-center space-x-2">
                                    <span style={{color: themeColors.primary}} className="text-3xl font-extrabold">&hearts;</span>
                                    <span className="text-3xl font-bold text-white">FitConnect</span>
                                </div>
                                <p className={`text-sm ${themeColors.textMuted} leading-relaxed`}>FitConnect is a modern platform to find the best trainers.</p>
                            </div>
                            {footerLinks.map((section) => (
                                <div key={section.title}>
                                    <h4 className="text-xl font-semibold mb-6 text-white">{section.title}</h4>
                                    <ul className="space-y-3">
                                        {section.links.map((link) => (
                                            <li key={link.label} className="relative">
                                                <a href={link.href} className={`${themeColors.textMuted} hover:text-[${themeColors.primary}] transition-colors`}>{link.label}</a>
                                                {link.pulse && <span className="absolute top-1 -right-3 w-2 h-2 rounded-full bg-[#3ca2fa] animate-pulse"></span>}
                                            </li>
                                        ))}
                                    </ul>
                                </div>
                            ))}
                            <div>
                                <h4 className="text-xl font-semibold mb-6 text-white">Contact Us</h4>
                                <ul className="space-y-4">
                                    {contactInfo.map((item, i) => (
                                        <li key={i} className={`flex items-center space-x-3 ${themeColors.textMuted}`}>
                                            {item.icon}<span>{item.text}</span>
                                        </li>
                                    ))}
                                </ul>
                            </div>
                        </div>
                        <hr className={`border-t ${themeColors.border} my-8`} />
                        <div className="flex flex-col md:row justify-between items-center text-sm text-neutral-500">
                            <p>&copy; {new Date().getFullYear()} FitConnect. All rights reserved.</p>
                        </div>
                    </div>
                    <div className="lg:flex hidden h-[30rem] -mt-52 -mb-36">
                        <TextHoverEffect text="FitConnect" className="z-50" />
                    </div>
                    <FooterBackgroundGradient />
                </footer>
            );
        };

        const root = ReactDOM.createRoot(document.getElementById('footer-root'));
        root.render(<HoverFooter />);
    </script>

    <!-- Optimized JavaScript -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        // Aurora dropdown toggle
        function toggleAuroraDropdown(e) {
            e.stopPropagation();
            const menu = document.getElementById('auroraMenu');
            const chevron = document.getElementById('loginChevron');
            if (!menu) return;
            const isOpen = menu.classList.contains('open');
            menu.classList.toggle('open', !isOpen);
            if (chevron) chevron.style.transform = isOpen ? '' : 'rotate(180deg)';
        }
        document.addEventListener('click', function(e) {
            const menu = document.getElementById('auroraMenu');
            const btn = document.getElementById('loginDropdown');
            const chevron = document.getElementById('loginChevron');
            if (menu && menu.classList.contains('open') &&
                !menu.contains(e.target) && btn && !btn.contains(e.target)) {
                menu.classList.remove('open');
                if (chevron) chevron.style.transform = '';
            }
        });
    </script>

    <!-- Performance optimizations -->
    <script>
        // Hide loading indicator when page is ready
        document.addEventListener('DOMContentLoaded', function () {
            setTimeout(function () {
                const loader = document.getElementById('loading-indicator');
                if (loader) {
                    loader.style.opacity = '0';
                    setTimeout(() => loader.remove(), 300);
                }
            }, 500);
        });

        // Preload critical resources
        function preloadResource(url) {
            const link = document.createElement('link');
            link.rel = 'preload';
            link.as = 'script';
            link.href = url;
            document.head.appendChild(link);
        }

        // Lazy load images
        if ('IntersectionObserver' in window) {
            const imageObserver = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        const img = entry.target;
                        img.src = img.dataset.src;
                        img.classList.remove('lazy');
                        imageObserver.unobserve(img);
                    }
                });
            });

            document.querySelectorAll('img[data-src]').forEach(img => {
                imageObserver.observe(img);
            });
        }

        // Smooth scroll behavior
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                e.preventDefault();
                const target = document.querySelector(this.getAttribute('href'));
                if (target) {
                    target.scrollIntoView({ behavior: 'smooth' });
                }
            });
        });

        // Form validation optimization
        document.querySelectorAll('form').forEach(form => {
            form.addEventListener('submit', function (e) {
                const submitBtn = form.querySelector('[type="submit"]');
                if (submitBtn) {
                    submitBtn.disabled = true;
                    submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Processing...';
                }
            });
        });
    </script>
</body>

</html>