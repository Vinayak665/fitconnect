<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>User Dashboard - FitConnect</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style-optimized.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <%- include('../partials/theme-logic') %>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700&display=swap');
        
        *{ font-family: 'Montserrat', sans-serif; }
        
        .fitconnect-brand { font-size: 1.5rem !important; font-weight: 800 !important; }
        
        body { 
            background-color: #0f172a; /* Slate 900 */
            color: #f8fafc; /* Slate 50 */
            min-height: 100vh;
            overflow-x: hidden;
        }

        /* Solid Professional SaaS Panels */
        .glass-panel {
            background: #1e293b !important; /* Slate 800 */
            border: 1px solid #334155 !important; /* Slate 700 */
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06) !important;
            color: #f8fafc !important;
        }
        
        .glass-panel-content {
            background: #0f172a !important; /* Slate 900 for inner content */
            border: 1px solid #334155 !important;
            color: #f8fafc !important;
            box-shadow: inset 0 2px 4px 0 rgba(0, 0, 0, 0.05) !important;
        }

        /* Sidebar & Topbar */
        .sidebar { 
            min-height: 100vh; 
            border-right: 1px solid #334155;
            background: #0f172a !important;
        }
        .sidebar a { color: #cbd5e1; text-decoration: none; padding: 15px 20px; display: block; border-left: 3px solid transparent; transition: 0.2s; font-weight: 500; }
        .sidebar a:hover, .sidebar a.active { background: #1e293b; color: #38bdf8; border-left-color: #0ea5e9; }
        
        .topbar { 
            background: #0f172a !important; 
            border-bottom: 1px solid #334155;
        }
        
        .navbar-brand, .fitconnect-brand { color: #f8fafc !important; font-weight: 700; letter-spacing: -0.5px; }
        
        /* Table styles */
        .table { color: #f8fafc; }
        .table-hover tbody tr:hover { background-color: #1e293b; color: #f8fafc; }
        .table > :not(caption) > * > * { border-bottom-color: #334155; background-color: transparent !important; color: #f8fafc; }
        .table thead th { border-bottom: 1px solid #475569 !important; color: #94a3b8; font-weight: 600; text-transform: uppercase; font-size: 0.75rem; letter-spacing: 0.05em; padding-bottom: 1rem;}
        
        /* Text color overrides */
        .text-dark, .text-gray-800 { color: #f8fafc !important; }
        .text-muted { color: #94a3b8 !important; }
        .btn-modern { background: #0ea5e9; border: none; color: white; transition: 0.2s; font-weight: 600; }
        .btn-modern:hover { background: #0284c7; transform: translateY(-1px); box-shadow: 0 4px 6px -1px rgba(14, 165, 233, 0.4); color: white; }

        .dropdown-menu { background: #1e293b; border: 1px solid #334155; box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1); }
        .dropdown-item { color: #cbd5e1; }
        .dropdown-item:hover { background: #334155; color: #f8fafc; }
        .dropdown-divider { border-color: #334155; }
        
        /* Chat UI Professionalized */
        .chat-container { min-height: 600px; height: calc(100vh - 280px); background: #1e293b !important; border-radius: 1rem; border: 1px solid #334155 !important; overflow: hidden; }
        .chat-list-col { border-right: 1px solid #334155; overflow-y: auto; height: 100%; padding-right: 0; background: #0f172a; }
        .chat-view-col { height: 100%; padding-left: 0; padding-right: 0; display: flex; flex-direction: column; background: #1e293b; }
        .chat-item { transition: background 0.2s ease; cursor: pointer; border-bottom: 1px solid #334155 !important; }
        .chat-item:hover, .chat-item.active-chat { background: #1e293b !important; border-left: 3px solid #0ea5e9; }
        .chat-offcanvas-header { border-bottom: 1px solid #334155; padding: 1.25rem 1.5rem; background: #0f172a; }
        .chat-messages { flex-grow: 1; overflow-y: auto; padding: 1.5rem; display: flex; flex-direction: column; gap: 1rem; }
        .chat-msg { max-width: 80%; padding: 12px 16px; border-radius: 12px; font-size: 0.9rem; line-height: 1.5; }
        .chat-msg.sent { align-self: flex-end; background: #0ea5e9; color: white; border-bottom-right-radius: 4px; }
        .chat-msg.received { align-self: flex-start; background: #334155; color: #f8fafc; border-bottom-left-radius: 4px; }
        .chat-input-area { padding: 1rem 1.5rem; border-top: 1px solid #334155; background: #0f172a; }
        .chat-input-box { background: #1e293b; border: 1px solid #475569; border-radius: 8px; padding: 12px 16px; color: white; width: 100%; outline: none; transition: border-color 0.2s; font-size: 0.9rem;}
        .chat-input-box:focus { border-color: #0ea5e9; }
        .chat-send-btn { background: #0ea5e9; color: white; border: none; border-radius: 8px; width: 45px; height: 45px; display: flex; align-items: center; justify-content: center; cursor: pointer; transition: 0.2s; margin-left: 12px; }
        .chat-send-btn:hover { background: #0284c7; }
    </style>
</head>
<body>
    <%- include('../partials/notifications') %>
    <!-- Content Starts Here -->

    <div class="container-fluid p-0">
        <div class="row g-0 flex-nowrap">
            <!-- Sidebar (Glassmorphism) -->
            <div class="col-auto col-md-3 col-xl-2 px-sm-2 px-0 sidebar d-none d-lg-block">
                <div class="d-flex flex-column align-items-center align-items-sm-start px-3 pt-4 text-white w-100">
                    <a href="/" class="d-flex align-items-center pb-3 mb-4 w-100 text-white text-decoration-none border-bottom" style="border-color: rgba(255,255,255,0.1) !important;">
                        <i class="fas fa-dumbbell me-2 fitconnect-brand"></i>
                        <span class="fs-5 fw-bold d-none d-sm-inline fitconnect-brand">FitConnect</span>
                    </a>
                    <div class="mb-2 px-3 text-uppercase small fw-bold" style="opacity: 0.5; color: #fff;">Menu</div>
                    <ul class="nav nav-pills flex-column mb-sm-auto mb-0 align-items-center align-items-sm-start w-100">
                        <li class="nav-item w-100"><a href="javascript:void(0)" onclick="showSection('overview')" id="nav-overview" class="active"><i class="fas fa-home me-2"></i> <span class="d-none d-sm-inline">Dashboard</span></a></li>
                        <li class="nav-item w-100"><a href="javascript:void(0)" onclick="showSection('chats')" id="nav-chats"><i class="fas fa-comments me-2"></i> <span class="d-none d-sm-inline">Messages</span></a></li>
                        <li class="nav-item w-100"><a href="/search"><i class="fas fa-search me-2"></i> <span class="d-none d-sm-inline">Find Trainers</span></a></li>
                        <li class="nav-item w-100"><a href="/edit-profile"><i class="fas fa-user-edit me-2"></i> <span class="d-none d-sm-inline">Edit Profile</span></a></li>
                    </ul>
                    <hr class="w-100 mt-5 mb-3" style="border-color: rgba(255,255,255,0.1);">
                    <div class="mb-2 px-3 text-uppercase small fw-bold" style="opacity: 0.5; color: #fff;">Account</div>
                    <a href="/user/logout" class="w-100"><i class="fas fa-sign-out-alt me-2 text-danger"></i> <span class="d-none d-sm-inline">Logout</span></a>
                </div>
            </div>

            <!-- Main Content -->
            <div class="col py-0 px-0" style="height: 100vh; overflow-y: auto; overflow-x: hidden;">
                <!-- Topbar (Glassmorphism) -->
                <nav class="navbar navbar-expand-lg topbar px-4 py-3 align-items-center sticky-top">
                    <span class="d-lg-none fw-bold ms-2 fitconnect-brand fs-4">FitConnect</span>
                    
                    <div class="ms-auto d-flex align-items-center">
                        <button onclick="toggleTheme()" class="btn btn-sm d-flex align-items-center gap-2 me-3 theme-toggle-btn" 
                                style="background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); color: inherit; padding: 6px 12px; border-radius: 20px;">
                            <i class="fas fa-paint-brush"></i>
                        </button>
                        <div class="dropdown">
                            <button class="btn dropdown-toggle border-0 fw-bold text-white d-flex align-items-center glass-panel rounded-pill py-2 px-3" type="button" data-bs-toggle="dropdown" style="background: rgba(255,255,255,0.1) !important;">
                                <img src="<%= user.profile_image ? (user.profile_image.startsWith('http') ? user.profile_image : '/uploads/' + user.profile_image) : 'https://cdn-icons-png.flaticon.com/512/3135/3135715.png' %>" class="rounded-circle me-2 border border-2 border-primary" width="32" style="height: 32px; object-fit: cover; object-position: center top;">
                                <%= user.name %>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2 rounded-3">
                                <li><a class="dropdown-item py-2" href="/edit-profile"><i class="fas fa-user fa-sm me-3 opacity-75"></i> Profile</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item py-2 text-danger" href="/user/logout"><i class="fas fa-sign-out-alt fa-sm me-3 opacity-75"></i> Logout</a></li>
                            </ul>
                        </div>
                    </div>
                </nav>

                <div class="p-4 p-md-5">
                    <div class="d-sm-flex align-items-center justify-content-between mb-5">
                        <h1 class="h2 mb-0 fw-bold" style="letter-spacing: -0.5px; color: #f8fafc;" id="main-heading">My Dashboard</h1>
                        <a href="/search" class="d-none d-sm-inline-block btn btn-modern btn-lg rounded-pill px-4 shadow-lg"><i class="fas fa-plus fa-sm text-white-50 me-2"></i> Book New Session</a>
                    </div>
                    <div id="overview-section" class="dashboard-section">
                        <div class="row g-4">
                        <div class="col-12">
                            <!-- Bookings Card -->
                            <div class="card glass-panel rounded-4 p-4 p-md-5 h-100 border-0">
                                <div class="d-flex align-items-center mb-4 pb-2 border-bottom border-secondary border-opacity-25">
                                    <div class="bg-primary bg-opacity-25 p-3 rounded-circle me-3">
                                        <i class="fas fa-calendar-alt text-primary fs-4"></i>
                                    </div>
                                    <h4 class="fw-bold mb-0 text-white">My Recent Bookings</h4>
                                </div>
                                
                                <% if(bookings && bookings.length > 0) { %>
                                    <div class="table-responsive">
                                        <table class="table table-hover align-middle border-0">
                                            <thead>
                                                <tr>
                                                    <th class="border-top-0 border-bottom border-secondary opacity-75">Date & Time</th>
                                                    <th class="border-top-0 border-bottom border-secondary opacity-75">Trainer</th>
                                                    <th class="border-top-0 border-bottom border-secondary opacity-75">Amount</th>
                                                    <th class="border-top-0 border-bottom border-secondary opacity-75">Payment</th>
                                                    <th class="border-top-0 border-bottom border-secondary opacity-75 text-end">Status</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <% bookings.forEach(booking => { %>
                                                    <tr>
                                                        <td class="py-3">
                                                            <div class="d-flex align-items-center">
                                                                <div class="bg-white bg-opacity-10 p-2 rounded text-center me-3 shadow-sm border border-white border-opacity-10" style="min-width: 50px;">
                                                                    <div class="fw-bold text-white fs-5 lh-1"><%= new Date(booking.booking_date).getDate() %></div>
                                                                    <small class="text-uppercase" style="font-size: 0.65rem; color: #a5b4fc;"><%= new Date(booking.booking_date).toLocaleString('default', { month: 'short' }) %></small>
                                                                </div>
                                                                <div>
                                                                    <div class="fw-bold text-white"><%= new Date(booking.booking_date).toLocaleDateString() %></div>
                                                                    <small style="color: #cbd5e1;"><i class="far fa-clock me-1"></i> <%= new Date(booking.booking_date).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'}) %></small>
                                                                </div>
                                                            </div>
                                                        </td>
                                                        <td class="py-3">
                                                            <div class="fw-bold text-white"><%= booking.trainer_name %></div>
                                                        </td>
                                                        <td class="py-3">
                                                            <div class="fw-bold" style="color: #86efac;">₹<%= booking.amount || 0 %></div>
                                                        </td>
                                                        <td class="py-3">
                                                            <% 
                                                                let pStatus = (booking.payment_status || 'pending').toLowerCase();
                                                                let pMethod = (booking.payment_method || 'offline').toLowerCase();
                                                            %>
                                                            <div class="d-flex flex-column gap-1">
                                                                <% if(pStatus === 'paid') { %>
                                                                    <span class="badge bg-success rounded-pill px-2 py-1 w-auto d-inline-block" style="font-size: 0.65rem;"><i class="fas fa-check-circle"></i> PAID</span>
                                                                <% } else if(pStatus === 'paid_pending') { %>
                                                                    <span class="badge bg-info text-dark rounded-pill px-2 py-1 w-auto d-inline-block" style="font-size: 0.65rem;"><i class="fas fa-clock"></i> VERIFYING</span>
                                                                <% } else { %>
                                                                    <% if(pMethod === 'online') { %>
                                                                        <a href="/payment/<%= booking.id %>" class="btn btn-sm btn-primary rounded-pill py-0 px-2 fw-bold" style="font-size: 0.65rem;">PAY NOW</a>
                                                                    <% } else { %>
                                                                        <span class="badge bg-secondary rounded-pill px-2 py-1 w-auto d-inline-block" style="font-size: 0.65rem;">UNPAID</span>
                                                                    <% } %>
                                                                <% } %>
                                                                <small class="text-muted text-uppercase" style="font-size: 0.55rem;"><%= pMethod %></small>
                                                            </div>
                                                        </td>
                                                        <td class="py-3 text-end">
                                                            <% 
                                                            let status = (booking.status || 'pending').toLowerCase();
                                                            let badgeBg = 'bg-secondary';
                                                            let badgeIcon = 'fa-circle-notch';
                                                            if(status === 'approved' || status === 'confirmed') { badgeBg = 'bg-success'; badgeIcon = 'fa-check-circle'; }
                                                            else if(status === 'pending') { badgeBg = 'bg-warning text-dark'; badgeIcon = 'fa-clock'; }
                                                            else if(status === 'rejected' || status === 'declined') { badgeBg = 'bg-danger'; badgeIcon = 'fa-times-circle'; }
                                                            else if(status === 'done') { badgeBg = 'bg-info bg-opacity-75'; badgeIcon = 'fa-flag-checkered'; }
                                                            %>
                                                            <div class="d-flex flex-column align-items-end gap-2">
                                                                <% 
                                                                let badgeText = status.toUpperCase();
                                                                if(booking.trainer_suggestion && (status === 'pending' || status === 'rejected' || status === 'declined')) {
                                                                    badgeBg = 'bg-warning text-dark';
                                                                    badgeIcon = 'fa-clock';
                                                                    badgeText = 'BUSY / RESCHEDULE';
                                                                }
                                                                %>
                                                                <span class="badge <%= badgeBg %> rounded-pill px-3 py-2 shadow-sm border border-white border-opacity-25" style="backdrop-filter: blur(4px);">
                                                                    <i class="fas <%= badgeIcon %> me-1"></i> <%= badgeText %>
                                                                </span>
                                                                <% if(booking.trainer_suggestion) { %>
                                                                    <small class="text-white opacity-75 mt-1" style="font-size: 0.75rem; max-width: 150px; text-align: right;">
                                                                        <i class="fas fa-reply me-1 text-info"></i> Trainer: "<%= booking.trainer_suggestion %>"
                                                                    </small>
                                                                    <button type="button" class="btn btn-sm btn-outline-warning rounded-pill mt-1 py-1 px-3 fw-bold" style="font-size: 0.65rem;" onclick="openRescheduleModal('<%= booking.id %>', '<%= booking.trainer_suggestion %>')">
                                                                        <i class="fas fa-calendar-alt me-1"></i> Reschedule
                                                                    </button>
                                                                <% } %>
                                                                <div class="d-flex gap-2 mt-1">
                                                                    <% if(status === 'approved' || status === 'confirmed') { %>
                                                                        <button onclick="updateStatus('<%= booking.id %>', 'done')" class="btn btn-sm btn-outline-info rounded-pill px-3 shadow-sm" style="font-size: 0.7rem; font-weight: 600;">
                                                                            <i class="fas fa-check-double me-1"></i> Mark Done
                                                                        </button>
                                                                    <% } %>
                                                                </div>
                                                            </div>
                                                        </td>
                                                    </tr>
                                                <% }) %>
                                            </tbody>
                                        </table>
                                    </div>
                                <% } else { %>
                                    <div class="text-center py-5 my-4">
                                        <div class="position-relative d-inline-block mx-auto mb-4">
                                            <div class="position-absolute w-100 h-100 rounded-circle bg-white opacity-10" style="filter: blur(20px); transform: scale(1.5);"></div>
                                            <div class="bg-white bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center mx-auto position-relative border border-white border-opacity-10" style="width: 100px; height: 100px;">
                                                <i class="fas fa-calendar-times fa-3x" style="color: #64748b;"></i>
                                            </div>
                                        </div>
                                        <h4 class="text-white fw-bold mb-2">No bookings yet!</h4>
                                        <p style="color: #94a3b8;" class="mb-4">Find your perfect trainer and start your journey towards greatness.</p>
                                        <a href="/search" class="btn btn-modern rounded-pill px-4 py-2 fw-medium shadow">Browse Trainers</a>
                                    </div>
                                <% } %>
                            </div>
                        </div>
                    </div>
                </div>
                    
                <!-- Chats Section -->
                <div id="chats-section" class="dashboard-section d-none">
                    <div class="chat-container shadow-lg">
                        <div class="row h-100 m-0">
                            <% 
                                let chatBookings = [];
                                if(bookings) { 
                                    chatBookings = bookings.filter(b => b.status === 'approved' || b.status === 'confirmed' || b.status === 'done');
                                }
                            %>
                            
                            <!-- Left Col: Conversation List -->
                            <div class="col-12 col-md-5 col-lg-4 chat-list-col py-3 px-0">
                                <div class="px-3 pb-3 border-bottom border-secondary border-opacity-25 mb-2">
                                    <h4 class="fw-bold text-white mb-0 mt-2"><i class="fas fa-comments text-primary me-2"></i> Messages</h4>
                                </div>
                                <% if(chatBookings.length > 0) { %>
                                    <div class="list-group list-group-flush bg-transparent pe-2" id="chatListGroup">
                                        <% chatBookings.forEach(booking => { %>
                                            <div class="list-group-item chat-item bg-transparent border-bottom border-secondary border-opacity-25 py-3 p-3 d-flex align-items-center gap-3" 
                                                 id="chat-item-<%= booking.id %>"
                                                 onclick="openInlineChat('<%= booking.id %>', '<%= booking.trainer_name %>')">
                                                <div class="bg-white bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center shadow-sm border border-white border-opacity-10 shrink-0" style="width: 50px; height: 50px; min-width: 50px;">
                                                    <i class="fas fa-user-tie text-white opacity-75 fs-5"></i>
                                                </div>
                                                <div class="flex-grow-1 overflow-hidden">
                                                    <h6 class="fw-bold text-white mb-0 text-truncate"><%= booking.trainer_name %></h6>
                                                    <small class="text-muted d-block text-truncate"><%= new Date(booking.booking_date).toLocaleDateString() %></small>
                                                </div>
                                                <i class="fas fa-chevron-right opacity-50 ms-auto text-white"></i>
                                            </div>
                                        <% }) %>
                                    </div>
                                <% } else { %>
                                    <div class="text-center py-5 px-3">
                                        <div class="bg-white bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center mx-auto mb-3" style="width: 60px; height: 60px;">
                                            <i class="fas fa-comment-slash fs-4 text-muted"></i>
                                        </div>
                                        <h6 class="text-white fw-bold mb-1">No trainers yet</h6>
                                        <small class="text-muted">Chat unlocks after booking.</small>
                                    </div>
                                <% } %>
                            </div>

                            <!-- Right Col: Active Chat Window -->
                            <div class="col-12 col-md-7 col-lg-8 chat-view-col bg-dark bg-opacity-25 position-relative">
                                
                                <!-- Empty State -->
                                <div id="chatEmptyState" class="d-flex flex-column align-items-center justify-content-center h-100 text-center px-4 w-100 position-absolute top-0 start-0 z-1" style="background: #1e293b;">
                                    <div class="bg-slate-700 bg-opacity-50 p-4 rounded-circle mb-4">
                                        <i class="fas fa-paper-plane fa-3x text-slate-400"></i>
                                    </div>
                                    <h4 class="text-white fw-bold">Your Messages</h4>
                                    <p class="text-muted">Select a trainer from the left to start chatting instantly.</p>
                                </div>

                                <!-- Active Chat Interface -->
                                <div id="chatActiveWindow" class="d-none flex-column h-100 w-100 position-relative z-2 bg-transparent">
                                    <div class="chat-offcanvas-header d-flex justify-content-between align-items-center shadow-sm">
                                        <h5 class="mb-0 fw-bold d-flex align-items-center text-white" style="font-size: 1.15rem;">
                                            <div class="bg-primary p-2 rounded-circle me-3 d-flex align-items-center justify-content-center shadow-sm" style="width: 35px; height: 35px;">
                                                <i class="fas fa-dumbbell text-white small"></i>
                                            </div>
                                            <span id="chatTrainerName">Trainer Name</span>
                                        </h5>
                                    </div>
                                    
                                    <div class="chat-messages flex-grow-1" id="chatMessagesArea" style="overflow-y: auto; padding: 1.5rem;">
                                        <!-- Messages dynamically loaded here -->
                                    </div>
                                    
                                    <div class="chat-input-area d-flex align-items-center p-3">
                                        <input type="text" id="chatMessageInput" class="chat-input-box" placeholder="Type a message..." onkeypress="if(event.key==='Enter') sendChatMessage()">
                                        <button class="chat-send-btn shadow" onclick="sendChatMessage()">
                                            <i class="fas fa-paper-plane"></i>
                                        </button>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <script>
        function showSection(sectionId) {
            document.querySelectorAll('.dashboard-section').forEach(el => { el.classList.add('d-none'); });
            
            let navOverview = document.getElementById('nav-overview');
            let navChats = document.getElementById('nav-chats');
            if(navOverview) navOverview.classList.remove('active');
            if(navChats) navChats.classList.remove('active');
            
            const selectedSection = document.getElementById(sectionId + '-section');
            if(selectedSection) selectedSection.classList.remove('d-none');
            
            const selectedNav = document.getElementById('nav-' + sectionId);
            if(selectedNav) selectedNav.classList.add('active');

            const heading = document.getElementById('main-heading');
            if(heading) {
                heading.innerText = sectionId === 'chats' ? 'My Conversations' : 'My Dashboard';
            }
        }

        // On page load, check for section parameter
        window.addEventListener('DOMContentLoaded', () => {
            const urlParams = new URLSearchParams(window.location.search);
            const section = urlParams.get('section');
            if (section) {
                showSection(section);
            }
        });
    </script>
    <script>
        async function updateStatus(id, newStatus) {
            if(!confirm('Mark this session as finished?')) return;
            try {
                const response = await fetch('/trainer/booking/' + id + '/status', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                    body: JSON.stringify({ status: newStatus })
                });
                const result = await response.json();
                if (result.success) {
                    location.reload();
                } else {
                    showToast('Error: ' + (result.error || 'Update failed'), 'error');
                }
            } catch (err) {
                console.error(err);
                showToast('Connection error. Please try again.', 'error');
            }
        }
    </script>
    <script>
        // --- Chat System Logic ---
        let currentChatBookingId = null;
        let chatPollInterval = null;
        let lastMsgCount = 0;
        function openInlineChat(bookingId, trainerName) {
            currentChatBookingId = bookingId;
            lastMsgCount = 0; // Reset tracking for new chat session
            
            // Highlight active item
            document.querySelectorAll('.chat-item').forEach(el => el.classList.remove('active-chat'));
            const activeEl = document.getElementById('chat-item-' + bookingId);
            if(activeEl) activeEl.classList.add('active-chat');

            // Swap Windows
            document.getElementById('chatEmptyState').classList.add('d-none');
            document.getElementById('chatActiveWindow').classList.remove('d-none');
            document.getElementById('chatActiveWindow').classList.add('d-flex');

            document.getElementById('chatTrainerName').innerText = trainerName;
            document.getElementById('chatMessagesArea').innerHTML = '<div class="text-center text-white mt-5"><div class="spinner-border text-primary" role="status"></div><br><span class="mt-2 text-muted">Connecting...</span></div>';
            
            clearInterval(chatPollInterval);
            fetchMessages();
            chatPollInterval = setInterval(fetchMessages, 3000);
        }

        async function fetchMessages() {
            if (!currentChatBookingId) return;
            try {
                const url = '/chat/' + currentChatBookingId + '?t=' + Date.now();
                const res = await fetch(url, { cache: 'no-store' });
                if (!res.ok) {
                    const errText = await res.text();
                    document.getElementById('chatMessagesArea').innerHTML = '<div class="text-danger p-3">Server error ' + res.status + ': ' + errText + '</div>';
                    return;
                }
                const result = await res.json();
                if (result.success) {
                    renderMessages(result.messages);
                } else {
                    document.getElementById('chatMessagesArea').innerHTML = '<div class="text-danger p-3">Error: ' + result.error + '</div>';
                }
            } catch (err) {
                console.error('Failed to fetch messages:', err);
            }
        }

        function renderMessages(messages) {
            const area = document.getElementById('chatMessagesArea');
            if (!messages || messages.length === 0) {
                area.innerHTML = '<div class="text-center text-muted mt-5 opacity-50"><i class="fas fa-comment-slash fa-3x mb-3"></i><br>No messages yet. Start the conversation!</div>';
                lastMsgCount = 0;
                return;
            }

            // Anti-flicker: Only update if message count changed
            if (messages.length === lastMsgCount) return;
            lastMsgCount = messages.length;

            let html = '';
            messages.forEach(m => {
                const isMine = m.sender_type === 'user';
                const time = new Date(m.created_at).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
                html += `<div class="chat-msg ${isMine ? 'sent' : 'received'} shadow-sm">
                    <div>${m.content}</div>
                    <div style="font-size:0.65rem;opacity:0.7;text-align:right;margin-top:4px;">${time}</div>
                </div>`;
            });
            area.innerHTML = html;
            area.scrollTop = area.scrollHeight;
        }

        async function sendChatMessage() {
            const input = document.getElementById('chatMessageInput');
            const content = input.value.trim();
            if (!content || !currentChatBookingId) return;
            input.value = '';
            try {
                const res = await fetch('/chat/' + currentChatBookingId, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ content })
                });
                const result = await res.json();
                if (result.success) {
                    fetchMessages();
                } else {
                    showToast('Send error: ' + result.error, 'error');
                    input.value = content; // restore message
                }
            } catch (err) {
                showToast('Network error: ' + err.message, 'error');
                input.value = content;
            }
        }
    </script>
    
    <!-- Reschedule Modal -->
    <div class="modal fade" id="rescheduleModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content glass-panel" style="border: 1px solid rgba(255,255,255,0.15); background: #1e293b !important; color: white;">
                <div class="modal-header border-bottom border-secondary border-opacity-25">
                    <h5 class="modal-title text-white fw-bold"><i class="fas fa-calendar-alt text-primary me-2"></i>Reschedule Session</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form id="rescheduleForm" method="POST">
                    <div class="modal-body">
                        <input type="hidden" name="booking_id" id="reschedule_booking_id">
                        <div class="mb-3">
                            <label class="form-label fw-bold text-info small text-uppercase">Trainer's Suggestion</label>
                            <div class="alert bg-dark bg-opacity-25 border border-warning border-opacity-25 text-warning rounded-3" id="reschedule_suggestion_text">
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold text-info small text-uppercase">Select New Date &amp; Time</label>
                            <input type="datetime-local" class="form-control" name="new_booking_date" id="new_booking_date" required style="background: rgba(0,0,0,0.3) !important; border: 1px solid rgba(255,255,255,0.1) !important; color: white !important;">
                        </div>
                    </div>
                    <div class="modal-footer border-top border-secondary border-opacity-25">
                        <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary rounded-pill px-4">Confirm Reschedule</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script>
        function openRescheduleModal(bookingId, suggestionText) {
            document.getElementById('reschedule_booking_id').value = bookingId;
            document.getElementById('reschedule_suggestion_text').innerText = '"' + suggestionText + '"';
            document.getElementById('rescheduleForm').action = '/booking/' + bookingId + '/reschedule';
            
            // Show bootstrap modal
            const modal = new bootstrap.Modal(document.getElementById('rescheduleModal'));
            modal.show();
        }
    </script>
    
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
