<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reset Password - FitConnect</title>
    <meta name="description"
        content="Reset your FitConnect account password securely using a one-time OTP code sent to your email.">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700;800&display=swap');

        *,
        *::before,
        *::after {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Montserrat', sans-serif;
        }

        :root {
            <% if (typeof role !=='undefined' && role==='trainer') {
                %>--cyan: #10b981;
                --indigo: #34d399;
                --purple: #059669;
                --teal: #10b981;
                --dark: #022c22;
                --otp-border: #10b981;
                --otp-glow: #10b981;
                --btn-gradient: linear-gradient(135deg, #10b981 0%, #059669 100%);
                --btn-shadow: rgba(16, 185, 129, 0.35);
                --particle-colors: rgba(16, 185, 129, 0.6), rgba(52, 211, 153, 0.6), rgba(5, 150, 105, 0.5), rgba(110, 231, 183, 0.5);
                <%
            }

            else {
                %>--cyan: #38bdf8;
                --indigo: #818cf8;
                --purple: #c084fc;
                --teal: #2dd4bf;
                --dark: #020617;
                --otp-border: #38bdf8;
                --otp-glow: #38bdf8;
                --btn-gradient: linear-gradient(135deg, #38bdf8 0%, #3b82f6 100%);
                --btn-shadow: rgba(56, 189, 248, 0.35);
                --particle-colors: rgba(56, 189, 248, 0.6), rgba(129, 140, 248, 0.6), rgba(192, 132, 252, 0.5), rgba(45, 212, 191, 0.5);
                <%
            }

            %>--card-bg: rgba(255, 255, 255, 0.05);
            --border: rgba(255, 255, 255, 0.10);
            --text-muted: rgba(255, 255, 255, 0.55);
        }

        body {
            background: var(--dark);
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            position: relative;
            overflow: hidden;
            color: #fff;
        }

        /* ─── Aurora Background ─────────────────────────────── */
        .bg-aurora {
            position: absolute;
            inset: 0;
            z-index: 0;
            overflow: hidden;
        }

        .aurora-blob {
            position: absolute;
            filter: blur(100px);
            opacity: 0.55;
            animation: float-blob 22s infinite alternate ease-in-out;
            border-radius: 50%;
        }

        .blob-1 {
            top: -15%;
            left: -10%;
            width: 55vw;
            height: 55vh;
            background: var(--cyan);
            animation-delay: 0s;
        }

        .blob-2 {
            top: 35%;
            right: -20%;
            width: 65vw;
            height: 65vh;
            background: var(--indigo);
            animation-delay: -6s;
        }

        .blob-3 {
            bottom: -25%;
            left: 15%;
            width: 45vw;
            height: 55vh;
            background: var(--purple);
            animation-delay: -12s;
        }

        @keyframes float-blob {
            0% {
                transform: scale(1) translate(0, 0) rotate(0deg);
            }

            50% {
                transform: scale(1.15) translate(2%, -4%) rotate(5deg);
            }

            100% {
                transform: scale(1.25) translate(-3%, 3%) rotate(-4deg);
            }
        }

        /* ─── Floating particles ────────────────────────────── */
        .particle {
            position: absolute;
            border-radius: 50%;
            opacity: 0;
            animation: particle-float linear infinite;
            pointer-events: none;
        }

        @keyframes particle-float {
            0% {
                transform: translateY(110vh) scale(0);
                opacity: 0;
            }

            10% {
                opacity: 0.6;
            }

            90% {
                opacity: 0.4;
            }

            100% {
                transform: translateY(-10vh) scale(1.2);
                opacity: 0;
            }
        }

        /* ─── Card ──────────────────────────────────────────── */
        .glass-card {
            position: relative;
            z-index: 10;
            width: 480px;
            max-width: 92vw;
            padding: 50px 48px;
            background: rgba(15, 23, 42, 0.75);
            backdrop-filter: blur(24px);
            -webkit-backdrop-filter: blur(24px);
            border: 1px solid var(--border);
            border-radius: 28px;
            box-shadow:
                0 0 0 1px rgba(var(--glow-rgb, 56, 189, 248), 0.08),
                0 30px 60px rgba(0, 0, 0, 0.55),
                inset 0 1px 0 rgba(255, 255, 255, 0.06);
            animation: card-in 0.6s cubic-bezier(0.22, 1, 0.36, 1) both;
        }

        @keyframes card-in {
            from {
                opacity: 0;
                transform: translateY(30px) scale(0.97);
            }

            to {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }

        /* ─── Logo ──────────────────────────────────────────── */
        .logo {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            margin-bottom: 28px;
            text-decoration: none;
        }

        .logo-icon {
            width: 40px;
            height: 40px;
            background: linear-gradient(135deg, var(--cyan), var(--indigo));
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2rem;
            box-shadow: 0 4px 15px rgba(56, 189, 248, 0.35);
        }

        .logo-text {
            font-size: 1.4rem;
            font-weight: 800;
            background: linear-gradient(to right, var(--cyan), var(--indigo));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        /* ─── Step Indicator ────────────────────────────────── */
        .steps-wrapper {
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 36px;
            gap: 0;
        }

        .step-node {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 8px;
            position: relative;
        }

        .step-circle {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.06);
            border: 2px solid rgba(255, 255, 255, 0.15);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.8rem;
            font-weight: 700;
            color: var(--text-muted);
            transition: all 0.4s ease;
        }

        .step-circle.active {
            background: linear-gradient(135deg, var(--cyan), var(--indigo));
            border-color: transparent;
            color: #fff;
            box-shadow: 0 0 20px rgba(56, 189, 248, 0.5);
        }

        .step-circle.done {
            background: linear-gradient(135deg, var(--teal), var(--cyan));
            border-color: transparent;
            color: #fff;
        }

        .step-label {
            font-size: 0.67rem;
            font-weight: 600;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.05em;
            transition: color 0.4s;
        }

        .step-node.active .step-label,
        .step-node.done .step-label {
            color: var(--cyan);
        }

        .step-line {
            flex: 1;
            height: 2px;
            background: rgba(255, 255, 255, 0.1);
            margin: 0 8px;
            margin-bottom: 22px;
            max-width: 60px;
            transition: background 0.4s;
        }

        .step-line.done {
            background: linear-gradient(to right, var(--teal), var(--cyan));
        }

        /* ─── Typography ────────────────────────────────────── */
        h1 {
            font-size: 1.9rem;
            font-weight: 800;
            margin-bottom: 10px;
            background: linear-gradient(to right, #fff, rgba(255, 255, 255, 0.7));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            line-height: 1.2;
        }

        .subtitle {
            color: var(--text-muted);
            font-size: 0.9rem;
            line-height: 1.6;
            margin-bottom: 32px;
        }

        .subtitle strong {
            color: rgba(255, 255, 255, 0.85);
        }

        /* ─── Role Selector ─────────────────────────────────── */
        .role-selector {
            display: flex;
            gap: 10px;
            margin-bottom: 24px;
        }

        .role-btn {
            flex: 1;
            padding: 12px 16px;
            background: rgba(255, 255, 255, 0.04);
            border: 1.5px solid rgba(255, 255, 255, 0.1);
            border-radius: 12px;
            color: var(--text-muted);
            font-size: 0.85rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.25s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 7px;
        }

        .role-btn:hover {
            border-color: rgba(56, 189, 248, 0.4);
            color: #fff;
        }

        .role-btn.active {
            background: rgba(56, 189, 248, 0.15);
            border-color: var(--cyan);
            color: var(--cyan);
            box-shadow: 0 0 12px rgba(56, 189, 248, 0.2);
        }

        /* ─── Form Fields ───────────────────────────────────── */
        .form-group {
            margin-bottom: 20px;
        }

        label {
            display: block;
            margin-bottom: 8px;
            font-size: 0.82rem;
            font-weight: 600;
            color: rgba(255, 255, 255, 0.75);
            letter-spacing: 0.02em;
        }

        .input-wrapper {
            position: relative;
        }

        .input-wrapper i.icon-prefix {
            position: absolute;
            left: 16px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-muted);
            font-size: 0.9rem;
            pointer-events: none;
        }

        .input-wrapper .icon-toggle {
            position: absolute;
            right: 16px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-muted);
            font-size: 1.2rem;
            cursor: pointer;
            transition: color 0.2s;
            z-index: 2;
        }

        .input-wrapper .icon-toggle:hover {
            color: var(--cyan);
        }

        input[type="email"],
        input[type="text"],
        input[type="password"] {
            width: 100%;
            padding: 14px 16px 14px 44px;
            background: rgba(255, 255, 255, 0.07);
            border: 1.5px solid rgba(255, 255, 255, 0.1);
            border-radius: 14px;
            color: #fff;
            font-size: 0.95rem;
            font-family: 'Montserrat', sans-serif;
            transition: all 0.3s ease;
            position: relative;
            z-index: 1;
        }

        /* Hide native browser password reveal icons */
        input[type="password"]::-ms-reveal,
        input[type="password"]::-ms-clear,
        input[type="password"]::-webkit-reveal {
            display: none !important;
        }

        /* Fix browser autofill changing background to white */
        input:-webkit-autofill,
        input:-webkit-autofill:hover, 
        input:-webkit-autofill:focus, 
        input:-webkit-autofill:active {
            transition: background-color 5000s ease-in-out 0s;
            -webkit-text-fill-color: #fff !important;
        }

        input[type="email"]:focus,
        input[type="text"]:focus,
        input[type="password"]:focus {
            outline: none;
            border-color: var(--cyan);
            background: rgba(255, 255, 255, 0.10);
            box-shadow: 0 0 0 3px rgba(56, 189, 248, 0.12);
        }

        input::placeholder {
            color: rgba(255, 255, 255, 0.3);
        }

        /* ─── OTP Grid ──────────────────────────────────────── */
        .otp-grid {
            display: flex;
            gap: 10px;
            justify-content: center;
            margin-bottom: 28px;
        }

        .otp-box {
            width: 45px;
            height: 55px;
            font-size: 1.8rem;
            font-weight: 900;
            text-align: center;
            padding: 0 !important;
            background: #ffffff !important;
            border: 3px solid var(--otp-border) !important;
            border-radius: 8px;
            color: #000000 !important;
            outline: none;
            margin: 0 4px;
        }

        .otp-box:focus {
            box-shadow: 0 0 15px var(--otp-glow);
            transform: scale(1.1);
        }

        /* ─── Timer ─────────────────────────────────────────── */
        .otp-timer {
            text-align: center;
            font-size: 0.82rem;
            color: var(--text-muted);
            margin-bottom: 20px;
        }

        .otp-timer #countdown {
            color: var(--cyan);
            font-weight: 700;
        }

        .otp-timer .resend-link {
            color: var(--cyan);
            cursor: pointer;
            font-weight: 600;
            text-decoration: underline;
            display: none;
        }

        .otp-timer .resend-link.visible {
            display: inline;
        }

        /* ─── Password Strength ─────────────────────────────── */
        .strength-bar {
            height: 4px;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 4px;
            overflow: hidden;
            margin-top: 8px;
        }

        .strength-fill {
            height: 100%;
            width: 0%;
            border-radius: 4px;
            transition: all 0.4s ease;
        }

        .strength-text {
            font-size: 0.72rem;
            margin-top: 5px;
            font-weight: 600;
            transition: color 0.3s;
        }

        /* ─── Button ────────────────────────────────────────── */
        .btn-primary {
            width: 100%;
            padding: 16px;
            background: var(--btn-gradient);
            border: none;
            border-radius: 14px;
            color: #fff;
            font-weight: 700;
            font-size: 1rem;
            font-family: 'Montserrat', sans-serif;
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            margin-top: 8px;
            position: relative;
            overflow: hidden;
        }

        .btn-primary::after {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(135deg, rgba(255, 255, 255, 0.15), transparent);
            opacity: 0;
            transition: opacity 0.3s;
        }

        .btn-primary:hover {
            transform: translateY(-3px);
            box-shadow: 0 14px 28px var(--btn-shadow);
        }

        .btn-primary:hover::after {
            opacity: 1;
        }

        .btn-primary:active {
            transform: translateY(-1px);
        }

        .btn-primary.loading {
            pointer-events: none;
            opacity: 0.75;
        }

        .btn-primary .spinner {
            width: 18px;
            height: 18px;
            border: 2px solid rgba(255, 255, 255, 0.3);
            border-top-color: #fff;
            border-radius: 50%;
            animation: spin 0.7s linear infinite;
            display: none;
        }

        .btn-primary.loading .spinner {
            display: block;
        }

        .btn-primary.loading .btn-text {
            display: none;
        }

        @keyframes spin {
            to {
                transform: rotate(360deg);
            }
        }

        /* ─── Info banners ──────────────────────────────────── */
        .info-box {
            padding: 14px 18px;
            border-radius: 12px;
            font-size: 0.85rem;
            margin-bottom: 22px;
            display: flex;
            align-items: flex-start;
            gap: 12px;
            line-height: 1.5;
        }

        .info-box i {
            margin-top: 1px;
            flex-shrink: 0;
        }

        .info-box.blue {
            background: rgba(56, 189, 248, 0.1);
            border: 1px solid rgba(56, 189, 248, 0.25);
            color: #7dd3fc;
        }

        .info-box.green {
            background: rgba(45, 212, 191, 0.1);
            border: 1px solid rgba(45, 212, 191, 0.25);
            color: #5eead4;
        }

        .info-box.amber {
            background: rgba(251, 191, 36, 0.1);
            border: 1px solid rgba(251, 191, 36, 0.25);
            color: #fcd34d;
        }

        /* ─── Back Link ─────────────────────────────────────── */
        .back-link {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            margin-top: 26px;
            color: var(--text-muted);
            text-decoration: none;
            font-size: 0.85rem;
            transition: color 0.25s;
        }

        .back-link:hover {
            color: var(--cyan);
        }

        /* ─── Success Icon ──────────────────────────────────── */
        .success-icon {
            width: 70px;
            height: 70px;
            margin: 0 auto 20px;
            background: linear-gradient(135deg, var(--teal), var(--cyan));
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2rem;
            box-shadow: 0 0 30px rgba(56, 189, 248, 0.4);
            animation: pop-in 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275) both;
        }

        @keyframes pop-in {
            from {
                transform: scale(0) rotate(-25deg);
                opacity: 0;
            }

            to {
                transform: scale(1) rotate(0deg);
                opacity: 1;
            }
        }

        /* ─── Email display chip ────────────────────────────── */
        .email-chip {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: rgba(56, 189, 248, 0.12);
            border: 1px solid rgba(56, 189, 248, 0.25);
            color: var(--cyan);
            padding: 8px 16px;
            border-radius: 50px;
            font-size: 0.85rem;
            font-weight: 600;
            margin-bottom: 24px;
        }
        .theme-toggle-floating {
            position: fixed;
            bottom: 30px;
            right: 30px;
            z-index: 1000;
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.2);
            color: white;
            width: 50px;
            height: 50px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            box-shadow: 0 10px 25px rgba(0,0,0,0.3);
            transition: all 0.3s ease;
        }
        .theme-toggle-floating:hover {
            transform: scale(1.1);
            background: rgba(255, 255, 255, 0.2);
        }
    </style>
    <%- include('../partials/theme-logic') %>
</head>

<body>

    <!-- Aurora Background -->
    <div class="bg-aurora">
        <div class="aurora-blob blob-1"></div>
        <div class="aurora-blob blob-2"></div>
        <div class="aurora-blob blob-3"></div>
    </div>

    <button onclick="toggleTheme()" class="theme-toggle-floating" title="Switch Theme">
        <i class="fas fa-paint-brush"></i>
    </button>

    <div class="glass-card">

        <!-- Logo -->
        <a href="/" class="logo" style="text-decoration:none;">
            <span class="logo-text">FitConnect</span>
        </a>

        <!-- Step Indicator -->
        <div class="steps-wrapper">
            <div class="step-node <%= (typeof step === 'undefined' || step === 1) ? 'active' : 'done' %>">
                <div class="step-circle <%= (typeof step === 'undefined' || step === 1) ? 'active' : 'done' %>">
                    <% if (typeof step !== 'undefined' && step > 1) { %>✓<% } else { %>1<% } %>
                </div>
                <span class="step-label">Email</span>
            </div>
            <div class="step-line <%= (typeof step !== 'undefined' && step >= 2) ? 'done' : '' %>"></div>
            <div
                class="step-node <%= (typeof step !== 'undefined' && step === 2) ? 'active' : (typeof step !== 'undefined' && step > 2 ? 'done' : '') %>">
                <div
                    class="step-circle <%= (typeof step !== 'undefined' && step === 2) ? 'active' : (typeof step !== 'undefined' && step > 2 ? 'done' : '') %>">
                    <% if (typeof step !== 'undefined' && step > 2) { %>✓<% } else { %>2<% } %>
                </div>
                <span class="step-label">Verify OTP</span>
            </div>
            <div class="step-line <%= (typeof step !== 'undefined' && step === 3) ? 'done' : '' %>"></div>
            <div class="step-node <%= (typeof step !== 'undefined' && step === 3) ? 'active' : '' %>">
                <div class="step-circle <%= (typeof step !== 'undefined' && step === 3) ? 'active' : '' %>">3</div>
                <span class="step-label">New Password</span>
            </div>
        </div>

        <!-- ═══════════════════════ STEP 1: Email ═══════════════════════ -->
        <% if (typeof step==='undefined' || step===1) { %>

            <h1>Forgot Password?</h1>
            <p class="subtitle">No worries! Enter your registered email and we'll send you a 6-digit OTP to reset it.
            </p>

            <form action="/forgot-password" method="POST" id="emailForm">
                <input type="hidden" name="role" id="selectedRole"
                    value="<%= typeof role !== 'undefined' ? role : 'user' %>">

                <div class="form-group">
                    <label for="email">Email Address</label>
                    <div class="input-wrapper">
                        <input type="email" id="email" name="email" placeholder="your@email.com"
                            style="padding-left: 18px; padding-right: 18px;" required autocomplete="email">
                    </div>
                </div>

                <button type="submit" class="btn-primary" id="sendOtpBtn">
                    <div class="spinner"></div>
                    <span class="btn-text">Send OTP Code</span>
                </button>
            </form>

            <div style="text-align:center;">
                <a href="<%= (typeof role !== 'undefined' && role === 'trainer') ? '/trainer/login' : '/user-login' %>"
                    class="back-link">Back to Login</a>
            </div>

            <!-- ═══════════════════════ STEP 2: OTP ═══════════════════════ -->
            <% } else if (step===2) { %>

                <h1>Enter OTP Code</h1>
                <p class="subtitle">We've sent a 6-digit verification code to:</p>
                <div style="text-align:center;">
                    <span class="email-chip">
                        <%= email %>
                    </span>
                </div>

                <div class="info-box blue">
                    <div>Check your inbox (and spam folder). The code expires in <strong>10 minutes</strong>.</div>
                </div>

                <% if (typeof emailError !=='undefined' && emailError) { %>
                    <div class="info-box amber">
                        <div>
                            <strong>System Note:</strong> We couldn't send the email (check SMTP settings).
                            <br>Since you're in development, check your <strong>terminal console</strong> for the code.
                        </div>
                    </div>
                    <% } %>

                        <form id="verifyForm" action="/verify-otp" method="POST">
                            <input type="hidden" name="email" value="<%= email %>">
                            <input type="hidden" name="role" value="<%= typeof role !== 'undefined' ? role : 'user' %>">
                            <input type="hidden" name="otp" id="fullOtp">

                            <div class="otp-grid">
                                <input type="text" class="otp-box" maxlength="1" inputmode="numeric" pattern="\d"
                                    autocomplete="one-time-code" required>
                                <input type="text" class="otp-box" maxlength="1" inputmode="numeric" pattern="\d"
                                    required>
                                <input type="text" class="otp-box" maxlength="1" inputmode="numeric" pattern="\d"
                                    required>
                                <input type="text" class="otp-box" maxlength="1" inputmode="numeric" pattern="\d"
                                    required>
                                <input type="text" class="otp-box" maxlength="1" inputmode="numeric" pattern="\d"
                                    required>
                                <input type="text" class="otp-box" maxlength="1" inputmode="numeric" pattern="\d"
                                    required>
                            </div>

                            <div class="otp-timer">
                                Code expires in <span id="countdown">10:00</span>
                                &nbsp;|&nbsp;
                                <span class="resend-link" id="resendLink" onclick="resendOtp()">Resend Code</span>
                            </div>

                            <button type="submit" class="btn-primary" id="verifyBtn">
                                <div class="spinner"></div>
                                <span class="btn-text">Verify & Continue</span>
                            </button>
                        </form>

                        <div style="text-align:center;">
                            <a href="/forgot-password?role=<%= typeof role !== 'undefined' ? role : 'user' %>"
                                class="back-link">Change Email</a>
                        </div>

                        <!-- ═══════════════════════ STEP 3: New Password ═══════════════════════ -->
                        <% } else if (step===3) { %>

                            <h1>Set New Password</h1>
                            <p class="subtitle">Identity verified! Choose a strong, unique password for your account.
                            </p>

                            <form action="/reset-password" method="POST" id="resetForm">
                                <div class="form-group">
                                    <label for="password">New Password</label>
                                    <div class="input-wrapper">
                                        <input type="password" id="password" name="password"
                                            placeholder="Min. 8 characters"
                                            style="padding-left: 18px; padding-right: 46px;" required
                                            oninput="checkStrength(this.value)">
                                        <span class="icon-toggle" onclick="togglePass('password', this)" style="display: flex; align-items: center; justify-content: center; user-select: none;" title="Toggle Password">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                                        </span>
                                    </div>
                                    <div class="strength-bar">
                                        <div class="strength-fill" id="strengthFill"></div>
                                    </div>
                                    <div class="strength-text" id="strengthText" style="color: var(--text-muted);">Enter
                                        a password</div>
                                </div>

                                <div class="form-group">
                                    <label for="confirmPassword">Confirm Password</label>
                                    <div class="input-wrapper">
                                        <input type="password" id="confirmPassword" name="confirmPassword"
                                            placeholder="Re-enter password"
                                            style="padding-left: 18px; padding-right: 46px;" required
                                            oninput="checkMatch()">
                                        <span class="icon-toggle" onclick="togglePass('confirmPassword', this)" style="display: flex; align-items: center; justify-content: center; user-select: none;" title="Toggle Password">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                                        </span>
                                    </div>
                                    <div class="strength-text" id="matchText" style="color: var(--text-muted);"></div>
                                </div>

                                <button type="submit" class="btn-primary" id="resetBtn">
                                    <div class="spinner"></div>
                                    <span class="btn-text">Update Password</span>
                                </button>
                            </form>

                            <% } %>

    </div>

    <script>
        /* ── Role Toggle ───────────────────────────────────────── */
        function setRole(role) {
            document.getElementById('selectedRole').value = role;
            document.getElementById('roleUser').classList.toggle('active', role === 'user');
            document.getElementById('roleTrainer').classList.toggle('active', role === 'trainer');
        }

        /* ── Form Loading State ────────────────────────────────── */
        function addLoadingState(formId, btnId) {
            const form = document.getElementById(formId);
            const btn = document.getElementById(btnId);
            if (form && btn) {
                form.addEventListener('submit', () => {
                    btn.classList.add('loading');
                });
            }
        }
        addLoadingState('emailForm', 'sendOtpBtn');
        addLoadingState('verifyForm', 'verifyBtn');
        addLoadingState('resetForm', 'resetBtn');

        /* ── OTP Inputs ────────────────────────────────────────── */
        const otpBoxes = document.querySelectorAll('.otp-box');
        if (otpBoxes.length > 0) {
            otpBoxes[0].focus();

            otpBoxes.forEach((box, i) => {
                box.addEventListener('input', (e) => {
                    const val = e.target.value.replace(/\D/g, '');
                    e.target.value = val ? val[0] : '';
                    e.target.classList.toggle('filled', !!val);
                    if (val && i < otpBoxes.length - 1) otpBoxes[i + 1].focus();
                });

                box.addEventListener('keydown', (e) => {
                    if (e.key === 'Backspace' && !e.target.value && i > 0) {
                        otpBoxes[i - 1].focus();
                        otpBoxes[i - 1].value = '';
                        otpBoxes[i - 1].classList.remove('filled');
                    }
                    // Allow only digits, arrows, backspace, tab
                    if (!/^\d$/.test(e.key) && !['Backspace', 'ArrowLeft', 'ArrowRight', 'Tab', 'Delete'].includes(e.key)) {
                        e.preventDefault();
                    }
                });

                box.addEventListener('paste', (e) => {
                    e.preventDefault();
                    const paste = (e.clipboardData || window.clipboardData).getData('text').replace(/\D/g, '');
                    paste.split('').forEach((ch, idx) => {
                        if (otpBoxes[idx]) {
                            otpBoxes[idx].value = ch;
                            otpBoxes[idx].classList.add('filled');
                        }
                    });
                    const nextEmpty = [...otpBoxes].findIndex(b => !b.value);
                    if (nextEmpty !== -1) otpBoxes[nextEmpty].focus();
                    else otpBoxes[otpBoxes.length - 1].focus();
                });
            });

            const verifyForm = document.getElementById('verifyForm');
            if (verifyForm) {
                verifyForm.addEventListener('submit', (e) => {
                    const otp = [...otpBoxes].map(b => b.value).join('');
                    if (otp.length < 6) {
                        e.preventDefault();
                        otpBoxes[0].focus();
                        return;
                    }
                    document.getElementById('fullOtp').value = otp;
                });
            }

            /* ── Countdown Timer ─────────────── */
            let seconds = 600;
            const countdownEl = document.getElementById('countdown');
            const resendLink = document.getElementById('resendLink');
            const timerInterval = setInterval(() => {
                seconds--;
                const m = String(Math.floor(seconds / 60)).padStart(2, '0');
                const s = String(seconds % 60).padStart(2, '0');
                if (countdownEl) countdownEl.textContent = `${m}:${s}`;
                if (seconds <= 0) {
                    clearInterval(timerInterval);
                    if (countdownEl) countdownEl.textContent = 'Expired';
                    if (resendLink) resendLink.classList.add('visible');
                }
            }, 1000);
        }

        function resendOtp() {
            window.location.href = '/forgot-password?role=<%= typeof role !== "undefined" ? role : "user" %>';
        }

        /* ── Password Toggle ────────────────────────────────────── */
        const eyeSvg = `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>`;
        const eyeOffSvg = `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path><line x1="1" y1="1" x2="23" y2="23"></line></svg>`;

        function togglePass(id, btn) {
            const input = document.getElementById(id);
            const isText = input.type === 'text';
            input.type = isText ? 'password' : 'text';
            btn.innerHTML = isText ? eyeSvg : eyeOffSvg;
        }

        /* ── Password Strength ──────────────────────────────────── */
        function checkStrength(val) {
            const fill = document.getElementById('strengthFill');
            const text = document.getElementById('strengthText');
            if (!fill) return;
            let score = 0;
            if (val.length >= 8) score++;
            if (/[A-Z]/.test(val)) score++;
            if (/[0-9]/.test(val)) score++;
            if (/[^A-Za-z0-9]/.test(val)) score++;

            const levels = [
                { pct: '0%', color: 'transparent', label: 'Enter a password', clr: 'var(--text-muted)' },
                { pct: '25%', color: '#ef4444', label: 'Weak', clr: '#ef4444' },
                { pct: '50%', color: '#f59e0b', label: 'Fair', clr: '#f59e0b' },
                { pct: '75%', color: '#38bdf8', label: 'Good', clr: '#38bdf8' },
                { pct: '100%', color: '#10b981', label: 'Strong 💪', clr: '#10b981' },
            ];
            const lv = levels[score];
            fill.style.width = lv.pct;
            fill.style.background = lv.color;
            text.textContent = lv.label;
            text.style.color = lv.clr;
        }

        function checkMatch() {
            const pw = document.getElementById('password')?.value;
            const cpw = document.getElementById('confirmPassword')?.value;
            const mt = document.getElementById('matchText');
            if (!mt) return;
            if (!cpw) { mt.textContent = ''; return; }
            if (pw === cpw) {
                mt.textContent = '✓ Passwords match';
                mt.style.color = '#10b981';
            } else {
                mt.textContent = '✗ Passwords do not match';
                mt.style.color = '#ef4444';
            }
        }

        /* ── Floating Particles ─────────────────────────────────── */
        const isTrainer = document.documentElement.style.getPropertyValue('--otp-border').trim() !== ''
            ? false
            : (getComputedStyle(document.documentElement).getPropertyValue('--otp-border').trim() === '#10b981');
        const role = '<%= typeof role !== "undefined" ? role : "user" %>';
        const colors = role === 'trainer'
            ? ['rgba(16,185,129,0.6)', 'rgba(52,211,153,0.6)', 'rgba(5,150,105,0.5)', 'rgba(110,231,183,0.5)']
            : ['rgba(56,189,248,0.6)', 'rgba(129,140,248,0.6)', 'rgba(192,132,252,0.5)', 'rgba(45,212,191,0.5)'];
        for (let i = 0; i < 18; i++) {
            const p = document.createElement('div');
            p.className = 'particle';
            const size = Math.random() * 5 + 3;
            p.style.cssText = `
                width:${size}px; height:${size}px;
                left:${Math.random() * 100}%;
                bottom:-20px;
                background:${colors[Math.floor(Math.random() * colors.length)]};
                animation-duration:${Math.random() * 15 + 12}s;
                animation-delay:${Math.random() * -20}s;
                filter: blur(1px);
            `;
            document.querySelector('.bg-aurora').appendChild(p);
        }
    </script>
</body>

</html>