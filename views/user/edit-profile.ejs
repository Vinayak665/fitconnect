<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Profile - FitConnect</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css?v=2">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <%- include('../partials/theme-logic') %>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700&display=swap');
        
        *{ font-family: 'Montserrat', sans-serif; }
        
        body { 
            background-color: #0f172a; /* Slate 900 */
            color: #f8fafc; /* Slate 50 */
            min-height: 100vh;
            overflow-x: hidden;
        }

        /* Solid Professional SaaS Panels */
        .glass-panel {
            background: #1e293b !important; /* Slate 800 */
            border: 1px solid #334155 !important; /* Slate 700 */
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06) !important;
            color: #f8fafc !important;
        }
        
        .glass-panel-content {
            background: #0f172a !important; /* Slate 900 for inner content */
            border: 1px solid #334155 !important;
            color: #f8fafc !important;
            box-shadow: inset 0 2px 4px 0 rgba(0, 0, 0, 0.05) !important;
        }

        /* Sidebar & Topbar */
        .sidebar { 
            min-height: 100vh; 
            border-right: 1px solid #334155;
            background: #0f172a !important;
        }
        .sidebar a { color: #cbd5e1; text-decoration: none; padding: 15px 20px; display: block; border-left: 3px solid transparent; transition: 0.2s; font-weight: 500; }
        .sidebar a:hover, .sidebar a.active { background: #1e293b; color: #38bdf8; border-left-color: #0ea5e9; }
        
        .topbar { 
            background: #0f172a !important; 
            border-bottom: 1px solid #334155;
        }
        
        .navbar-brand, .fitconnect-brand { color: #f8fafc !important; font-weight: 700; letter-spacing: -0.5px; }
        
        /* Form inputs for profile */
        .form-label { color: #cbd5e1; }
        .form-control { background: #0f172a !important; border: 1px solid #334155 !important; color: #f8fafc !important; }
        .form-control:focus { background: #1e293b !important; border-color: #0ea5e9 !important; box-shadow: 0 0 0 0.25rem rgba(14, 165, 233, 0.25) !important; }

        /* Text color overrides */
        .text-dark, .text-gray-800 { color: #f8fafc !important; }
        .text-muted { color: #94a3b8 !important; }
        
        .btn-modern { background: #0ea5e9; border: none; color: white; transition: 0.2s; font-weight: 600; }
        .btn-modern:hover { background: #0284c7; transform: translateY(-1px); box-shadow: 0 4px 6px -1px rgba(14, 165, 233, 0.4); color: white; }

        .dropdown-menu { background: #1e293b; border: 1px solid #334155; box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1); }
        .dropdown-item { color: #cbd5e1; }
        .dropdown-item:hover { background: #334155; color: #f8fafc; }
        .dropdown-divider { border-color: #334155; }
    </style>
</head>
<body>
    <!-- Content Starts Here -->

    <div class="container-fluid p-0">
        <div class="row g-0 flex-nowrap">
            <!-- Sidebar (Glassmorphism) -->
            <div class="col-auto col-md-3 col-xl-2 px-sm-2 px-0 sidebar d-none d-lg-block">
                <div class="d-flex flex-column align-items-center align-items-sm-start px-3 pt-4 text-white w-100">
                    <a href="/" class="d-flex align-items-center pb-3 mb-4 w-100 text-white text-decoration-none border-bottom" style="border-color: rgba(255,255,255,0.1) !important;">
                        <i class="fas fa-dumbbell me-2 fitconnect-brand"></i>
                        <span class="fs-5 fw-bold d-none d-sm-inline fitconnect-brand">FitConnect</span>
                    </a>
                    <div class="mb-2 px-3 text-uppercase small fw-bold" style="opacity: 0.5; color: #fff;">Menu</div>
                    <ul class="nav nav-pills flex-column mb-sm-auto mb-0 align-items-center align-items-sm-start w-100">
                        <li class="nav-item w-100"><a href="/dashboard"><i class="fas fa-home me-2"></i> <span class="d-none d-sm-inline">Dashboard</span></a></li>
                        <li class="nav-item w-100"><a href="/dashboard?section=chats"><i class="fas fa-comments me-2"></i> <span class="d-none d-sm-inline">Messages</span></a></li>
                        <li class="nav-item w-100"><a href="/search"><i class="fas fa-search me-2"></i> <span class="d-none d-sm-inline">Find Trainers</span></a></li>
                        <li class="nav-item w-100"><a href="/edit-profile" class="active"><i class="fas fa-user-edit me-2"></i> <span class="d-none d-sm-inline">Edit Profile</span></a></li>
                    </ul>
                    <hr class="w-100 mt-5 mb-3" style="border-color: rgba(255,255,255,0.1);">
                    <div class="mb-2 px-3 text-uppercase small fw-bold" style="opacity: 0.5; color: #fff;">Account</div>
                    <a href="/user/logout" class="w-100"><i class="fas fa-sign-out-alt me-2 text-danger"></i> <span class="d-none d-sm-inline">Logout</span></a>
                </div>
            </div>

            <!-- Main Content -->
            <div class="col py-0 px-0" style="height: 100vh; overflow-y: auto; overflow-x: hidden;">
                <!-- Topbar (Glassmorphism) -->
                <nav class="navbar navbar-expand-lg topbar px-4 py-3 align-items-center sticky-top">
                    <span class="d-lg-none fw-bold ms-2 fitconnect-brand fs-4">FitConnect</span>
                    
                    <div class="ms-auto d-flex align-items-center">
                        <button onclick="toggleTheme()" class="btn btn-sm d-flex align-items-center gap-2 me-3 theme-toggle-btn" 
                                style="background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); color: inherit; padding: 6px 12px; border-radius: 20px;">
                            <i class="fas fa-paint-brush"></i>
                        </button>
                        <div class="dropdown">
                            <button class="btn dropdown-toggle border-0 fw-bold text-white d-flex align-items-center glass-panel rounded-pill py-2 px-3" type="button" data-bs-toggle="dropdown" style="background: rgba(255,255,255,0.1) !important;">
                                <img src="<%= user.profile_image ? (user.profile_image.startsWith('http') ? user.profile_image : '/uploads/' + user.profile_image) : 'https://cdn-icons-png.flaticon.com/512/3135/3135715.png' %>" class="rounded-circle me-2 border border-2 border-primary" width="32" style="height: 32px; object-fit: cover;">
                                <%= user.name %>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2 rounded-3">
                                <li><a class="dropdown-item py-2" href="/edit-profile"><i class="fas fa-user fa-sm me-3 opacity-75"></i> Profile</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item py-2 text-danger" href="/user/logout"><i class="fas fa-sign-out-alt fa-sm me-3 opacity-75"></i> Logout</a></li>
                            </ul>
                        </div>
                    </div>
                </nav>

                <div class="p-4 p-md-5">
                    <div class="d-sm-flex align-items-center justify-content-between mb-5">
                        <h1 class="h2 mb-0 text-white fw-bold" style="letter-spacing: -0.5px;">Account Settings</h1>
                    </div>

                    <div class="row justify-content-center">
                        <div class="col-lg-8">
                            <div class="card glass-panel border-0 rounded-4 p-4 p-md-5">
                                <form action="/edit-profile" method="POST" enctype="multipart/form-data">
                                    <div class="mb-5 p-4 rounded-4 glass-panel-content border-0 shadow-sm text-center">
                                        <div class="position-relative d-inline-block mx-auto mb-3">
                                            <div class="position-absolute w-100 h-100 rounded-circle bg-primary opacity-25" style="filter: blur(15px); transform: scale(1.1);"></div>
                                            <img src="<%= user.profile_image ? (user.profile_image.startsWith('http') ? user.profile_image : '/uploads/' + user.profile_image) : 'https://cdn-icons-png.flaticon.com/512/3135/3135715.png' %>" class="position-relative rounded-circle shadow-sm border border-2 border-white border-opacity-25" style="width: 130px; height: 130px; object-fit: cover; z-index: 2;">
                                        </div>
                                        <h4 class="fw-bold text-white mb-1"><%= user.name %></h4>
                                        <p class="text-muted small mb-0"><i class="fas fa-envelope me-2 opacity-75"></i><%= user.email %></p>
                                    </div>
                                    
                                    <div class="row g-4">
                                        <div class="col-md-12">
                                            <label class="form-label text-uppercase small fw-bold opacity-75 ms-1">Profile Image</label>
                                            <input type="file" name="profile_image" class="form-control form-control-lg rounded-3 border-opacity-25 py-3 shadow-sm" accept="image/*">
                                        </div>
                                        <div class="col-md-12">
                                            <label class="form-label text-uppercase small fw-bold opacity-75 ms-1">Full Name</label>
                                            <input type="text" name="name" class="form-control form-control-lg rounded-3 border-opacity-25 py-3 shadow-sm" value="<%= user.name %>" required>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label text-uppercase small fw-bold opacity-75 ms-1">Phone Number</label>
                                            <input type="text" name="phone" class="form-control form-control-lg rounded-3 border-opacity-25 py-3 shadow-sm" value="<%= user.phone %>">
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label text-uppercase small fw-bold opacity-75 ms-1">City</label>
                                            <input type="text" name="city" class="form-control form-control-lg rounded-3 border-opacity-25 py-3 shadow-sm" value="<%= user.city %>">
                                        </div>
                                    </div>
                                    
                                    <hr class="my-5 border-secondary border-opacity-50">
                                    
                                    <div class="d-grid gap-3 d-md-flex justify-content-md-end">
                                        <a href="/dashboard" class="btn btn-outline-light px-5 rounded-pill fw-medium py-3">Cancel</a>
                                        <button type="submit" class="btn btn-modern px-5 rounded-pill shadow fs-6 fw-bold text-white py-3"><i class="fas fa-save me-2"></i> Save Changes</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <script>
        // Removed falling icons for professional dashboard
    </script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
