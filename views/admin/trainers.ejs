<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manage Trainers - Admin Console</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <%- include('../partials/theme-logic') %>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700&display=swap');
        
        *{ font-family: 'Montserrat', sans-serif; }

        body { 
            background-color: #2a0404; /* Dark red abstract base */
            color: #fff;
            min-height: 100vh;
            overflow-x: hidden;
            position: relative;
        }

        /* Aesthetic Red Aurora Background */
        .bg-aurora {
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            z-index: -1;
            background: #2a0404;
            overflow: hidden;
        }

        .aurora-blob {
            position: absolute;
            filter: blur(100px);
            opacity: 0.6;
            animation: float-blob 20s infinite alternate ease-in-out;
        }

        .blob-1 { top: -10%; left: -10%; width: 50vw; height: 50vh; background: #dc2626; animation-delay: 0s; }
        .blob-2 { top: 40%; right: -20%; width: 60vw; height: 60vh; background: #ef4444; animation-delay: -5s; }
        .blob-3 { bottom: -20%; left: 20%; width: 40vw; height: 50vh; background: #b91c1c; animation-delay: -10s; }

        @keyframes float-blob {
            0% { transform: scale(1) translate(0, 0) rotate(0deg); }
            50% { transform: scale(1.1) translate(5%, 5%) rotate(5deg); }
            100% { transform: scale(0.9) translate(-5%, -5%) rotate(-5deg); }
        }

        /* Animated Security Icons Floating */
        .falling-container {
            position: fixed;
            top: -100px; left: 0; width: 100%; height: calc(100% + 200px);
            overflow: hidden; z-index: -1; pointer-events: none;
        }

        .sec-icon {
            position: absolute; color: rgba(255, 255, 255, 0.05); animation: fall linear infinite;
        }

        @keyframes fall {
            0% { transform: translateY(0) rotate(0deg); opacity: 0; }
            10% { opacity: 1; }
            80% { opacity: 1; }
            100% { transform: translateY(110vh) rotate(360deg); opacity: 0; }
        }

        /* Glassmorphism Configuration */
        .glass-panel {
            background: rgba(255, 255, 255, 0.05) !important;
            backdrop-filter: blur(15px);
            -webkit-backdrop-filter: blur(15px);
            border: 1px solid rgba(255, 255, 255, 0.1) !important;
            box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.3) !important;
            color: #fff !important;
        }

        .glass-panel-content {
            background: rgba(255, 255, 255, 0.03) !important;
            border: 1px solid rgba(255, 255, 255, 0.08) !important;
            color: #fff !important;
        }

        /* Override existing styles for dark mode compatibility */
        .sidebar { 
            min-height: 100vh; 
            border-right: 1px solid rgba(255,255,255,0.1);
            background: rgba(0, 0, 0, 0.4) !important;
            backdrop-filter: blur(20px);
        }
        .sidebar .nav-link { color: rgba(255,255,255,0.7); padding: 15px 20px; font-weight: 500; transition: 0.3s; border-left: 4px solid transparent; }
        .sidebar .nav-link:hover, .sidebar .nav-link.active { background: rgba(220, 38, 38, 0.15); color: #fff; border-left-color: #dc2626; } /* Crimson red hover */
        
        .topbar { 
            background: rgba(0, 0, 0, 0.2) !important; 
            backdrop-filter: blur(20px);
            border-bottom: 1px solid rgba(255,255,255,0.1);
        }
        
        .navbar-brand, .fitconnect-brand { color: #fff !important; -webkit-text-fill-color: #fff !important; background: none !important; text-shadow: 0 0 10px rgba(255,255,255,0.3); }

        /* Typography */
        .text-dark, .text-gray-800 { color: #fff !important; }
        .text-muted { color: rgba(255,255,255,0.6) !important; }
        
        /* Table overrides */
        .table { color: #fff; }
        .table-hover tbody tr:hover { background-color: rgba(255,255,255,0.05); color: #fff; }
        .table > :not(caption) > * > * { border-bottom-color: rgba(255,255,255,0.1); background-color: transparent !important; color: #fff; }
        .table thead th { border-bottom: 2px solid rgba(255,255,255,0.2) !important; color: rgba(255,255,255,0.8); font-weight: 600; text-transform: uppercase; font-size: 0.85rem; letter-spacing: 1px;}
        
        .btn-modern { background: linear-gradient(135deg, #ef4444 0%, #b91c1c 100%); border: none; color: white; transition: 0.3s; }
        .btn-modern:hover { transform: translateY(-2px); box-shadow: 0 10px 20px rgba(220, 38, 38, 0.4); color: white; }
    </style>
</head>
<body>
    <!-- Background Elements -->
    <div class="bg-aurora">
        <div class="aurora-blob blob-1"></div>
        <div class="aurora-blob blob-2"></div>
        <div class="aurora-blob blob-3"></div>
    </div>
    <div class="falling-container" id="fallingContainer"></div>

    <div class="container-fluid p-0">
        <div class="row g-0 flex-nowrap">
            <!-- Sidebar -->
            <div class="col-auto col-md-3 col-xl-2 px-sm-2 px-0 sidebar d-none d-md-block">
                <div class="d-flex flex-column align-items-center align-items-sm-start px-3 pt-4 text-white w-100">
                    <a href="/" class="d-flex align-items-center pb-3 mb-4 w-100 text-white text-decoration-none border-bottom" style="border-color: rgba(255,255,255,0.1) !important;">
                        <i class="fas fa-shield-alt fa-2x me-2 fitconnect-brand"></i>
                        <span class="fs-5 fw-bold d-none d-sm-inline fitconnect-brand">Admin Console</span>
                    </a>
                    
                    <ul class="nav nav-pills flex-column mb-sm-auto mb-0 align-items-center align-items-sm-start w-100" id="menu">
                        <div class="mb-2 px-3 text-uppercase small fw-bold mt-2" style="opacity: 0.5; color: #fff;">Dashboard</div>
                        <li class="nav-item w-100 mb-1">
                            <a href="/admin/dashboard" class="nav-link w-100">
                                <i class="fs-6 fas fa-chart-pie me-2"></i> <span class="d-none d-sm-inline">Overview</span>
                            </a>
                        </li>
                        <div class="mb-2 px-3 text-uppercase small fw-bold mt-4" style="opacity: 0.5; color: #fff;">Management</div>
                        <li class="nav-item w-100 mb-1">
                            <a href="/admin/trainers" class="nav-link active w-100 d-flex justify-content-between align-items-center">
                                <div><i class="fs-6 fas fa-user-tie me-2"></i> <span class="d-none d-sm-inline">Trainers</span></div>
                                <% if(typeof stats !== 'undefined' && stats.pendingTrainers > 0) { %>
                                    <span class="badge bg-danger shadow-sm"><%= stats.pendingTrainers %></span>
                                <% } %>
                            </a>
                        </li>
                        <li class="nav-item w-100 mb-1">
                            <a href="/admin/users" class="nav-link w-100">
                                <i class="fs-6 fas fa-users me-2"></i> <span class="d-none d-sm-inline">Users</span>
                            </a>
                        </li>
                        <li class="nav-item w-100 mb-1">
                            <a href="/admin/bookings" class="nav-link w-100">
                                <i class="fs-6 fas fa-calendar-alt me-2"></i> <span class="d-none d-sm-inline">Bookings</span>
                            </a>
                        </li>
                    </ul>
                    <hr class="w-100 mt-5 mb-3" style="border-color: rgba(255,255,255,0.1);">
                    <div class="pb-4 w-100">
                        <a href="/admin/logout" class="btn btn-outline-light w-100 border-opacity-25 py-2 fw-medium"><i class="fas fa-power-off me-2 text-danger"></i> Logout</a>
                    </div>
                </div>
            </div>

            <!-- Content Area -->
            <div class="col py-0 px-0" style="height: 100vh; overflow-y: auto; overflow-x: hidden;">
                <nav class="navbar topbar px-4 py-3 sticky-top">
                    <h4 class="mb-0 fw-bold text-white d-none d-md-block" style="letter-spacing: -0.5px;">Trainers Directory</h4>
                    <span class="d-md-none fw-bold fs-4 text-white">Trainers</span>
                    <div class="ms-auto d-flex align-items-center">
                        <button onclick="toggleTheme()" class="btn btn-sm d-flex align-items-center gap-2 me-3 theme-toggle-btn" 
                                style="background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); color: inherit; padding: 6px 12px; border-radius: 20px;">
                            <i class="fas fa-paint-brush"></i>
                        </button>
                        <div class="px-4 py-2 border rounded-pill shadow-sm glass-panel text-white border-white border-opacity-25" style="backdrop-filter: blur(5px);">
                            <i class="fas fa-user-shield text-danger me-2"></i> <span class="fw-bold fs-6">Super Admin</span>
                        </div>
                    </div>
                </nav>

                <div class="p-4 p-md-5">
                    <div class="card glass-panel shadow-sm border-0 rounded-4">
                        <div class="card-body p-4">
                            <div class="d-flex align-items-center mb-4 pb-2 border-bottom border-secondary border-opacity-25">
                                <div class="bg-danger bg-opacity-25 p-3 rounded-circle me-3">
                                    <i class="fas fa-tasks text-danger fs-4"></i>
                                </div>
                                <h4 class="fw-bold mb-0 text-white">Trainer Applications & Records</h4>
                            </div>
                            
                            <% if(typeof trainers !== 'undefined' && trainers && trainers.length > 0) { %>
                                <div class="table-responsive">
                                    <table class="table table-hover align-middle border-0">
                                        <thead>
                                            <tr>
                                                <th class="border-top-0 border-bottom border-secondary opacity-75">Photo</th>
                                                <th class="border-top-0 border-bottom border-secondary opacity-75">Details</th>
                                                <th class="border-top-0 border-bottom border-secondary opacity-75">Specialization</th>
                                                <th class="border-top-0 border-bottom border-secondary opacity-75">Status</th>
                                                <th class="border-top-0 border-bottom border-secondary opacity-75">Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <% trainers.forEach(trainer => { %>
                                                <tr>
                                                    <td class="py-3">
                                                        <% let imgSrc = trainer.profile_image ? (trainer.profile_image.startsWith('http') ? trainer.profile_image : '/uploads/' + trainer.profile_image) : '/images/default-avatar.png'; %>
                                                        <div class="position-relative d-inline-block">
                                                            <div class="position-absolute w-100 h-100 rounded-circle bg-danger opacity-25" style="filter: blur(10px); transform: scale(1.1);"></div>
                                                            <img src="<%= imgSrc %>" class="rounded-circle shadow-sm border border-2 border-white border-opacity-25 position-relative" width="60" height="60" style="object-fit: cover; object-position: center top; z-index: 2;" onerror="this.src='/images/default-avatar.png'">
                                                        </div>
                                                    </td>
                                                    <td class="py-3">
                                                        <div class="fw-bold text-white fs-6"><%= trainer.name %></div>
                                                        <div class="small text-muted"><i class="fas fa-envelope me-1 opacity-50"></i><%= trainer.email %></div>
                                                        <div class="small text-muted"><i class="fas fa-map-marker-alt me-1 opacity-50"></i><%= trainer.city %></div>
                                                    </td>
                                                    <td class="py-3">
                                                        <span class="badge bg-danger bg-opacity-25 border border-danger border-opacity-25 text-white rounded-pill px-3 py-2 shadow-sm"><%= trainer.specialization %></span>
                                                        <div class="small fw-bold mt-2" style="color: #fca5a5;"><%= trainer.experience %> Years Exp</div>
                                                    </td>
                                                    <td class="py-3">
                                                        <% if(trainer.status === 'pending') { %>
                                                            <span class="badge bg-warning text-dark px-3 py-2 rounded-pill shadow-sm"><i class="fas fa-clock me-1"></i> Pending</span>
                                                        <% } else if(trainer.status === 'approved') { %>
                                                            <span class="badge bg-success px-3 py-2 rounded-pill shadow-sm"><i class="fas fa-check-circle me-1"></i> Approved</span>
                                                        <% } else { %>
                                                            <span class="badge bg-secondary px-3 py-2 rounded-pill shadow-sm"><i class="fas fa-times-circle me-1"></i> Rejected</span>
                                                        <% } %>
                                                    </td>
                                                    <td class="py-3">
                                                        <div class="d-flex align-items-center gap-2">
                                                            <button class="btn btn-sm btn-outline-info rounded-pill px-3 py-2 fw-medium border-opacity-25" type="button" data-bs-toggle="collapse" data-bs-target="#details-<%= trainer.id %>">
                                                                <i class="fas fa-eye me-1"></i>Details
                                                            </button>
                                                            <% if(trainer.status === 'pending') { %>
                                                                <form action="/admin/trainers/<%= trainer.id %>/approve" method="POST" style="display:inline;">
                                                                    <button type="submit" class="btn btn-sm btn-modern rounded-pill shadow-sm px-3 border-0 py-2 fw-medium" title="Approve Trainer">
                                                                        <i class="fas fa-check me-1"></i>Approve
                                                                    </button>
                                                                </form>
                                                                <form action="/admin/trainers/<%= trainer.id %>/reject" method="POST" style="display:inline;">
                                                                    <button type="submit" class="btn btn-sm btn-outline-light rounded-pill shadow-sm px-3 py-2 fw-medium border-opacity-25" title="Reject Trainer">
                                                                        <i class="fas fa-times me-1 text-secondary"></i>Reject
                                                                    </button>
                                                                </form>
                                                            <% } else if(trainer.status === 'approved') { %>
                                                                <form action="/admin/trainers/<%= trainer.id %>/reject" method="POST" style="display:inline;" onsubmit="return confirm('⚠️ Are you sure you want to reject this approved trainer?')">
                                                                    <button type="submit" class="btn btn-sm btn-outline-light rounded-pill shadow-sm px-3 py-2 fw-medium border-opacity-25" title="Reject Approved Trainer">
                                                                        <i class="fas fa-times text-secondary me-1"></i>Reject
                                                                    </button>
                                                                </form>
                                                            <% } else { %>
                                                                <form action="/admin/trainers/<%= trainer.id %>/approve" method="POST" style="display:inline;" onsubmit="return confirm('Are you sure you want to give this trainer another chance?')">
                                                                    <button type="submit" class="btn btn-sm btn-modern rounded-pill shadow-sm px-3 border-0 py-2 fw-medium" title="Approve Rejected Trainer">
                                                                        <i class="fas fa-check me-1"></i>Give Second Chance
                                                                    </button>
                                                                </form>
                                                            <% } %>
                                                        </div>
                                                    </td>
                                                </tr>
                                                <!-- Collapsible Details Row -->
                                                <tr class="collapse" id="details-<%= trainer.id %>">
                                                    <td colspan="5" class="p-0 border-0">
                                                        <div class="m-3 p-4 glass-panel-content rounded-4 border border-info border-opacity-25 shadow-lg">
                                                            <div class="row g-4">
                                                                <!-- QR & UPI -->
                                                                <div class="col-md-4 border-end border-secondary border-opacity-25">
                                                                    <h6 class="text-info fw-bold mb-3"><i class="fas fa-wallet me-2"></i>Payment Verification</h6>
                                                                    <div class="mb-3">
                                                                        <small class="text-muted d-block mb-1">UPI ID</small>
                                                                        <div class="fw-bold text-white"><%= trainer.upi_id || 'Not Provided' %></div>
                                                                    </div>
                                                                </div>
                                                                <!-- Certificates -->
                                                                <div class="col-md-8">
                                                                    <h6 class="text-danger fw-bold mb-3"><i class="fas fa-certificate me-2"></i>Certifications & Documents</h6>
                                                                    <div class="row g-2">
                                                                        <% if(trainer.certifications && trainer.certifications.length > 0) { %>
                                                                            <% trainer.certifications.forEach((cert, idx) => { %>
                                                                                <div class="col-sm-6 col-md-4">
                                                                                    <a href="<%= cert %>" target="_blank" class="d-flex align-items-center p-3 rounded-3 bg-white bg-opacity-5 border border-white border-opacity-10 text-decoration-none hover-bg-opacity-10 transition-all">
                                                                                        <i class="fas fa-file-pdf fa-2x text-danger me-3"></i>
                                                                                        <div class="overflow-hidden">
                                                                                            <div class="text-white small fw-bold text-truncate">Certificate <%= idx + 1 %></div>
                                                                                            <div class="text-muted x-small">Click to View</div>
                                                                                        </div>
                                                                                    </a>
                                                                                </div>
                                                                            <% }) %>
                                                                        <% } else { %>
                                                                            <div class="col-12 text-center py-4">
                                                                                <i class="fas fa-file-contract fa-2x text-muted mb-2 opacity-25"></i>
                                                                                <p class="text-muted mb-0">No certification documents uploaded yet.</p>
                                                                            </div>
                                                                        <% } %>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </td>
                                                </tr>
                                            <% }) %>
                                        </tbody>
                                    </table>
                                </div>
                            <% } else { %>
                                <div class="text-center py-5 my-4">
                                    <div class="position-relative d-inline-block mx-auto mb-4">
                                        <div class="bg-white bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center mx-auto position-relative border border-white border-opacity-10" style="width: 100px; height: 100px;">
                                            <i class="fas fa-user-times fa-3x" style="color: rgba(255,255,255,0.4);"></i>
                                        </div>
                                    </div>
                                    <h4 class="text-white fw-bold mb-2">No Trainers Found!</h4>
                                    <p style="color: #94a3b8;" class="mb-4">Trainers will appear here once they register on the platform.</p>
                                </div>
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <script>
        // Generate secure glowing floating animations
        document.addEventListener('DOMContentLoaded', () => {
            const fallingContainer = document.getElementById('fallingContainer');
            if(fallingContainer) {
                const icons = ['fa-shield-halved', 'fa-lock', 'fa-key', 'fa-server', 'fa-user-tie', 'fa-user-shield'];
                const numEquipments = 20; 

                for(let i=0; i < numEquipments; i++) {
                    const icon = document.createElement('i');
                    const randomIcon = icons[Math.floor(Math.random() * icons.length)];
                    icon.className = `sec-icon fas ${randomIcon}`;
                    
                    const size = Math.random() * 3 + 1; 
                    const leftPos = Math.random() * 100;
                    const duration = Math.random() * 20 + 20; 
                    const delay = Math.random() * -25; 
                    
                    icon.style.fontSize = `${size}rem`;
                    icon.style.left = `${leftPos}%`;
                    icon.style.animationDuration = `${duration}s`;
                    icon.style.animationDelay = `${delay}s`; 
                    
                    fallingContainer.appendChild(icon);
                }
            }
        });
    </script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
