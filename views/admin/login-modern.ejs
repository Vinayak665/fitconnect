<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FitConnect - Admin Login</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700&display=swap');

        *{ margin: 0; padding: 0; box-sizing: border-box; font-family: 'Montserrat', sans-serif; }
        body { 
            background-color: #450a0a; /* Dark red */
            display: flex; 
            align-items: center; 
            justify-content: center; 
            flex-direction: column; 
            min-height: 100vh; 
            position: relative;
            overflow: hidden;
        }

        .nav-home {
            position: absolute;
            top: 20px;
            left: 20px;
            text-decoration: none;
            color: #fff;
            font-weight: 600;
            font-size: 14px;
            background: rgba(220, 38, 38, 0.1);
            backdrop-filter: blur(10px);
            padding: 10px 15px;
            border-radius: 8px;
            border: 1px solid rgba(220, 38, 38, 0.3);
            box-shadow: 0 4px 15px rgba(220, 38, 38, 0.2);
            z-index: 100;
            transition: all 0.3s ease;
        }
        .nav-home:hover {
            background: rgba(220, 38, 38, 0.3);
            transform: translateY(-2px);
        }

        .container {
            background-color: #fff; 
            border-radius: 30px; 
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.8), 0 0 0 1px rgba(220, 38, 38, 0.2); 
            position: relative; 
            overflow: hidden; 
            width: 768px; 
            max-width: 100%; 
            height: 480px;
            z-index: 10;
            display: flex;
        }

        /* Right Side: Form */
        .form-side { 
            flex: 1;
            background-color: #fff; 
            display: flex; 
            align-items: center; 
            justify-content: center; 
            flex-direction: column; 
            padding: 0 40px; 
            text-align: center; 
        }

        .form-side h1 { font-size: 28px; color: #000; margin-bottom: 20px; text-align: center; }
        .form-side span{ font-size: 12px; color: #666; text-align: center; display: block; margin-bottom: 20px; }
        
        .form-side input{ background-color: #eee; border: none; margin: 8px 0; padding: 12px 15px; font-size: 13px; border-radius: 8px; width: 100%; outline: none; }
        
        .form-side button{ background-color: #dc2626; color: #fff; font-size: 12px; padding: 12px 0; width: 100%; border: 1px solid transparent; border-radius: 8px; font-weight: 600; letter-spacing: 0.5px; text-transform: uppercase; margin-top: 15px; cursor: pointer; transition: all 0.3s; }
        .form-side button:hover { background-color: #b91c1c; transform: translateY(-2px); }
        
        .social-icons{ margin: 0 0 20px 0; display: flex; justify-content: center; }
        .social-icons a{ border: 1px solid #ccc; border-radius: 20%; display: inline-flex; justify-content: center; align-items: center; margin: 0 3px; width: 40px; height: 40px; font-size: 18px; }

        /* Left Side: Graphic Block */
        .graphic-side {
            background: linear-gradient(to right, #ef4444, #b91c1c); 
            flex: 1;
            color: #fff; 
            display: flex; 
            align-items: center; 
            justify-content: center; 
            flex-direction: column; 
            padding: 40px; 
            text-align: center; 
        }
        
        .graphic-side h1 { font-size: 32px; font-weight: 700; margin-bottom: 15px; }
        .graphic-side p { font-size: 14px; line-height: 22px; font-weight: 400; opacity: 0.9; }

        /* Aesthetic Red Aurora Background */
        .bg-aurora {
            position: absolute;
            top: 0; left: 0; width: 100%; height: 100%;
            z-index: 0;
            background: #2a0404;
            overflow: hidden;
        }

        .aurora-blob {
            position: absolute;
            filter: blur(90px);
            opacity: 0.6;
            animation: float-blob 20s infinite alternate ease-in-out;
        }

        .blob-1 { top: -10%; left: -10%; width: 50vw; height: 50vh; background: #dc2626; animation-delay: 0s; }
        .blob-2 { top: 40%; right: -20%; width: 60vw; height: 60vh; background: #ef4444; animation-delay: -5s; }
        .blob-3 { bottom: -20%; left: 20%; width: 40vw; height: 50vh; background: #b91c1c; animation-delay: -10s; }

        @keyframes float-blob {
            0% { transform: scale(1) translate(0, 0) rotate(0deg); }
            50% { transform: scale(1.1) translate(5%, 5%) rotate(5deg); }
            100% { transform: scale(0.9) translate(-5%, -5%) rotate(-5deg); }
        }

        /* Animated Admin/Security Icons Floating */
        .falling-container {
            position: absolute;
            top: -100px;
            left: 0;
            width: 100%;
            height: calc(100% + 200px);
            overflow: hidden;
            z-index: 1;
            pointer-events: none;
        }

        .sec-icon {
            position: absolute;
            color: rgba(255, 255, 255, 0.1);
            animation: fall linear infinite;
        }

        @keyframes fall {
            0% { transform: translateY(0) rotate(0deg); opacity: 0; }
            10% { opacity: 1; }
            80% { opacity: 1; }
            100% { transform: translateY(110vh) rotate(360deg); opacity: 0; }
        }
        .theme-toggle-floating {
            position: fixed;
            bottom: 30px;
            right: 30px;
            z-index: 1000;
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.2);
            color: white;
            width: 50px;
            height: 50px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            box-shadow: 0 10px 25px rgba(0,0,0,0.3);
            transition: all 0.3s ease;
        }
        .theme-toggle-floating:hover {
            transform: scale(1.1);
            background: rgba(255, 255, 255, 0.2);
        }
    </style>
    <%- include('../partials/theme-logic') %>
</head>
<body>
    <%- include('../partials/notifications') %>
    <!-- Aesthetic Aurora Background -->
    <div class="bg-aurora">
        <div class="aurora-blob blob-1"></div>
        <div class="aurora-blob blob-2"></div>
        <div class="aurora-blob blob-3"></div>
    </div>

    <!-- Animated Floating Background Elements -->
    <div class="falling-container" id="fallingContainer"></div>

    <a href="/" class="nav-home"><i class="fas fa-arrow-left"></i> Home</a>

    <button onclick="toggleTheme()" class="theme-toggle-floating" title="Switch Theme">
        <i class="fas fa-paint-brush"></i>
    </button>

    <div class="container" id="container">
        
        <!-- Static Graphic Side (Replaces the "slide" mechanism) -->
        <div class="graphic-side">
            <h1>Secure Portal</h1>
            <p>Access the FitConnect Administrator Dashboard to securely manage users, review trainers, and handle platform settings.</p>
        </div>

        <!-- Static Admin Login Form Left Side -->
        <div class="form-side">
            <form action="/admin/login" method="POST">
                <h1>Admin Portal</h1>
                <div class="social-icons">
                    <a href="#" class="icon"><i class="fas fa-shield-alt" style="color: #dc2626;"></i></a>
                </div>
                <span>Enter your authorized credentials</span>
                <input type="text" name="username" placeholder="Username" required>
                <input type="password" name="password" placeholder="Password" required>
                <button type="submit">Admin Sign In</button>
            </form>
        </div>

    </div>

    <script>
        // Generate glowing floating animations
        document.addEventListener('DOMContentLoaded', () => {
            const fallingContainer = document.getElementById('fallingContainer');
            if(fallingContainer) {
                const icons = ['fa-shield-halved', 'fa-lock', 'fa-key', 'fa-server', 'fa-user-tie', 'fa-user-shield'];
                const numEquipments = 20; 

                for(let i=0; i < numEquipments; i++) {
                    const icon = document.createElement('i');
                    const randomIcon = icons[Math.floor(Math.random() * icons.length)];
                    icon.className = `sec-icon fas ${randomIcon}`;
                    
                    const size = Math.random() * 3 + 2; 
                    const leftPos = Math.random() * 100;
                    const duration = Math.random() * 20 + 20; 
                    const delay = Math.random() * -25; 
                    
                    icon.style.fontSize = `${size}rem`;
                    icon.style.left = `${leftPos}%`;
                    icon.style.animationDuration = `${duration}s`;
                    icon.style.animationDelay = `${delay}s`; 
                    
                    fallingContainer.appendChild(icon);
                }
            }
        });
    </script>
</body>
</html>
