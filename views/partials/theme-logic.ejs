<!-- Theme Engine (Locked to Aurora) -->
<style>
    /* Hide the theme toggle button everywhere */
    .theme-toggle-btn, .theme-toggle-floating {
        display: none !important;
    }
</style>
<script>
    (function() {
        // Enforce Aurora theme globally
        document.documentElement.classList.remove('theme-classic');
        document.documentElement.classList.add('theme-aurora');
        localStorage.setItem('fitconnect-theme', 'aurora');
        
        // Remove classic theme stylesheet if it was somehow loaded
        const classicLink = document.getElementById('classic-theme-link');
        if (classicLink) classicLink.remove();
    })();

    // Dummy function so existing onclick handlers don't throw errors
    function toggleTheme() {
        console.log('Theme switching is disabled. Aurora theme is enforced.');
    }
</script>
