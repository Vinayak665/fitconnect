<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FitConnect - Search Trainers</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style-optimized.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <%- include('partials/theme-logic') %>
    <style>
        .navbar-brand, .fitconnect-brand { color: #38bdf8 !important; -webkit-text-fill-color: #38bdf8 !important; background: none !important; font-size: 1.5rem !important; font-weight: 800 !important; }
        nav { background: rgba(2, 6, 23, 0.8) !important; backdrop-filter: blur(15px); border-bottom: 1px solid rgba(255,255,255,0.05); }
        .nav-link { color: rgba(255,255,255,0.8) !important; }
        .nav-link:hover, .nav-link.active { color: #38bdf8 !important; }
        
        body { background-color: #020617; color: white; min-height: 100vh; overflow-x: hidden; }
        .mesh-bg {
            background-image: 
                radial-gradient(at 0% 0%, rgba(56, 189, 248, 0.15) 0px, transparent 50%),
                radial-gradient(at 100% 0%, rgba(59, 130, 246, 0.15) 0px, transparent 50%),
                radial-gradient(at 100% 100%, rgba(14, 165, 233, 0.15) 0px, transparent 50%),
                radial-gradient(at 0% 100%, rgba(37, 99, 235, 0.15) 0px, transparent 50%);
            min-height: 100vh;
        }

        .glass-panel, .glass-card {
            background: rgba(15, 23, 42, 0.6) !important;
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.08) !important;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5) !important;
            border-radius: 1.5rem;
            transition: all 0.4s ease;
            color: white !important;
        }
        .trainer-card:hover {
            transform: translateY(-10px);
            border: 1px solid rgba(56, 189, 248, 0.3) !important;
            box-shadow: 0 25px 50px -12px rgba(56, 189, 248, 0.2) !important;
        }
        
        .form-label { color: rgba(255,255,255,0.9); }
        .form-control, .form-select { background: rgba(0,0,0,0.3) !important; border: 1px solid rgba(255,255,255,0.1) !important; color: white !important; }
        .form-control:focus, .form-select:focus, .custom-select-btn.focused { border-color: #38bdf8 !important; box-shadow: 0 0 0 .25rem rgba(56,189,248,.25) !important; }
        .form-select option { background-color: #0f172a; color: white; }
        
        .text-gradient {
            background-clip: text;
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-image: linear-gradient(to right, #38bdf8, #818cf8);
        }
        
        .text-muted { color: rgba(255,255,255,0.6) !important; }
        .text-dark { color: white !important; }
        hr { border-color: rgba(255,255,255,0.1); }

        /* Ocean Aurora Dropdown */
        .aurora-dropdown {
            background: rgba(2, 6, 23, 0.92) !important;
            backdrop-filter: blur(24px) !important;
            -webkit-backdrop-filter: blur(24px) !important;
            border: 1px solid rgba(56, 189, 248, 0.2) !important;
            border-radius: 16px !important;
            box-shadow: 0 20px 60px rgba(0,0,0,0.6), 0 0 0 1px rgba(56,189,248,0.08), inset 0 1px 0 rgba(255,255,255,0.05) !important;
            padding: 8px !important;
            min-width: 220px !important;
            margin-top: 10px !important;
            overflow: hidden;
            display: block !important;
            opacity: 0;
            transform: translateY(-10px) scale(0.97);
            pointer-events: none;
            transition: opacity 0.22s cubic-bezier(0.16,1,0.3,1),
                        transform 0.22s cubic-bezier(0.16,1,0.3,1);
            visibility: hidden;
            z-index: 1000;
        }
        .aurora-dropdown.open {
            opacity: 1;
            transform: translateY(0) scale(1);
            pointer-events: auto;
            visibility: visible;
        }
        .aurora-dropdown-item {
            display: flex !important;
            align-items: center !important;
            gap: 12px !important;
            padding: 11px 14px !important;
            border-radius: 10px !important;
            color: rgba(255,255,255,0.85) !important;
            font-weight: 600 !important;
            font-size: 0.9rem !important;
            text-decoration: none !important;
            transition: background 0.18s ease, color 0.18s ease, transform 0.15s ease !important;
            background: transparent !important;
        }
        .aurora-dropdown-item:hover {
            background: rgba(56, 189, 248, 0.12) !important;
            color: #38bdf8 !important;
            transform: translateX(3px) !important;
        }
        .aurora-dropdown-item .item-icon {
            width: 32px;
            height: 32px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.85rem;
            flex-shrink: 0;
        }
        .aurora-divider {
            height: 1px;
            background: linear-gradient(to right, transparent, rgba(56,189,248,0.2), transparent);
            margin: 6px 8px;
        }
        .aurora-dropdown-label {
            font-size: 0.65rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.12em;
            color: #475569;
            padding: 4px 14px 2px;
        }
        /* Login button glow */
        .login-btn-aurora {
            background: linear-gradient(135deg, rgba(14,165,233,0.15), rgba(99,102,241,0.15)) !important;
            border: 1px solid rgba(56,189,248,0.35) !important;
            color: #38bdf8 !important;
            border-radius: 50px !important;
            font-weight: 700 !important;
            transition: all 0.25s ease !important;
            padding: 8px 22px !important;
        }
        .login-btn-aurora:hover {
            background: linear-gradient(135deg, rgba(14,165,233,0.3), rgba(99,102,241,0.3)) !important;
            border-color: #38bdf8 !important;
            box-shadow: 0 0 20px rgba(56,189,248,0.25) !important;
            color: #fff !important;
        }
        .login-btn-aurora::after { display: none !important; }
    </style>
</head>
<body class="mesh-bg">
    <%- include('partials/notifications') %>
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg sticky-top">
        <div class="container">
            <a class="navbar-brand" href="/"><i class="fas fa-dumbbell me-2"></i>FitConnect</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <i class="fas fa-bars text-white"></i>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto align-items-center">
                    <!-- Theme Switcher -->
                    <li class="nav-item me-3">
                        <button onclick="toggleTheme()" class="btn btn-sm d-flex align-items-center gap-2 theme-toggle-btn" 
                                style="background: rgba(56, 189, 248, 0.1); border: 1px solid rgba(56, 189, 248, 0.3); color: #38bdf8; padding: 8px 16px; border-radius: 20px; font-weight: 600;">
                            <i class="fas fa-paint-brush"></i>
                            <span>Switch Theme</span>
                        </button>
                    </li>
                    <li class="nav-item"><a class="nav-link fw-semibold active" href="/search">Find a Trainer</a></li>
                    <li class="nav-item"><a class="nav-link fw-semibold" href="/trainer/login?mode=signup">Become a Trainer</a></li>
                    
                    <% if (typeof locals.session !== 'undefined' && locals.session.userId && locals.session.userRole === 'user') { %>
                        <li class="nav-item ms-lg-3">
                            <a class="btn btn-modern px-4" href="/dashboard">Dashboard</a>
                        </li>
                        <li class="nav-item ms-2">
                            <a class="nav-link text-danger" href="/user/logout"><i class="fas fa-sign-out-alt"></i></a>
                        </li>
                    <% } else if (typeof locals.session !== 'undefined' && locals.session.trainerId && locals.session.userRole === 'trainer') { %>
                        <li class="nav-item ms-lg-3">
                            <a class="btn btn-modern px-4" href="/trainer/dashboard">Dashboard</a>
                        </li>
                        <li class="nav-item ms-2">
                            <a class="nav-link text-danger" href="/trainer/logout"><i class="fas fa-sign-out-alt"></i></a>
                        </li>
                    <% } else if (typeof locals.session !== 'undefined' && locals.session.adminId && locals.session.userRole === 'admin') { %>
                        <li class="nav-item ms-lg-3">
                            <a class="btn btn-modern px-4" href="/admin/dashboard">Admin Panel</a>
                        </li>
                        <li class="nav-item ms-2">
                            <a class="nav-link text-danger" href="/admin/logout"><i class="fas fa-sign-out-alt"></i></a>
                        </li>
                    <% } else { %>
                        <li class="nav-item dropdown ms-lg-3">
                             <button class="login-btn-aurora d-flex align-items-center gap-2"
                                 id="loginDropdown" type="button"
                                 onclick="toggleAuroraDropdown(event)"
                                 style="text-decoration:none;background:none;border:1px solid rgba(56,189,248,0.35);cursor:pointer;">
                                 <i class="fas fa-user-circle" style="font-size:1rem;"></i>
                                 <span>Login</span>
                                 <i class="fas fa-chevron-down" id="loginChevron" style="font-size:0.65rem;transition:transform 0.22s;"></i>
                             </button>
                            <ul class="dropdown-menu aurora-dropdown dropdown-menu-end" id="auroraMenu" aria-labelledby="loginDropdown">
                                <li><div class="aurora-dropdown-label">Choose your role</div></li>
                                <li>
                                    <a class="aurora-dropdown-item" href="/user-login">
                                        <span class="item-icon" style="background:rgba(56,189,248,0.15);color:#38bdf8;">
                                            <i class="fas fa-user"></i>
                                        </span>
                                        <div>
                                            <div style="font-size:0.88rem;font-weight:700;">User Login</div>
                                            <div style="font-size:0.72rem;color:#64748b;font-weight:500;">Book & manage sessions</div>
                                        </div>
                                    </a>
                                </li>
                                <li>
                                    <a class="aurora-dropdown-item" href="/trainer/login?mode=signup">
                                        <span class="item-icon" style="background:rgba(74,222,128,0.15);color:#4ade80;">
                                            <i class="fas fa-dumbbell"></i>
                                        </span>
                                        <div>
                                            <div style="font-size:0.88rem;font-weight:700;">Trainer Login</div>
                                            <div style="font-size:0.72rem;color:#64748b;font-weight:500;">Manage your clients</div>
                                        </div>
                                    </a>
                                </li>
                                <li><div class="aurora-divider"></div></li>
                                <li>
                                    <a class="aurora-dropdown-item" href="/admin/login">
                                        <span class="item-icon" style="background:rgba(251,113,133,0.15);color:#fb7185;">
                                            <i class="fas fa-shield-alt"></i>
                                        </span>
                                        <div>
                                            <div style="font-size:0.88rem;font-weight:700;">Admin Login</div>
                                            <div style="font-size:0.72rem;color:#64748b;font-weight:500;">Platform administration</div>
                                        </div>
                                    </a>
                                </li>
                            </ul>
                        </li>
                    <% } %>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Search Header -->
    <div class="py-5" style="padding: 60px 0;">
        <div class="container text-center text-white">
            <h2 class="fw-bold mb-3 text-gradient border-0 text-7xl" style="font-size: 3.5rem;">Find Your Ideal Trainer</h2>
            <p class="lead mb-0 text-slate-300">Filter by location and specialty to match your goals</p>
        </div>
    </div>

    <!-- Main Content -->
    <div class="container mb-5 pb-5">
        
        <!-- Search Filter Form -->
        <div class="glass-panel p-4 mb-5 animate-fade-up">
            <form action="/search" method="POST" class="row border-0 g-3 align-items-end">
                <div class="col-md-5">
                    <label class="form-label fw-bold"><i class="fas fa-map-marker-alt text-info me-2"></i>City Location</label>
                    <input type="text" name="city" class="form-control py-3 rounded-pill px-4 shadow-sm" placeholder="e.g. Karwar, Mumbai" value="<%= typeof city !== 'undefined' ? city : '' %>">
                </div>
                <div class="col-md-5 position-relative">
                    <label class="form-label fw-bold"><i class="fas fa-dumbbell text-info me-2"></i>Specialization</label>
                    <input type="hidden" name="specialization" id="specializationInput" value="<%= typeof specialization !== 'undefined' ? specialization : '' %>">
                    
                    <button type="button" class="form-control py-3 rounded-pill px-4 shadow-sm text-start d-flex justify-content-between align-items-center w-100 bg-transparent text-white custom-select-btn" id="specializationDropdownBtn" onclick="toggleSpecDropdown(event)" style="border: 1px solid rgba(255,255,255,0.1); background: rgba(0,0,0,0.3) !important;">
                        <span id="specializationBtnText" class="text-truncate">
                            <% if (typeof specialization !== 'undefined' && specialization === 'Weight Loss') { %>Weight Loss
                            <% } else if (typeof specialization !== 'undefined' && specialization === 'Muscle Gain') { %>Muscle Gain
                            <% } else if (typeof specialization !== 'undefined' && specialization === 'Yoga') { %>Yoga
                            <% } else if (typeof specialization !== 'undefined' && specialization === 'CrossFit') { %>CrossFit
                            <% } else if (typeof specialization !== 'undefined' && specialization === 'Nutrition') { %>Nutrition
                            <% } else { %>Any Specialization<% } %>
                        </span>
                        <i class="fas fa-chevron-down ms-2" id="specChevron" style="font-size:0.75rem; transition:transform 0.22s;"></i>
                    </button>
                    
                    <div class="dropdown-menu aurora-dropdown w-100 shadow-lg border-0" id="specMenu" style="top: 100%; border-radius: 16px; padding: 10px; max-height: 350px; overflow-y: auto; margin-top: 5px;">
                        <div class="aurora-dropdown-label mb-1">Select Focus Area</div>
                        
                        <a href="#" class="aurora-dropdown-item spec-item" data-value="" data-text="Any Specialization" onclick="selectSpecialization(event, this)">
                            <span class="item-icon" style="background:rgba(255,255,255,0.1);color:#fff;">
                                <i class="fas fa-globe"></i>
                            </span>
                            <div>
                                <div style="font-size:0.88rem;font-weight:700;">Any Specialization</div>
                                <div style="font-size:0.72rem;color:#64748b;font-weight:500;">All trainers</div>
                            </div>
                        </a>
                        
                        <a href="#" class="aurora-dropdown-item spec-item" data-value="Weight Loss" data-text="Weight Loss" onclick="selectSpecialization(event, this)">
                            <span class="item-icon" style="background:rgba(244,63,94,0.15);color:#f43f5e;">
                                <i class="fas fa-fire"></i>
                            </span>
                            <div>
                                <div style="font-size:0.88rem;font-weight:700;">Weight Loss</div>
                                <div style="font-size:0.72rem;color:#64748b;font-weight:500;">Burn fat & tone up</div>
                            </div>
                        </a>
                        
                        <a href="#" class="aurora-dropdown-item spec-item" data-value="Muscle Gain" data-text="Muscle Gain" onclick="selectSpecialization(event, this)">
                            <span class="item-icon" style="background:rgba(56,189,248,0.15);color:#38bdf8;">
                                <i class="fas fa-dumbbell"></i>
                            </span>
                            <div>
                                <div style="font-size:0.88rem;font-weight:700;">Muscle Gain</div>
                                <div style="font-size:0.72rem;color:#64748b;font-weight:500;">Build strength & mass</div>
                            </div>
                        </a>
                        
                        <a href="#" class="aurora-dropdown-item spec-item" data-value="Yoga" data-text="Yoga" onclick="selectSpecialization(event, this)">
                            <span class="item-icon" style="background:rgba(168,85,247,0.15);color:#a855f7;">
                                <i class="fas fa-yin-yang"></i>
                            </span>
                            <div>
                                <div style="font-size:0.88rem;font-weight:700;">Yoga</div>
                                <div style="font-size:0.72rem;color:#64748b;font-weight:500;">Flexibility & mindfulness</div>
                            </div>
                        </a>
                        
                        <a href="#" class="aurora-dropdown-item spec-item" data-value="CrossFit" data-text="CrossFit" onclick="selectSpecialization(event, this)">
                            <span class="item-icon" style="background:rgba(234,179,8,0.15);color:#eab308;">
                                <i class="fas fa-running"></i>
                            </span>
                            <div>
                                <div style="font-size:0.88rem;font-weight:700;">CrossFit</div>
                                <div style="font-size:0.72rem;color:#64748b;font-weight:500;">High-intensity training</div>
                            </div>
                        </a>
                        
                        <a href="#" class="aurora-dropdown-item spec-item" data-value="Nutrition" data-text="Nutrition" onclick="selectSpecialization(event, this)">
                            <span class="item-icon" style="background:rgba(34,197,94,0.15);color:#22c55e;">
                                <i class="fas fa-apple-alt"></i>
                            </span>
                            <div>
                                <div style="font-size:0.88rem;font-weight:700;">Nutrition</div>
                                <div style="font-size:0.72rem;color:#64748b;font-weight:500;">Diet & meal planning</div>
                            </div>
                        </a>
                    </div>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-modern w-100 py-3 rounded-pill shadow-lg"><i class="fas fa-search me-2"></i>Search</button>
                </div>
            </form>
        </div>

        <!-- Trainers Grid -->
        <div class="row g-4">
            <% if (typeof trainers !== 'undefined' && trainers.length > 0) { %>
                <% trainers.forEach((trainer, index) => { %>
                    <div class="col-md-4 col-sm-6 animate-fade-up" style="transition-delay: <%= index * 0.1 %>s">
                        <div class="card trainer-card glass-panel h-100 p-2 position-relative">
                            <!-- Image fallback logic -->
                            <% 
                               let imgSrc = '/images/default-avatar.png'; 
                               if(trainer.profile_image) {
                                  imgSrc = trainer.profile_image.startsWith('http') ? trainer.profile_image : '/uploads/' + trainer.profile_image;
                               }
                            %>
                            <div class="position-relative overflow-hidden rounded-4">
                                <img src="<%= imgSrc %>" class="card-img-top w-100" style="object-fit: cover; height: 260px;" alt="<%= trainer.name %>" onerror="this.src='/images/default-avatar.png'">
                            </div>
                            
                            <div class="card-body p-4 d-flex flex-column bg-transparent border-0">
                                <h4 class="card-title fw-bold mb-1"><%= trainer.name %></h4>
                                <p class="text-muted small mb-4"><i class="fas fa-map-marker-alt me-1 text-info"></i><%= trainer.city %></p>
                                
                                <div class="mb-4 d-flex flex-wrap gap-2">
                                    <span class="badge bg-info bg-opacity-10 text-info rounded-pill px-3 py-2 border border-info border-opacity-25"><i class="fas fa-award me-1"></i><%= trainer.specialization %></span>
                                    <span class="badge bg-light bg-opacity-10 text-white rounded-pill px-3 py-2 border border-white border-opacity-25"><i class="fas fa-clock me-1"></i><%= trainer.experience %> Yrs Exp</span>
                                </div>
                                
                                <hr class="mt-auto mb-4 opacity-25 border-secondary">
                                
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <div class="text-muted small">Session Rate</div>
                                        <div class="fw-bold text-success fs-4">₹<%= trainer.booking_amount %></div>
                                    </div>
                                    <a href="/book/<%= trainer.id %>" class="btn btn-modern rounded-pill px-4 shadow-lg" style="background: linear-gradient(135deg, #38bdf8 0%, #3b82f6 100%);">Book Now</a>
                                </div>
                            </div>
                        </div>
                    </div>
                <% }) %>
            <% } else { %>
                <!-- Empty State -->
                <div class="col-12 py-5 text-center animate-fade-up glass-panel">
                    <img src="https://cdn-icons-png.flaticon.com/512/7486/7486747.png" alt="No trainers found" class="img-fluid mb-4 opacity-50" style="max-width: 150px; filter: brightness(2) drop-shadow(0 0 20px rgba(56, 189, 248, 0.4));">
                    <h3 class="fw-bold text-white mb-2">No Trainers Found</h3>
                    <p class="text-muted">Try adjusting your search criteria to find available trainers in your area.</p>
                    <a href="/search" class="btn btn-outline-info rounded-pill mt-3 px-5 py-2">Clear All Filters</a>
                </div>
            <% } %>
        </div>
    </div>

    <!-- React + Tailwind + Motion Integration for HoverFooter -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/react@18/umd/react.development.js"></script>
    <script src="https://unpkg.com/react-dom@18/umd/react-dom.development.js"></script>
    <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>
    <script src="https://unpkg.com/framer-motion/dist/framer-motion.js"></script>

    <!-- App Container -->
    <div id="footer-root"></div>

    <script type="text/babel" data-presets="react,typescript">
        const { motion } = window.Motion;
        const cn = (...classes) => classes.filter(Boolean).join(' ');

        const TextHoverEffect = ({ text, duration, className }) => {
            const svgRef = React.useRef(null);
            const [cursor, setCursor] = React.useState({ x: 0, y: 0 });
            const [hovered, setHovered] = React.useState(false);
            const [maskPosition, setMaskPosition] = React.useState({ cx: "50%", cy: "50%" });

            React.useEffect(() => {
                if (svgRef.current && cursor.x !== null && cursor.y !== null) {
                    const svgRect = svgRef.current.getBoundingClientRect();
                    const cxPercentage = ((cursor.x - svgRect.left) / svgRect.width) * 100;
                    const cyPercentage = ((cursor.y - svgRect.top) / svgRect.height) * 100;
                    setMaskPosition({ cx: `${cxPercentage}%`, cy: `${cyPercentage}%` });
                }
            }, [cursor]);

            return (
                <svg
                    ref={svgRef} width="100%" height="100%" viewBox="0 0 450 100"
                    onMouseEnter={() => setHovered(true)} onMouseLeave={() => setHovered(false)}
                    onMouseMove={(e) => setCursor({ x: e.clientX, y: e.clientY })}
                    className={cn("select-none uppercase cursor-pointer", className)}
                >
                    <defs>
                        <linearGradient id="textGradient" gradientUnits="userSpaceOnUse" cx="50%" cy="50%" r="25%">
                            {hovered && (
                                <>
                                    <stop offset="0%" stopColor="#eab308" />
                                    <stop offset="25%" stopColor="#ef4444" />
                                    <stop offset="50%" stopColor="#80eeb4" />
                                    <stop offset="75%" stopColor="#06b6d4" />
                                    <stop offset="100%" stopColor="#8b5cf6" />
                                </>
                            )}
                        </linearGradient>
                        <motion.radialGradient
                            id="revealMask" gradientUnits="userSpaceOnUse" r="20%"
                            initial={{ cx: "50%", cy: "50%" }} animate={maskPosition}
                            transition={{ duration: duration ?? 0, ease: "easeOut" }}
                        >
                            <stop offset="0%" stopColor="white" />
                            <stop offset="100%" stopColor="black" />
                        </motion.radialGradient>
                        <mask id="textMask">
                            <rect x="0" y="0" width="100%" height="100%" fill="url(#revealMask)" />
                        </mask>
                    </defs>
                    <text x="50%" y="50%" textAnchor="middle" dominantBaseline="middle" strokeWidth="0.3"
                        className="fill-transparent stroke-white/20 font-bold opacity-70 text-6xl"
                        style={{ opacity: hovered ? 0.7 : 0 }}>{text}</text>
                    <motion.text x="50%" y="50%" textAnchor="middle" dominantBaseline="middle" strokeWidth="0.3"
                        className="fill-transparent stroke-[#3ca2fa] font-bold text-6xl"
                        initial={{ strokeDashoffset: 1000, strokeDasharray: 1000 }}
                        animate={{ strokeDashoffset: 0, strokeDasharray: 1000 }}
                        transition={{ duration: 4, ease: "easeInOut" }}>{text}</motion.text>
                    <text x="50%" y="50%" textAnchor="middle" dominantBaseline="middle" stroke="url(#textGradient)" strokeWidth="0.3"
                        mask="url(#textMask)" className="fill-transparent font-bold text-6xl">{text}</text>
                </svg>
            );
        };

        const FooterBackgroundGradient = () => (
            <div className="absolute inset-0 z-0" style={{ background: "radial-gradient(125% 125% at 50% 10%, #171717 50%, #3ca2fa33 100%)" }} />
