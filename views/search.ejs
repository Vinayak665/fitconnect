        const rootLayout = ReactDOM.createRoot(document.getElementById('footer-root'));
        rootLayout.render(<HoverFooter />);
    </script>



    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('visible');
                    }
                });
            }, { threshold: 0.1 });

            document.querySelectorAll('.animate-fade-up').forEach(el => observer.observe(el));
        });

        // Custom aurora dropdown toggle
        function toggleAuroraDropdown(e) {
            e.stopPropagation();
            const menu = document.getElementById('auroraMenu');
            const chevron = document.getElementById('loginChevron');
            const isOpen = menu.classList.contains('open');
            menu.classList.toggle('open', !isOpen);
            if (chevron) chevron.style.transform = isOpen ? '' : 'rotate(180deg)';
        }

        // Custom specialization dropdown
        function toggleSpecDropdown(e) {
            e.preventDefault();
            e.stopPropagation();
            const menu = document.getElementById('specMenu');
            const chevron = document.getElementById('specChevron');
            const btn = document.getElementById('specializationDropdownBtn');
            const isOpen = menu.classList.contains('open');
            
            // Close other dropdowns
            const auroraMenu = document.getElementById('auroraMenu');
            if(auroraMenu && auroraMenu.classList.contains('open')) {
                auroraMenu.classList.remove('open');
                const loginChevron = document.getElementById('loginChevron');
                if(loginChevron) loginChevron.style.transform = '';
            }

            menu.classList.toggle('open', !isOpen);
            btn.classList.toggle('focused', !isOpen);
            if (chevron) chevron.style.transform = isOpen ? '' : 'rotate(180deg)';
        }

        function selectSpecialization(e, element) {
            e.preventDefault();
            e.stopPropagation();
            const value = element.getAttribute('data-value');
            const text = element.getAttribute('data-text');
            
            document.getElementById('specializationInput').value = value;
            document.getElementById('specializationBtnText').textContent = text;
            
            // Close dropdown
            const menu = document.getElementById('specMenu');
            const chevron = document.getElementById('specChevron');
            const btn = document.getElementById('specializationDropdownBtn');
            
            menu.classList.remove('open');
            btn.classList.remove('focused');
            if (chevron) chevron.style.transform = '';
        }

        // Close dropdown when clicking outside
        document.addEventListener('click', function(e) {
            const menu = document.getElementById('auroraMenu');
            const btn = document.getElementById('loginDropdown');
            const chevron = document.getElementById('loginChevron');
            if (menu && menu.classList.contains('open') &&
                !menu.contains(e.target) && btn && !btn.contains(e.target)) {
                menu.classList.remove('open');
                if (chevron) chevron.style.transform = '';
            }
            
            // For specialization dropdown
            const specMenu = document.getElementById('specMenu');
            const specBtn = document.getElementById('specializationDropdownBtn');
            const specChevron = document.getElementById('specChevron');
            if (specMenu && specMenu.classList.contains('open') &&
                !specMenu.contains(e.target) && specBtn && !specBtn.contains(e.target)) {
                specMenu.classList.remove('open');
                specBtn.classList.remove('focused');
                if (specChevron) specChevron.style.transform = '';
            }
        });
    </script>
</body>
</html>
