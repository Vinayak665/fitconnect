                { title: "Quick Links", links: [{ label: "Find a Trainer", href: "/search" }, { label: "Become a Trainer", href: "/trainer/login?mode=signup" }, { label: "User Login", href: "/user-login" }] },
                { title: "About Us", links: [{ label: "Owner: Vinayak Babani", href: "#" }] }
            ];
            const contactInfo = [
                { icon: <i className="fas fa-envelope text-[#3ca2fa]"></i>, text: "support@fitconnect.com" },
                { icon: <i className="fas fa-phone text-[#3ca2fa]"></i>, text: "+91 6362596973" },
                { icon: <i className="fas fa-map-marker-alt text-[#3ca2fa]"></i>, text: "karwar, INDIA" },
