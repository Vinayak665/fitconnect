            return (
                <footer className="bg-neutral-950 relative h-fit rounded-[2.5rem] overflow-hidden m-4 md:m-8 border border-white/10 text-white">
                    <div className="max-w-7xl mx-auto p-10 md:p-14 z-40 relative">
                        <div className="grid grid-cols-1 md:grid-cols-3 gap-12 pb-12 text-center">
                            <div className="flex flex-col space-y-4 items-center">
                                <div className="flex items-center space-x-2">
                                    <span className="text-[#3ca2fa] text-3xl font-extrabold">&hearts;</span>
                                    <span className="text-3xl font-bold text-white">FitConnect</span>
