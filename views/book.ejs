<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Book a Session | FitConnect</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css?v=2">
    <%- include('partials/theme-logic') %>
    <style>
        .navbar-brand, .fitconnect-brand { color: #38bdf8 !important; -webkit-text-fill-color: #38bdf8 !important; background: none !important; }
        nav { background: rgba(2, 6, 23, 0.8) !important; backdrop-filter: blur(15px); border-bottom: 1px solid rgba(255,255,255,0.05); }
        .nav-link { color: rgba(255,255,255,0.8) !important; }
        .nav-link:hover, .nav-link.active { color: #38bdf8 !important; }

        body { background-color: #020617; color: white; min-height: 100vh; overflow-x: hidden; }
        .mesh-bg {
            background-image: 
                radial-gradient(at 0% 0%, rgba(56, 189, 248, 0.15) 0px, transparent 50%),
                radial-gradient(at 100% 0%, rgba(59, 130, 246, 0.15) 0px, transparent 50%),
                radial-gradient(at 100% 100%, rgba(14, 165, 233, 0.15) 0px, transparent 50%),
                radial-gradient(at 0% 100%, rgba(37, 99, 235, 0.15) 0px, transparent 50%);
            min-height: 100vh;
        }

        .glass-panel {
            background: rgba(15, 23, 42, 0.6) !important;
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.08) !important;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5) !important;
            border-radius: 1.5rem;
            color: white !important;
        }
        
        .form-label { color: rgba(255,255,255,0.9); }
        .form-control, .form-select { background: rgba(0,0,0,0.3) !important; border: 1px solid rgba(255,255,255,0.1) !important; color: white !important; }
        .form-control:focus, .form-select:focus { border-color: #38bdf8 !important; box-shadow: 0 0 0 .25rem rgba(56,189,248,.25) !important; }
        .text-muted { color: rgba(255,255,255,0.6) !important; }
        hr { border-color: rgba(255,255,255,0.1); }
        
        #booking-calendar-root { display: flex; flex-direction: column; width: 100%; overflow: hidden; }
        .custom-scrollbar::-webkit-scrollbar { width: 4px; }
        .custom-scrollbar::-webkit-scrollbar-track { background: #f1f1f1; border-radius: 10px; }
        .custom-scrollbar::-webkit-scrollbar-thumb { background: #3498db50; border-radius: 10px; }
        .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: #38bdf8; }
        .rdp-day_selected { background-color: #38bdf8 !important; color: white !important; }
    </style>
</head>
<body class="mesh-bg">
    <%- include('partials/notifications') %>
    <nav class="navbar navbar-expand-lg sticky-top">
        <div class="container d-flex align-items-center">
            <a class="navbar-brand me-auto" href="/"><i class="fas fa-dumbbell me-2"></i>FitConnect</a>
            <button onclick="toggleTheme()" class="btn btn-sm d-flex align-items-center gap-2 me-3 theme-toggle-btn" 
                    style="background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); color: inherit; padding: 6px 12px; border-radius: 20px;">
                <i class="fas fa-paint-brush"></i>
            </button>
            <a href="/search" class="btn btn-outline-info rounded-pill btn-sm px-3 shadow-sm"><i class="fas fa-arrow-left me-2"></i>Back to Search</a>
        </div>
    </nav>

    <div class="container py-5 my-3">
        <div class="row justify-content-center">
            <div class="col-lg-10">
                <div class="glass-panel p-4 p-md-5 animate-fade-up">
                    <div class="row">
                        <!-- Trainer Info Sidebar -->
                        <div class="col-md-5 mb-5 mb-md-0 border-end border-secondary border-opacity-25 pe-md-4">
                            <h3 class="fw-bold mb-4 text-white">You are booking:</h3>
                            <div class="text-center mb-4">
                                <% 
                                   let imgSrc = '/images/default-avatar.png'; 
                                   if(trainer.profile_image) {
                                      imgSrc = trainer.profile_image.startsWith('http') ? trainer.profile_image : '/uploads/' + trainer.profile_image;
                                   }
                                %>
                                <div class="position-relative d-inline-block">
                                    <div class="position-absolute w-100 h-100 rounded-circle bg-info opacity-25" style="filter: blur(15px); transform: scale(1.1);"></div>
                                    <img src="<%= imgSrc %>" class="rounded-circle shadow-lg mb-4 border border-info border-opacity-25 position-relative" style="width: 160px; height: 160px; object-fit: cover; object-position: center top; z-index: 2;" alt="<%= trainer.name %>" onerror="this.src='/images/default-avatar.png'">
                                </div>
                                <h4 class="fw-bold text-white"><%= trainer.name %></h4>
                                <span class="badge bg-info bg-opacity-10 border border-info border-opacity-25 text-info rounded-pill px-3 py-2 shadow-sm mt-2"><%= trainer.specialization %> Specialist</span>
                            </div>
                            
                            <hr class="opacity-25 my-4">
                            
                            <div class="d-flex justify-content-between mb-3 align-items-center">
                                <span class="text-muted"><i class="fas fa-map-marker-alt me-2 text-info"></i>Location</span>
                                <span class="fw-bold text-white"><%= trainer.city %></span>
                            </div>
                            <div class="d-flex justify-content-between mb-3 align-items-center">
                                <span class="text-muted"><i class="fas fa-briefcase me-2 text-info"></i>Experience</span>
                                <span class="fw-bold text-white"><%= trainer.experience %> Years</span>
                            </div>
                            <div class="d-flex justify-content-between mb-3 align-items-center">
                                <span class="text-muted"><i class="fas fa-phone me-2 text-success"></i>Contact</span>
                                <a href="tel:<%= trainer.contact_number %>" class="fw-bold text-success text-decoration-none">
                                    <%= trainer.contact_number || 'N/A' %>
                                </a>
                            </div>
                            
                            <div class="d-flex justify-content-between align-items-center mt-5 p-4 rounded-4 shadow-sm" style="background: rgba(0,0,0,0.3); border: 1px solid rgba(255,255,255,0.05);">
                                <span class="fw-bold text-white">Total Amount Due</span>
                                <span class="fw-bold text-success fs-3">₹<%= trainer.booking_amount %></span>
                            </div>
                            
                            <div class="alert mt-4 border-0 rounded-4" style="background: rgba(14, 165, 233, 0.1); border-left: 4px solid #38bdf8 !important;">
                                <i class="fas fa-info-circle me-2 text-info"></i> <span class="text-white small">Payment to be made directly to the trainer post-session.</span>
                            </div>
                        </div>

                        <!-- Booking Form -->
                        <div class="col-md-7 ps-md-5">
                            <h3 class="fw-bold mb-4 text-white">Your Details</h3>
                            <form action="/book/<%= trainer.id %>" method="POST">
                                <input type="hidden" name="amount" value="<%= trainer.booking_amount %>">
                                
                                <div class="mb-4">
                                    <label class="form-label fw-bold text-info small text-uppercase tracking-wider">Full Name</label>
                                    <input type="text" name="client_name" class="form-control py-3 rounded-3 shadow-sm" placeholder="John Doe" value="<%= locals.user ? user.name : '' %>" required>
                                </div>
                                <div class="row mb-4 g-3">
                                    <div class="col-md-6">
                                        <label class="form-label fw-bold text-info small text-uppercase tracking-wider">Phone Number</label>
                                        <input type="tel" name="client_phone" class="form-control py-3 rounded-3 shadow-sm" placeholder="+91 0000000000" value="<%= locals.user ? user.phone : '' %>" required>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label fw-bold text-info small text-uppercase tracking-wider">Email Address</label>
                                        <input type="email" name="client_email" class="form-control py-3 rounded-3 shadow-sm" placeholder="john@example.com" value="<%= locals.user ? user.email : '' %>" required>
                                    </div>
                                </div>
                                <div class="mb-5">
                                    <label class="form-label fw-bold text-info small text-uppercase" style="letter-spacing:0.08em;">Session Date &amp; Time</label>
                                    <input type="hidden" name="booking_date" id="hidden_booking_date" required>
                                    <p id="booking_date_feedback" class="text-danger small mt-2 d-none fw-bold"><i class="fas fa-exclamation-circle me-1"></i>Please select a date and time slot.</p>

                                    <!-- Native Booking Calendar -->
                                    <style>
                                    .booking-panel {
                                        display: flex;
                                        flex-direction: row;
                                        background: rgba(2,6,23,0.8);
                                        border: 1px solid rgba(255,255,255,0.1);
                                        border-radius: 1rem;
                                        overflow: hidden;
                                        min-height: 400px;
                                        margin-top: 0.75rem;
                                    }
                                    /* --- Calendar --- */
                                    .cal-section {
                                        flex: 1;
                                        padding: 1.5rem;
                                        border-right: 1px solid rgba(255,255,255,0.07);
                                    }
                                    .cal-header {
                                        display: flex;
                                        align-items: center;
                                        justify-content: space-between;
                                        margin-bottom: 1rem;
                                    }
                                    .cal-header span {
                                        font-weight: 700;
                                        font-size: 1rem;
                                        color: #fff;
                                    }
                                    .cal-nav-btn {
                                        background: rgba(255,255,255,0.08);
                                        border: none;
                                        color: #94a3b8;
                                        width: 32px;
                                        height: 32px;
                                        border-radius: 8px;
                                        cursor: pointer;
                                        font-size: 0.75rem;
                                        transition: background 0.2s, color 0.2s;
                                    }
                                    .cal-nav-btn:hover { background: rgba(56,189,248,0.2); color: #38bdf8; }
                                    .cal-grid { display: grid; grid-template-columns: repeat(7,1fr); gap: 4px; }
                                    .cal-weekday {
                                        text-align: center;
                                        font-size: 0.65rem;
                                        font-weight: 700;
                                        color: #64748b;
                                        text-transform: uppercase;
                                        padding: 4px 0 8px;
                                        letter-spacing: 0.06em;
                                    }
                                    .cal-day {
                                        aspect-ratio: 1;
                                        display: flex;
                                        align-items: center;
                                        justify-content: center;
                                        font-size: 0.8rem;
                                        border-radius: 8px;
                                        cursor: pointer;
                                        color: #cbd5e1;
                                        border: 1px solid transparent;
                                        transition: all 0.15s;
                                        background: transparent;
                                        user-select: none;
                                    }
                                    .cal-day:hover:not(.disabled):not(.empty) { background: rgba(14,165,233,0.15); border-color: #38bdf8; color: #38bdf8; }
                                    .cal-day.today { border-bottom: 2px solid #38bdf8; color: #38bdf8; font-weight: 700; }
                                    .cal-day.selected { background: #0ea5e9; color: #fff !important; font-weight: 700; border-color: #0ea5e9; box-shadow: 0 4px 15px rgba(14,165,233,0.4); }
                                    .cal-day.disabled { color: #334155; cursor: not-allowed; text-decoration: line-through; }
                                    .cal-day.empty { cursor: default; }
                                    /* --- Time Slots --- */
                                    .time-section {
                                        width: 200px;
                                        display: flex;
                                        flex-direction: column;
                                        background: rgba(0,0,0,0.3);
                                        max-height: 420px;
                                    }
                                    .time-header {
                                        padding: 1rem;
                                        border-bottom: 1px solid rgba(255,255,255,0.07);
                                        font-size: 0.65rem;
                                        font-weight: 800;
                                        text-transform: uppercase;
                                        letter-spacing: 0.1em;
                                        color: #64748b;
                                    }
                                    .time-list {
                                        flex: 1;
                                        overflow-y: auto;
                                        padding: 0.75rem;
                                        display: flex;
                                        flex-direction: column;
                                        gap: 6px;
                                        scrollbar-width: thin;
                                        scrollbar-color: rgba(56,189,248,0.3) transparent;
                                        max-height: 280px;
                                    }
                                    .time-list::-webkit-scrollbar { width: 4px; }
                                    .time-list::-webkit-scrollbar-thumb { background: rgba(56,189,248,0.3); border-radius: 4px; }
                                    .time-slot {
                                        padding: 8px 12px;
                                        border-radius: 8px;
                                        border: 1px solid rgba(255,255,255,0.08);
                                        background: rgba(255,255,255,0.04);
                                        color: #94a3b8;
                                        font-size: 0.8rem;
                                        font-weight: 600;
                                        cursor: pointer;
                                        transition: all 0.15s;
                                        text-align: center;
                                        letter-spacing: 0.03em;
                                    }
                                    .time-slot:hover:not(.disabled) { background: rgba(14,165,233,0.15); border-color: #38bdf8; color: #38bdf8; }
                                    .time-slot.selected { background: #0ea5e9; border-color: #0ea5e9; color: #fff; box-shadow: 0 2px 12px rgba(14,165,233,0.4); }
                                    .time-slot.disabled { 
                                        opacity: 0.3; 
                                        cursor: not-allowed; 
                                        background: rgba(255,255,255,0.02); 
                                        text-decoration: line-through; 
                                        border-color: transparent;
                                    }
                                    .time-slot.disabled:hover { background: rgba(255,255,255,0.02); color: #94a3b8; }
                                    /* --- Confirm Button --- */
                                    .confirm-dt-btn {
                                        margin: 0.75rem;
                                        padding: 10px 14px;
                                        border-radius: 10px;
                                        border: none;
                                        background: linear-gradient(135deg, #10b981, #059669);
                                        color: #fff;
                                        font-size: 0.82rem;
                                        font-weight: 700;
                                        cursor: pointer;
                                        display: flex;
                                        align-items: center;
                                        justify-content: center;
                                        gap: 8px;
                                        transition: all 0.2s ease;
                                        box-shadow: 0 4px 15px rgba(16,185,129,0.3);
                                        max-height: 0;
                                        overflow: hidden;
                                        opacity: 0;
                                        margin-top: 0;
                                        margin-bottom: 0;
                                        padding-top: 0;
                                        padding-bottom: 0;
                                    }
                                    .confirm-dt-btn.visible {
                                        max-height: 60px;
                                        opacity: 1;
                                        padding: 10px 14px;
                                        margin: 0.75rem;
                                        transition: max-height 0.35s ease, opacity 0.3s ease, padding 0.3s ease, margin 0.3s ease, box-shadow 0.2s ease;
                                    }
                                    .confirm-dt-btn:hover { transform: translateY(-1px); box-shadow: 0 6px 20px rgba(16,185,129,0.45); }
                                    /* --- Footer --- */
                                    .booking-footer {
                                        border-top: 1px solid rgba(56,189,248,0.1);
                                        padding: 1rem 1.5rem;
                                        display: flex;
                                        align-items: center;
                                        justify-content: space-between;
                                        background: rgba(0,0,0,0.4);
                                        grid-column: 1 / -1;
                                        flex-shrink: 0;
                                    }
                                    .booking-footer-wrap {
                                        display: flex;
                                        flex-direction: column;
                                    }
                                    .booking-footer-wrap .footer-label { font-size: 0.7rem; color: #64748b; text-transform: uppercase; letter-spacing: 0.08em; }
                                    .booking-footer-wrap .footer-value { font-size: 0.95rem; font-weight: 700; color: #fff; margin-top: 2px; }
                                    .booking-footer-wrap .footer-value span { color: #38bdf8; }
                                    .ready-badge {
                                        display: flex;
                                        align-items: center;
                                        gap: 6px;
                                        font-size: 0.65rem;
                                        font-weight: 800;
                                        text-transform: uppercase;
                                        letter-spacing: 0.08em;
                                        color: #4ade80;
                                    }
                                    .ready-dot {
                                        width: 8px; height: 8px;
                                        border-radius: 50%;
                                        background: #4ade80;
                                        animation: pulse 1.5s infinite;
                                    }
                                    @keyframes pulse { 0%,100%{opacity:1;transform:scale(1)} 50%{opacity:.5;transform:scale(1.3)} }
                                    /* --- Toggle animation --- */
                                    .calendar-wrapper {
                                        overflow: hidden;
                                        max-height: 0;
                                        transition: max-height 0.55s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.4s ease;
                                        opacity: 0;
                                    }
                                    .calendar-wrapper.open {
                                        max-height: 700px;
                                        opacity: 1;
                                    }
                                    .pick-dt-btn {
                                        width: 100%;
                                        padding: 14px 24px;
                                        background: rgba(14, 165, 233, 0.1);
                                        border: 1.5px dashed rgba(56,189,248,0.4);
                                        border-radius: 12px;
                                        color: #38bdf8;
                                        font-size: 0.95rem;
                                        font-weight: 700;
                                        cursor: pointer;
                                        display: flex;
                                        align-items: center;
                                        justify-content: center;
                                        gap: 10px;
                                        transition: all 0.2s ease;
                                        margin-top: 0.75rem;
                                    }
                                    .pick-dt-btn:hover {
                                        background: rgba(14, 165, 233, 0.2);
                                        border-color: #38bdf8;
                                        transform: translateY(-1px);
                                        box-shadow: 0 8px 20px rgba(14,165,233,0.15);
                                    }
                                    .pick-dt-btn.selected-state {
                                        background: rgba(74, 222, 128, 0.1);
                                        border-color: rgba(74, 222, 128, 0.5);
                                        color: #4ade80;
                                    }
                                    @media (max-width: 576px) {
                                        .booking-panel { flex-direction: column; }
                                        .time-section { width: 100%; min-height: 200px; border-right: none; border-top: 1px solid rgba(255,255,255,0.07); }
                                        .time-list { flex-direction: row; flex-wrap: wrap; max-height: 160px; }
                                        .time-slot { flex: 0 0 calc(25% - 6px); }
                                    }
                                    </style>

                                    <!-- Trigger Button -->
                                    <button type="button" id="pick-dt-btn" class="pick-dt-btn">
                                        <i class="fas fa-calendar-alt"></i>
                                        <span id="pick-dt-label">Click to Pick Date &amp; Time</span>
                                        <i class="fas fa-chevron-down" id="pick-dt-chevron" style="font-size:0.7rem;transition:transform 0.3s;"></i>
                                    </button>

                                    <div class="calendar-wrapper" id="calendar-wrapper">
                                    <div class="booking-panel" id="booking-panel">
                                        <!-- Calendar Area -->
                                        <div class="cal-section">
                                            <div class="cal-header">
                                                <button type="button" class="cal-nav-btn" id="cal-prev"><i class="fas fa-chevron-left"></i></button>
                                                <span id="cal-month-label"></span>
                                                <button type="button" class="cal-nav-btn" id="cal-next"><i class="fas fa-chevron-right"></i></button>
                                            </div>
                                            <div class="cal-grid" id="cal-grid">
                                                <div class="cal-weekday">Su</div>
                                                <div class="cal-weekday">Mo</div>
                                                <div class="cal-weekday">Tu</div>
                                                <div class="cal-weekday">We</div>
                                                <div class="cal-weekday">Th</div>
                                                <div class="cal-weekday">Fr</div>
                                                <div class="cal-weekday">Sa</div>
                                            </div>
                                            <!-- Footer inside panel -->
                                            <div class="booking-footer mt-3">
                                                <div class="booking-footer-wrap">
                                                    <span class="footer-label" id="footer-label">Select date &amp; time</span>
                                                    <span class="footer-value" id="footer-value" style="color:#64748b;font-size:0.8rem;">No selection yet</span>
                                                </div>
                                                <div class="ready-badge" id="ready-badge" style="display:none!important;">
                                                    <span class="ready-dot"></span> Ready to Book
                                                </div>
                                            </div>
                                        </div>
                                        <!-- Time Slots -->
                                        <div class="time-section">
                                            <div class="time-header"><i class="fas fa-clock me-1" style="color:#38bdf8;"></i> Available Slots</div>
                                            <div class="time-list" id="time-list"></div>
                                            <button type="button" id="confirm-dt-btn" class="confirm-dt-btn">
                                                <i class="fas fa-check-circle"></i> Confirm Date &amp; Time
                                            </button>
                                        </div>
                                    </div>
                                    </div><!-- /calendar-wrapper -->

                                    <script>
                                    (function() {
                                        // State
                                        const occupiedSlots = JSON.parse('<%- locals.occupiedSlots || "[]" %>');
                                        let viewYear, viewMonth, selectedDate = null, selectedTime = null;
                                        const today = new Date();
                                        today.setHours(0,0,0,0);
                                        viewYear = today.getFullYear();
                                        viewMonth = today.getMonth();

                                        const MONTHS = ['January','February','March','April','May','June','July','August','September','October','November','December'];

                                        // Generate time slots 5:00 AM to 11:00 PM (15-min intervals)
                                        const timeSlots = [];
                                        for (let i = 0; i <= 72; i++) {
                                            const totalMin = i * 15;
                                            const h = Math.floor(totalMin / 60) + 5;
                                            const m = totalMin % 60;
                                            timeSlots.push(
                                                String(h).padStart(2,'0') + ':' + String(m).padStart(2,'0')
                                            );
                                        }

                                        function formatTime12Hour(t) {
                                            if (!t) return '';
                                            const parts = t.split(':');
                                            let h = parseInt(parts[0], 10);
                                            const m = parts[1];
                                            const ampm = h >= 12 ? 'PM' : 'AM';
                                            h = h % 12;
                                            h = h ? h : 12;
                                            return h + ':' + m + ' ' + ampm;
                                        }

                                        // Function to update time slot availability
                                        function updateTimeSlotAvailability() {
                                            if (!selectedDate) return;
                                            
                                            const y = selectedDate.getFullYear();
                                            const mo = String(selectedDate.getMonth()+1).padStart(2,'0');
                                            const d = String(selectedDate.getDate()).padStart(2,'0');
                                            const datePrefix = y + '-' + mo + '-' + d;

                                            document.querySelectorAll('.time-slot').forEach(function(el) {
                                                const time = el.dataset.time;
                                                // Normalize both to UTC for a fair comparison
                                                const currentSlotTime = new Date(datePrefix + 'T' + time + ':00Z').getTime();
                                                
                                                // Check if any occupied slot is within 2 hours (7200000 ms) of THIS slot
                                                const isOccupied = occupiedSlots.some(s => {
                                                    // Normalize occupied slot to UTC
                                                    const occStr = s.includes(' ') ? s.replace(' ', 'T') : s;
                                                    const cleanOccStr = occStr.endsWith('Z') || occStr.includes('+') ? occStr : occStr + 'Z';
                                                    const occTime = new Date(cleanOccStr).getTime();
                                                    
                                                    const diff = Math.abs(occTime - currentSlotTime);
                                                    // FORWARD-ONLY BLOCKING:
                                                    // This slot is blocked ONLY if it starts AT or AFTER an existing one
                                                    // and within the 2-hour duration (7200000ms).
                                                    return currentSlotTime >= occTime && currentSlotTime < occTime + 7200000;
                                                });
                                                
                                                if (isOccupied) {
                                                    el.classList.add('disabled');
                                                    if (selectedTime === time) {
                                                        selectedTime = null;
                                                        el.classList.remove('selected');
                                                    }
                                                } else {
                                                    el.classList.remove('disabled');
                                                }
                                            });
                                        }

                                        // Render time slots (static base)
                                        const timeList = document.getElementById('time-list');
                                        timeSlots.forEach(function(t) {
                                            const el = document.createElement('div');
                                            el.className = 'time-slot';
                                            el.textContent = formatTime12Hour(t);
                                            el.dataset.time = t;
                                            el.addEventListener('click', function() {
                                                if (el.classList.contains('disabled')) return;
                                                document.querySelectorAll('.time-slot').forEach(function(s){ s.classList.remove('selected'); });
                                                el.classList.add('selected');
                                                selectedTime = t;
                                                updateHiddenInput();
                                            });
                                            timeList.appendChild(el);
                                        });

                                        function renderCalendar() {
                                            const grid = document.getElementById('cal-grid');
                                            // Remove all day cells (keep weekday headers = first 7 children)
                                            const children = Array.from(grid.children);
                                            children.slice(7).forEach(function(c){ c.remove(); });

                                            document.getElementById('cal-month-label').textContent = MONTHS[viewMonth] + ' ' + viewYear;

                                            const firstDay = new Date(viewYear, viewMonth, 1).getDay();
                                            const daysInMonth = new Date(viewYear, viewMonth + 1, 0).getDate();

                                            // Empty cells
                                            for (let i = 0; i < firstDay; i++) {
                                                const empty = document.createElement('div');
                                                empty.className = 'cal-day empty';
                                                grid.appendChild(empty);
                                            }

                                            for (let d = 1; d <= daysInMonth; d++) {
                                                const cellDate = new Date(viewYear, viewMonth, d);
                                                cellDate.setHours(0,0,0,0);
                                                const isPast = cellDate < today;
                                                const isToday = cellDate.getTime() === today.getTime();
                                                const isSelected = selectedDate && cellDate.getTime() === selectedDate.getTime();

                                                const el = document.createElement('div');
                                                el.className = 'cal-day' +
                                                    (isPast ? ' disabled' : '') +
                                                    (isToday ? ' today' : '') +
                                                    (isSelected ? ' selected' : '');
                                                el.textContent = d;

                                                if (!isPast) {
                                                    el.addEventListener('click', function() {
                                                        selectedDate = new Date(viewYear, viewMonth, d);
                                                        renderCalendar();
                                                        updateTimeSlotAvailability();
                                                        updateHiddenInput();
                                                    });
                                                }
                                                grid.appendChild(el);
                                            }
                                        }

                                        function updateHiddenInput() {
                                            const input = document.getElementById('hidden_booking_date');
                                            const footer = document.getElementById('footer-value');
                                            const footerLabel = document.getElementById('footer-label');
                                            const badge = document.getElementById('ready-badge');

                                            if (selectedDate && selectedTime) {
                                                const y = selectedDate.getFullYear();
                                                const mo = String(selectedDate.getMonth()+1).padStart(2,'0');
                                                const d = String(selectedDate.getDate()).padStart(2,'0');
                                                input.value = y + '-' + mo + '-' + d + 'T' + selectedTime;

                                                const displayDate = selectedDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
                                                footerLabel.textContent = 'Session booked for';
                                                footer.innerHTML = '<span>' + displayDate + '</span> at <span>' + formatTime12Hour(selectedTime) + '</span>';
                                                badge.style.removeProperty('display');
                                                document.getElementById('booking_date_feedback').classList.add('d-none');
                                            } else if (selectedDate) {
                                                const displayDate = selectedDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
                                                footerLabel.textContent = 'Date selected:';
                                                footer.innerHTML = '<span>' + displayDate + '</span> — pick a time';
                                                badge.style.display = 'none!important';
                                            } else {
                                                footerLabel.textContent = 'Select date & time';
                                                footer.textContent = 'No selection yet';
                                                footer.style.color = '#64748b';
                                                badge.style.display = 'none!important';
                                            }
                                        }

                                        document.getElementById('cal-prev').addEventListener('click', function() {
                                            viewMonth--;
                                            if (viewMonth < 0) { viewMonth = 11; viewYear--; }
                                            renderCalendar();
                                        });
                                        document.getElementById('cal-next').addEventListener('click', function() {
                                            viewMonth++;
                                            if (viewMonth > 11) { viewMonth = 0; viewYear++; }
                                            renderCalendar();
                                        });

                                        // Toggle calendar on button click
                                        var calOpen = false;
                                        document.getElementById('pick-dt-btn').addEventListener('click', function() {
                                            calOpen = !calOpen;
                                            document.getElementById('calendar-wrapper').classList.toggle('open', calOpen);
                                            document.getElementById('pick-dt-chevron').style.transform = calOpen ? 'rotate(180deg)' : '';
                                            if (calOpen) {
                                                setTimeout(function() {
                                                    document.getElementById('calendar-wrapper').scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                                                }, 100);
                                            }
                                        });

                                        // Form validation hook
                                        document.querySelector('form').addEventListener('submit', function(e) {
                                            const input = document.getElementById('hidden_booking_date');
                                            if (!input.value) {
                                                e.preventDefault();
                                                document.getElementById('booking_date_feedback').classList.remove('d-none');
                                                // Auto-open and scroll to calendar
                                                if (!calOpen) {
                                                    calOpen = true;
                                                    document.getElementById('calendar-wrapper').classList.add('open');
                                                    document.getElementById('pick-dt-chevron').style.transform = 'rotate(180deg)';
                                                }
                                                document.getElementById('pick-dt-btn').scrollIntoView({ behavior: 'smooth', block: 'center' });
                                            }
                                        });

                                        // Update trigger button label after selection
                                        function updateTriggerBtn() {
                                            var btn = document.getElementById('pick-dt-btn');
                                            var label = document.getElementById('pick-dt-label');
                                            var confirmBtn = document.getElementById('confirm-dt-btn');
                                            if (selectedDate && selectedTime) {
                                                var d = selectedDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
                                                label.textContent = d + ' at ' + formatTime12Hour(selectedTime);
                                                btn.classList.add('selected-state');
                                                btn.querySelector('i').className = 'fas fa-check-circle';
                                                // Show confirm button
                                                confirmBtn.classList.add('visible');
                                            } else if (selectedDate) {
                                                var d = selectedDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
                                                label.textContent = d + ' — pick a time';
                                                btn.classList.remove('selected-state');
                                                btn.querySelector('i').className = 'fas fa-calendar-alt';
                                                confirmBtn.classList.remove('visible');
                                            }
                                        }

                                        // Confirm button closes the calendar
                                        document.getElementById('confirm-dt-btn').addEventListener('click', function() {
                                            calOpen = false;
                                            document.getElementById('calendar-wrapper').classList.remove('open');
                                            document.getElementById('pick-dt-chevron').style.transform = '';
                                            document.getElementById('pick-dt-btn').scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                                        });

                                        // Patch updateHiddenInput to also update trigger
                                        var _origUpdate = updateHiddenInput;
                                        updateHiddenInput = function() {
                                            _origUpdate();
                                            updateTriggerBtn();
                                        };

                                        renderCalendar();
                                    })();
                                    </script>
                                </div>



                                <div class="mb-5">
                                    <label class="form-label fw-bold text-info small text-uppercase" style="letter-spacing:0.08em;">Payment Method</label>
                                    <div class="row g-3">
                                        <div class="col-md-6">
                                            <input type="radio" class="btn-check" name="payment_method" id="pay_online" value="online" checked autocomplete="off">
                                            <label class="btn btn-outline-info w-100 py-3 rounded-4 d-flex flex-column align-items-center gap-2 border-opacity-25" for="pay_online">
                                                <i class="fas fa-qrcode fs-3"></i>
                                                <span class="fw-bold">Online (UPI/QR)</span>
                                                <small class="opacity-75">Pay via QR code instantly</small>
                                            </label>
                                        </div>
                                        <div class="col-md-6">
                                            <input type="radio" class="btn-check" name="payment_method" id="pay_offline" value="offline" autocomplete="off">
                                            <label class="btn btn-outline-secondary w-100 py-3 rounded-4 d-flex flex-column align-items-center gap-2 border-opacity-25" for="pay_offline">
                                                <i class="fas fa-hand-holding-usd fs-3"></i>
                                                <span class="fw-bold">Offline Payment</span>
                                                <small class="opacity-75">Pay after the session to the trainer</small>
                                            </label>
                                        </div>
                                    </div>
                                </div>

                                <button type="submit" class="btn w-100 py-3 fs-5 mt-3 fw-bold rounded-pill shadow-lg text-white" style="background: linear-gradient(135deg, #10b981 0%, #059669 100%); transition: transform 0.3s;" onmouseover="this.style.transform='translateY(-2px)'" onmouseout="this.style.transform='translateY(0)'"><i class="fas fa-calendar-check me-2"></i>Confirm Booking Details</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>



    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('visible');
                    }
                });
            }, { threshold: 0.1 });

            document.querySelectorAll('.animate-fade-up').forEach(el => observer.observe(el));
        });
    </script>
</body>
</html>
