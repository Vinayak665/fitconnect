<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FitConnect - Find Your Perfect Fitness Trainer</title>
    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- FontAwesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Swiper CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@10/swiper-bundle.min.css" />
    <!-- Custom CSS -->
    <link rel="stylesheet" href="/css/style.css?v=20">
    <!-- Tailwind (must load before body to prevent unstyled flash) -->
    <script src="https://cdn.tailwindcss.com"></script>
    <%- include('partials/theme-logic') %>
    <style id="critical-homepage-styles">
        /* CRITICAL MESH BG: Defined at the top to prevent flicker */
        .mesh-bg {
            background-color: #020617;
            background-image: 
                radial-gradient(at 0% 0%, rgba(56, 189, 248, 0.15) 0px, transparent 50%),
                radial-gradient(at 100% 0%, rgba(59, 130, 246, 0.15) 0px, transparent 50%),
                radial-gradient(at 100% 100%, rgba(14, 165, 233, 0.15) 0px, transparent 50%),
                radial-gradient(at 0% 100%, rgba(37, 99, 235, 0.15) 0px, transparent 50%);
        }
    </style>
    <style>
        .navbar-brand,
        .fitconnect-brand {
            color: #38bdf8 !important;
            -webkit-text-fill-color: #38bdf8 !important;
            background: none !important;
            font-size: 1.5rem !important;
            font-weight: 800 !important;
        }


        .aurora-dropdown {
            background: rgba(2, 6, 23, 0.92) !important;
            backdrop-filter: blur(24px) !important;
            -webkit-backdrop-filter: blur(24px) !important;
            border: 1px solid rgba(56, 189, 248, 0.2) !important;
            border-radius: 16px !important;
            box-shadow: 0 20px 60px rgba(0,0,0,0.6), 0 0 0 1px rgba(56,189,248,0.08), inset 0 1px 0 rgba(255,255,255,0.05) !important;
            padding: 8px !important;
            min-width: 220px !important;
            margin-top: 10px !important;
            overflow: hidden;
            display: block !important;
            opacity: 0;
            transform: translateY(-10px) scale(0.97);
            pointer-events: none;
            transition: opacity 0.22s cubic-bezier(0.16,1,0.3,1), transform 0.22s cubic-bezier(0.16,1,0.3,1);
            visibility: hidden;
        }
        .aurora-dropdown.open {
            opacity: 1;
            transform: translateY(0) scale(1);
            pointer-events: auto;
            visibility: visible;
        }
        .aurora-dropdown-item {
            display: flex !important;
            align-items: center !important;
            gap: 12px !important;
            padding: 11px 14px !important;
            border-radius: 10px !important;
            color: rgba(255,255,255,0.85) !important;
            font-weight: 600 !important;
            font-size: 0.9rem !important;
            text-decoration: none !important;
            transition: background 0.18s ease, color 0.18s ease, transform 0.15s ease !important;
            background: transparent !important;
        }
        .aurora-dropdown-item:hover {
            background: rgba(56, 189, 248, 0.12) !important;
            color: #38bdf8 !important;
            transform: translateX(3px) !important;
        }
        .aurora-dropdown-item .item-icon {
            width: 32px;
            height: 32px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.85rem;
            flex-shrink: 0;
        }
        .aurora-divider {
            height: 1px;
            background: linear-gradient(to right, transparent, rgba(56,189,248,0.2), transparent);
            margin: 6px 8px;
        }
        .aurora-dropdown-label {
            font-size: 0.65rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.12em;
            color: #475569;
            padding: 4px 14px 2px;
        }
        /* Login button glow */
        .login-btn-aurora {
            background: linear-gradient(135deg, rgba(14,165,233,0.15), rgba(99,102,241,0.15)) !important;
            border: 1px solid rgba(56,189,248,0.35) !important;
            color: #38bdf8 !important;
            border-radius: 50px !important;
            font-weight: 700 !important;
            transition: all 0.25s ease !important;
            padding: 8px 22px !important;
        }
        .login-btn-aurora:hover {
            background: linear-gradient(135deg, rgba(14,165,233,0.3), rgba(99,102,241,0.3)) !important;
            border-color: #38bdf8 !important;
            box-shadow: 0 0 20px rgba(56,189,248,0.25) !important;
            color: #fff !important;
        }
        .login-btn-aurora::after { display: none !important; }

        /* Classic Overrides for Index */
        .theme-classic .mesh-bg {
            background-color: #ffffff !important;
            background-image: none !important;
            padding-bottom: 100px !important;
        }
        .theme-classic .text-gradient {
            background-image: linear-gradient(to right, #0F172A, #C2410C) !important;
        }
        .theme-classic .inline-block.border-sky-400\/30 {
            border-color: #E2E8F0 !important;
            background-color: #F1F5F9 !important;
        }
        .theme-classic .inline-block.border-sky-400\/30 span {
            color: #475569 !important;
        }
        .theme-classic h1 {
            color: #0F172A !important;
            letter-spacing: -0.02em !important;
        }
        .theme-classic p.text-slate-300 {
            color: #475569 !important;
        }
        .theme-classic .bg-[#020617] {
            background-color: #ffffff !important;
        }
        .theme-classic .border-white\/5 {
            border-color: #E2E8F0 !important;
        }
        .theme-classic .theme-classic-btn-primary {
            color: #ffffff !important;
            background-color: var(--primary, #0F172A) !important;
        }
        .theme-classic .theme-classic-btn-primary i {
            color: #ffffff !important;
        }
        .theme-classic .btn-trainer-join {
            color: #0F172A !important;
            border-color: #0F172A !important;
        }
        .theme-classic .btn-trainer-join:hover {
            background-color: #0F172A !important;
            color: #ffffff !important;
        }

    </style>
</head>

