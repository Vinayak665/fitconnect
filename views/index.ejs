    <link rel="stylesheet" href="/css/style.css?v=20">
    <!-- Tailwind (must load before body to prevent unstyled flash) -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Cache buster: force reload if browser has stale cached version -->
    <script>
        (function() {
            var PAGE_VER = 'fc_nav_v3';
            // Force reload if stale version is cached
            if (localStorage.getItem('fc_page_ver') !== PAGE_VER) {
                localStorage.setItem('fc_page_ver', PAGE_VER);
                // Only reload if we haven't just reloaded (avoid infinite loop)
                if (!sessionStorage.getItem('fc_reloaded_' + PAGE_VER)) {
                    sessionStorage.setItem('fc_reloaded_' + PAGE_VER, '1');
                    window.location.reload(true);
                }
            }
            // Also handle BFCache (back button)
            window.addEventListener('pageshow', function(e) {
                if (e.persisted) { window.location.reload(true); }
            });
        })();
    </script>
    <!-- Theme Engine (Locked to Aurora) -->
<style>
    /* Hide the theme toggle button everywhere */
    .theme-toggle-btn, .theme-toggle-floating {
        display: none !important;
    }
</style>
<script>
    (function() {
        // Enforce Aurora theme globally
        document.documentElement.classList.remove('theme-classic');
        document.documentElement.classList.add('theme-aurora');
        localStorage.setItem('fitconnect-theme', 'aurora');
        
        // Remove classic theme stylesheet if it was somehow loaded
        const classicLink = document.getElementById('classic-theme-link');
        if (classicLink) classicLink.remove();
    })();

    // Dummy function so existing onclick handlers don't throw errors
    function toggleTheme() {
        console.log('Theme switching is disabled. Aurora theme is enforced.');
    }
</script>
    <style id="critical-homepage-styles">
