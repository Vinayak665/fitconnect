<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FitConnect - Trainer Portal</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <%- include('../partials/theme-logic') %>
    <style id="fouc-prevention">
        body { opacity: 0 !important; }
        body.revealed { opacity: 1 !important; transition: opacity 0.4s ease-in; }
        
        /* Disable all transitions initially to prevent flicker */
        .container * { transition: none !important; animation: none !important; }
        
        /* Re-enable transitions only when page is ready */
        body.ready .container * { transition: all 0.6s ease-in-out !important; }
        body.ready .sign-up { animation: move 0.6s !important; }
    </style>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700&display=swap');

        *{ margin: 0; padding: 0; box-sizing: border-box; font-family: 'Montserrat', sans-serif; }
        body { 
            background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
            display: flex; 
            align-items: center; 
            justify-content: center; 
            flex-direction: column; 
            min-height: 100vh; 
            position: relative;
            overflow: hidden;
        }
        
        .nav-home {
            position: absolute;
            top: 20px;
            left: 20px;
            text-decoration: none;
            color: #fff;
            font-weight: 600;
            font-size: 14px;
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(10px);
            padding: 10px 15px;
            border-radius: 8px;
            border: 1px solid rgba(255, 255, 255, 0.2);
            box-shadow: 0 4px 15px rgba(0,0,0,0.2);
            z-index: 100;
            transition: all 0.3s ease;
        }
        .nav-home:hover {
            background: rgba(255, 255, 255, 0.2);
            transform: translateY(-2px);
        }

        .container {
            background-color: #fff; border-radius: 30px; box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5), 0 0 0 1px rgba(255, 255, 255, 0.1); 
            position: relative; overflow: hidden; width: 850px; max-width: 100%; min-height: 560px; z-index: 10;
        }
        
        .container p{ font-size: 14px; line-height: 20px; letter-spacing: 0.3px; margin: 20px 0; }
        .container span{ font-size: 12px; }
        .container a{ color: #333; font-size: 13px; text-decoration: none; margin: 15px 0 10px; }
        .container button{ background-color: #0ea5e9; color: #fff; font-size: 12px; padding: 10px 45px; border: 1px solid transparent; border-radius: 8px; font-weight: 600; letter-spacing: 0.5px; text-transform: uppercase; margin-top: 10px; cursor: pointer; transition: all 0.3s; }
        .container button.hidden{ background-color: transparent; border-color: #fff; }
        
        .container form{ background-color: #fff; display: flex; align-items: center; justify-content: center; flex-direction: column; padding: 0 40px; height: 100%; text-align: center; }
        .container input, .container select { background-color: #eee; border: none; margin: 8px 0; padding: 10px 15px; font-size: 13px; border-radius: 8px; width: 100%; outline: none; }
        
        /* Adjusted for the larger trainer form */
        .form-scroller { width: 100%; max-height: 420px; overflow-y: auto; padding-right: 10px; overflow-x: hidden;}
        .form-scroller::-webkit-scrollbar { width: 4px; }
        .form-scroller::-webkit-scrollbar-track { background: transparent; }
        .form-scroller::-webkit-scrollbar-thumb { background-color: rgba(14, 165, 233, 0.5); border-radius: 4px; }
        .form-container.sign-up input, .form-container.sign-up select { margin: 5px 0; padding: 8px 12px; }

        .form-container{ position: absolute; top: 0; height: 100%; transition: all 0.6s ease-in-out; }
        .sign-in{ left: 0; width: 50%; z-index: 2; visibility: visible; pointer-events: auto; transition: all 0.6s ease-in-out, visibility 0s 0s; }
        .container.active .sign-in{ transform: translateX(100%); visibility: hidden; pointer-events: none; transition: all 0.6s ease-in-out, visibility 0s 0.6s; }
        .sign-up{ left: 0; width: 50%; opacity: 0; z-index: 1; visibility: hidden; pointer-events: none; transition: all 0.6s ease-in-out, visibility 0s 0.6s; }
        .container.active .sign-up{ transform: translateX(100%); opacity: 1; z-index: 5; animation: move 0.6s; visibility: visible; pointer-events: auto; transition: all 0.6s ease-in-out, visibility 0s 0s; }

        @keyframes move{
            0%, 49.99%{ opacity: 0; z-index: 1; }
            50%, 100%{ opacity: 1; z-index: 5; }
        }

        .social-icons{ margin: 20px 0; }
        .social-icons a{ border: 1px solid #ccc; border-radius: 20%; display: inline-flex; justify-content: center; align-items: center; margin: 0 3px; width: 40px; height: 40px; }

        .toggle-container{ position: absolute; top: 0; left: 50%; width: 50%; height: 100%; overflow: hidden; transition: all 0.6s ease-in-out; border-radius: 150px 0 0 100px; z-index: 1000; }
        .container.active .toggle-container{ transform: translateX(-100%); border-radius: 0 150px 100px 0; }
        .toggle{ background-color: #0ea5e9; height: 100%; background: linear-gradient(135deg, #0ea5e9, #6366f1); color: #fff; position: relative; left: -100%; height: 100%; width: 200%; transform: translateX(0); transition: all 0.6s ease-in-out; }
        .container.active .toggle{ transform: translateX(50%); }
        .toggle-panel{ position: absolute; width: 50%; height: 100%; display: flex; align-items: center; justify-content: center; flex-direction: column; padding: 0 30px; text-align: center; top: 0; transform: translateX(0); transition: all 0.6s ease-in-out; }
        .toggle-left{ transform: translateX(-200%); }
        .container.active .toggle-left{ transform: translateX(0); }
        .toggle-right{ right: 0; transform: translateX(0); }
        .container.active .toggle-right{ transform: translateX(200%); }

        /* Clean Background applied via CSS */
        
        .file-label {
            font-size: 11px;
            color: #666;
            text-align: left;
            width: 100%;
            margin-top: 5px;
            margin-bottom: -2px;
            display: block;
        }

        /* Password Toggle Styles */
        .password-wrapper {
            position: relative;
            width: 100%;
        }
        .password-wrapper .toggle-password {
            position: absolute;
            right: 12px;
            top: 50%;
            transform: translateY(-50%);
            cursor: pointer;
            color: #666;
            z-index: 10;
            padding: 5px;
            font-size: 14px;
            transition: color 0.2s;
        }
        .password-wrapper .toggle-password:hover {
            color: #0ea5e9;
        }
        .password-wrapper input {
            padding-right: 40px !important;
        }

    </style>
    <% if (typeof mode !== 'undefined' && mode === 'signup') { %>
    <style>
        /* Force Signup Layout Immediately */
        .container.active .sign-in { transform: translateX(100%) !important; color: transparent !important; }
        .container.active .sign-in * { visibility: hidden !important; }
        .container.active .sign-up { transform: translateX(100%) !important; opacity: 1 !important; visibility: visible !important; z-index: 5 !important; }
        .container.active .toggle-container { transform: translateX(-100%) !important; border-radius: 0 150px 100px 0 !important; }
        .container.active .toggle { transform: translateX(50%) !important; }
        .container.active .toggle-left { transform: translateX(0) !important; }
        .container.active .toggle-right { transform: translateX(200%) !important; }
    </style>
    <% } %>
</head>
<body>
    <%- include('../partials/notifications') %>
    <!-- Clean Background applied via CSS -->

    <a href="/" class="nav-home"><i class="fas fa-arrow-left"></i> Home</a>
    
    <div style="position: fixed; top: 20px; right: 20px; z-index: 1000;">
        <button onclick="toggleTheme()" class="btn btn-sm d-flex align-items-center gap-2 theme-toggle-btn" 
                style="background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2); color: white; padding: 10px 15px; border-radius: 8px; backdrop-filter: blur(10px);">
            <i class="fas fa-paint-brush"></i>
        </button>
    </div>

    <div class="container <%= typeof mode !== 'undefined' && mode === 'signup' ? 'active' : '' %>" id="container" style="visibility:hidden;">
        <!-- Apply Form -->
        <div class="form-container sign-up">
            <form action="/trainer/request" method="POST" enctype="multipart/form-data">
                <h1 style="margin-top: 10px;">Apply as Trainer</h1>
                <span>Start your coaching journey</span>
                
                <div class="form-scroller">
                    <div style="display:flex; gap:8px;">
                        <input type="text" name="name" placeholder="Full Name" required>
                        <input type="email" name="email" placeholder="Email Address" required>
                    </div>
                    <div style="display:flex; gap:8px;">
                        <input type="tel" name="contact_number" placeholder="Phone" required oninput="this.value = this.value.replace(/[^0-9]/g, '')">
                        <input type="text" name="city" placeholder="City" required>
                    </div>
                    
                    <select name="specialization" required>
                        <option value="">Select Specialization</option>
                        <option value="Weight Loss">Weight Loss</option>
                        <option value="Muscle Gain">Muscle Gain</option>
                        <option value="Yoga">Yoga</option>
                        <option value="CrossFit">CrossFit</option>
                        <option value="Nutrition">Nutrition</option>
                    </select>
                    
                    <div style="display:flex; gap:8px;">
                        <input type="number" name="experience" placeholder="Exp (Years)" required>
                        <input type="number" name="booking_amount" placeholder="Session Rate (₹)" required>
                    </div>

                    <label class="file-label"><i class="fas fa-camera"></i> Profile Photo</label>
                    <input type="file" name="profile_image" accept="image/*">

                    <label class="file-label"><i class="fas fa-file-pdf"></i> Certifications (PDF/JPG)</label>
                    <input type="file" name="certifications" accept=".pdf,.jpg,.jpeg,.png" multiple>

                    <div class="password-wrapper">
                        <input type="password" name="password" id="applyPassword" placeholder="Set Dashboard Password" required>
                        <i class="fas fa-eye toggle-password" onclick="togglePasswordVisibility('applyPassword', this)"></i>
                    </div>
                </div>
                
                <button type="submit">Submit Application</button>
            </form>
        </div>

        <!-- Sign In Form -->
        <div class="form-container sign-in" id="signInForm" <% if (typeof mode !== 'undefined' && mode === 'signup') { %>style="display:none;"<% } %>>
            <form action="/trainer/login" method="POST">
                <h1>Coach Sign In</h1>
                <div class="social-icons">
                    <a href="/auth/google?role=trainer" class="icon" title="Login with Google"><i class="fa-brands fa-google"></i></a>
                </div>
                <span>Access your trainer dashboard</span>
                <input type="email" name="email" placeholder="Email" required>
                <div class="password-wrapper">
                    <input type="password" name="password" id="loginPassword" placeholder="Password" required>
                    <i class="fas fa-eye toggle-password" onclick="togglePasswordVisibility('loginPassword', this)"></i>
                </div>
                <a href="/forgot-password?role=trainer">Forgot Your Password?</a>
                <button type="submit">Sign In</button>
            </form>
        </div>

        <div class="toggle-container">
            <div class="toggle">
                <div class="toggle-panel toggle-left">
                    <h1>Welcome Back!</h1>
                    <p>Enter your details securely to manage your clients and sessions.</p>
                    <button class="hidden" id="login">Sign In</button>
                </div>
                <div class="toggle-panel toggle-right">
                    <h1>Ready to Train?</h1>
                    <p>Apply to become a verified FitConnect trainer and reach more clients.</p>
                    <button class="hidden" id="register">Apply Now</button>
                </div>
            </div>
        </div>
    </div>

    <script>
        const container = document.getElementById('container');
        const registerBtn = document.getElementById('register');
        const loginBtn = document.getElementById('login');

        // Check hash to auto open Apply tab
        if(window.location.hash === '#apply') {
            container.classList.add("active");
        }

        registerBtn.addEventListener('click', () => {
            container.classList.add("active");
        });

        loginBtn.addEventListener('click', () => {
            const signInForm = document.getElementById('signInForm');
            if (signInForm) signInForm.style.display = '';
            container.classList.remove("active");
        });

        // Reveal container and re-enable transitions and visibility
        function revealPage() {
            const container = document.getElementById('container');
            const signInForm = document.getElementById('signInForm');
            const isSignupMode = <%= typeof mode !== 'undefined' && mode === 'signup' %>;
            
            if (container) container.style.visibility = 'visible';
            
            // Only reveal sign-in form layout if we aren't in signup mode landing
            if (signInForm && !isSignupMode) {
                signInForm.style.display = '';
            }
            
            // Reveal the body and then enable animations in the next frame
            document.body.classList.add('revealed');
            
            setTimeout(() => {
                document.body.classList.add('ready');
            }, 100);
        }

        // Run as soon as possible
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', revealPage);
        } else {
            revealPage();
        }
        
        // Fallback for safety
        window.addEventListener('load', revealPage);

        // Removed floating animations for professional theme
        // Password Toggle Function
        function togglePasswordVisibility(inputId, icon) {
            const input = document.getElementById(inputId);
            if (input.type === 'password') {
                input.type = 'text';
                icon.classList.remove('fa-eye');
                icon.classList.add('fa-eye-slash');
            } else {
                input.type = 'password';
                icon.classList.remove('fa-eye-slash');
                icon.classList.add('fa-eye');
            }
        }
    </script>
</body>
</html>
